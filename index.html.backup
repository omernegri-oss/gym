const MEAL_TAG_KEYS = { breakfast: 'mealTagBreakfast', lunch: 'mealTagLunch', dinner: 'mealTagDinner', snack: 'mealTagSnack' };
const GOAL_KEY_MAP = { 'weight-loss': 'goalWeightLoss', 'maintenance': 'goalMaintenance', 'muscle-gain': 'goalMuscleGain' };

let currentLang = 'he';
function t(key){ return translations[currentLang][key]; }
function goalLabel(goal){ return t(GOAL_KEY_MAP[goal]); }
function displayMealName(m){ return m.nameKey ? t(m.nameKey) : m.name; }
function displayMealTag(m){ return MEAL_TAG_KEYS[m.tag] ? t(MEAL_TAG_KEYS[m.tag]) : m.tag; }
function displayExerciseName(ex){ return ex.nameKey ? t(ex.nameKey) : ex.name; }
function displayExerciseTag(ex){ return ex.tagKey ? t(ex.tagKey) : ex.tag; }

function applyLanguage(lang){
  currentLang = lang;
  document.documentElement.lang = lang;
  document.documentElement.dir = lang === 'he' ? 'rtl' : 'ltr';

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const val = t(el.getAttribute('data-i18n'));
    if(val !== undefined) el.textContent = val;
  });
  document.querySelectorAll('[data-i18n-html]').forEach(el => {
    const val = t(el.getAttribute('data-i18n-html'));
    if(val !== undefined) el.innerHTML = val;
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
    const val = t(el.getAttribute('data-i18n-placeholder'));
    if(val !== undefined) el.placeholder = val;
  });

  saveKey('lang', lang);

  // Re-render everything whose text depends on the current language
  calcMacros();
  if(metrics){
    renderDashboardGoal();
    renderNutritionSummary();
  }
  renderMeals();
  renderExercises();
  renderTrainingLog();
  renderWeeklyChart();
  updateWorkoutButtons();
  renderDayPicker();
  renderHero();
  updateFormLabels();
  if(document.getElementById('workoutLogForm').classList.contains('show')){
    // preserve whatever the user already ticked across the language switch
    const stillChecked = Array.from(document.querySelectorAll('.log-ex-check:checked'))
      .map(function(cb){ return exercises[Number(cb.value)]; })
      .filter(Boolean)
      .map(displayExerciseName);
    renderExerciseChecklist(stillChecked);
  }
  document.getElementById('greetingText').textContent = user ? translations[currentLang].greeting(user.name) : t('greetingDefault');
}

function toggleLanguage(){
  applyLanguage(currentLang === 'he' ? 'en' : 'he');
}

/* ================================================================
   MOBILE SIDEBAR (hamburger menu open/close)
   ================================================================ */
function openSidebar(){
  document.getElementById('sidebar').classList.add('open');
  document.getElementById('sidebarBackdrop').classList.add('show');
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebarBackdrop').classList.remove('show');
}
document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeSidebar(); });

/* ================================================================
   PLACEHOLDER TOPBAR ICON ACTIONS (so nothing is a dead click)
   ================================================================ */
function showNotificationsToast(){ flashToast(t('notificationsToast')); }
function showSearchToast(){ flashToast(t('searchComingSoon')); }
function showInfoToast(){ flashToast(t('liveInfoToast')); }
function showProfileToast(){ if(user) flashToast(user.name + ' · ' + goalLabel(user.goal)); }

/* ================================================================
   MACRO CALCULATIONS (Harris-Benedict + goal-based)
   ================================================================ */
function calculateTDEE(age, gender, weight, height) {
  let bmr;
  if (gender === 'male') {
    bmr = 88.362 + (13.397 * weight) + (4.799 * height) - (5.677 * age);
  } else {
    bmr = 447.593 + (9.247 * weight) + (3.098 * height) - (4.330 * age);
  }
  const activityFactor = 1.55;
  return Math.round(bmr * activityFactor);
}

function calculateMacros(tdee, goal, weight) {
  let targetCals, proteinMultiplier, fatMultiplier;

  if (goal === 'weight-loss') {
    targetCals = Math.round(tdee - 400);
    proteinMultiplier = 2.0;
    fatMultiplier = 1.0;
  } else if (goal === 'maintenance') {
    targetCals = tdee;
    proteinMultiplier = 1.8;
    fatMultiplier = 1.0;
  } else {
    targetCals = Math.round(tdee + 400);
    proteinMultiplier = 2.2;
    fatMultiplier = 1.1;
  }

  const proteinGrams = Math.round(weight * proteinMultiplier);
  const proteinCals = proteinGrams * 4;
  const fatGrams = Math.round(weight * fatMultiplier);
  const fatCals = fatGrams * 9;
  const carbGrams = Math.round((targetCals - proteinCals - fatCals) / 4);

  return { calories: targetCals, protein: proteinGrams, carbs: carbGrams, fats: fatGrams };
}

/* ================================================================
   ONBOARDING FORM — live macro preview
   ================================================================ */
function calcMacros() {
  const age = Number(document.getElementById('age').value) || 0;
  const gender = document.querySelector('input[name="gender"]:checked')?.value;
  const weight = Number(document.getElementById('weight').value) || 0;
  const height = Number(document.getElementById('height').value) || 0;
  const goal = document.getElementById('goal').value;

  if (age > 0 && gender && weight > 0 && height > 0 && goal) {
    const tdee = calculateTDEE(age, gender, weight, height);
    const macros = calculateMacros(tdee, goal, weight);

    document.getElementById('cals').textContent = macros.calories.toLocaleString();
    document.getElementById('protein').textContent = macros.protein;
    document.getElementById('carbs').textContent = macros.carbs;
    document.getElementById('fats').textContent = macros.fats;

    document.getElementById('goalLabel').textContent = goalLabel(goal);
    document.getElementById('macroDisplay').classList.add('show');
  } else {
    document.getElementById('macroDisplay').classList.remove('show');
  }
}

/* ================================================================
   ONBOARDING SUBMIT → connects to the app
   ================================================================ */
function setFieldError(id, show){
  const el = document.getElementById(id);
  if(el) el.style.display = show ? 'block' : 'none';
}

async function handleSubmit(e) {
  e.preventDefault();

  const nameEl = document.getElementById('name');
  const ageEl = document.getElementById('age');
  const weightEl = document.getElementById('weight');
  const heightEl = document.getElementById('height');
  const goalEl = document.getElementById('goal');

  const name = nameEl.value.trim();
  const age = Number(ageEl.value);
  const gender = document.querySelector('input[name="gender"]:checked')?.value;
  const weight = Number(weightEl.value);
  const height = Number(heightEl.value);
  const goal = goalEl.value;

  // Validate every field ourselves (no native `required`) so a missing
  // field always shows a visible, on-page message — never a silent no-op.
  const nameValid = !!name;
  const ageValid = ageEl.value !== '' && age >= 13 && age <= 120;
  const weightValid = weightEl.value !== '' && weight >= 20 && weight <= 300;
  const heightValid = heightEl.value !== '' && height >= 100 && height <= 250;
  const goalValid = !!goal;

  setFieldError('nameError', !nameValid);
  setFieldError('ageError', !ageValid);
  setFieldError('weightError', !weightValid);
  setFieldError('heightError', !heightValid);
  setFieldError('goalError', !goalValid);

  if(!nameValid || !ageValid || !weightValid || !heightValid || !goalValid){
    const firstInvalid = document.getElementById(
      !nameValid ? 'name' : !ageValid ? 'age' : !weightValid ? 'weight' : !heightValid ? 'height' : 'goal'
    );
    firstInvalid.focus();
    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  const tdee = calculateTDEE(age, gender, weight, height);
  const macroTarget = calculateMacros(tdee, goal, weight);

  user = { name, age, gender, weight, height, goal, createdAt: new Date().toISOString() };
  metrics = { age, height, weight, tdee, macroTarget };

  await saveKey('user', user);
  await saveKey('metrics', metrics);
  await saveKey('meals', meals);
  await saveKey('exercises', exercises);
  await saveKey('trainingLog', trainingLog);
  await saveKey('dailyStats', dailyStats);
  await saveKey('trainingDays', trainingDays);

  enterApp();
}

/* ================================================================
   TRANSITION: Onboarding → App
   ================================================================ */
function enterApp(){
  document.getElementById('onboardingContainer').classList.add('hidden');
  document.getElementById('mainApp').classList.add('active');

  // Greeting
  document.getElementById('greetingText').textContent = translations[currentLang].greeting(user.name);

  renderHero();
  renderDashboardGoal();
  renderMeals();
  renderExercises();
  renderMetricsForm();
  renderTrainingLog();
  renderWeeklyChart();
  document.getElementById('liveTimer').textContent = formatTimer(workoutSeconds);
  updateWorkoutButtons();
  renderDailyStats();
  renderDayPicker();
  updateFormLabels();

  switchScreen('dashboard');
  flashToast(translations[currentLang].welcomeToast(user.name));
}

/* ================================================================
   NAVIGATION
   ================================================================ */
function switchScreen(name, btn) {
  closeSidebar();
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(name).classList.add('active');

  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  if(btn){
    btn.classList.add('active');
  } else {
    const match = document.querySelector('.nav-btn[data-screen="'+name+'"]');
    if(match) match.classList.add('active');
  }
}

/* ================================================================
   DASHBOARD — nutrition goal card
   ================================================================ */
function renderDashboardGoal(){
  if(!metrics) return;
  const g = metrics.macroTarget;
  document.getElementById('dashGoalLabel').textContent = goalLabel(user.goal);
  document.getElementById('dashCalGoal').textContent = g.calories.toLocaleString() + ' ' + t('calUnitShort');
  document.getElementById('dashProtGoal').textContent = g.protein + t('gramUnit');
  document.getElementById('dashCarbGoal').textContent = g.carbs + t('gramUnit');
  document.getElementById('dashFatGoal').textContent = g.fats + t('gramUnit');

  const eaten = meals.reduce((s,m)=>s+Number(m.cal||0),0);
  document.getElementById('dashCalBar').style.width = Math.min(100, (eaten/g.calories)*100) + '%';
}

/* ================================================================
   DASHBOARD - hero card. Every figure here is derived from the
   user's own program and training log; nothing is placeholder copy.
   ================================================================ */
function renderHero(){
  const badgeEl = document.getElementById('heroBadge');
  if(!badgeEl) return;

  const today = new Date();
  document.getElementById('heroDay').textContent = String(today.getDate()).padStart(2,'0');
  document.getElementById('heroMonth').textContent = t('monthNames')[today.getMonth()];
  badgeEl.textContent = trainingDays[today.getDay()] ? t('heroTrainingDay') : t('heroRestDay');

  const todayLogs = trainingLog.filter(function(e){
    return new Date(e.dateISO).toDateString() === today.toDateString();
  });
  const minutes = todayLogs.reduce(function(sum,e){ return sum + Number(e.durationMin || 0); }, 0);
  const calories = todayLogs.reduce(function(sum,e){ return sum + Number(e.calories || 0); }, 0);

  document.getElementById('heroExCount').textContent = exercises.length;
  document.getElementById('heroMinutes').textContent = minutes;
  document.getElementById('heroCalories').textContent = calories.toLocaleString();

  if(exercises.length === 0){
    document.getElementById('heroTitle').textContent = t('heroNoProgram');
    document.getElementById('heroMeta').textContent = t('heroMetaNoProgram');
  } else {
    document.getElementById('heroTitle').textContent = t('heroProgramReady');
    document.getElementById('heroMeta').textContent =
      exercises.length + ' ' + t('heroExercisesLabel') + ' \u00b7 ' + todayLogs.length + ' ' + t('heroTodayLogged');
  }
}

/* ================================================================
   DASHBOARD — sleep hours & steps (user-entered, no device data)
   ================================================================ */
const SLEEP_GOAL_HOURS = 8;
const STEPS_GOAL = 10000;

function renderDailyStats(){
  const sleepInput = document.getElementById('sleepInput');
  const stepsInput = document.getElementById('stepsInput');
  if(!sleepInput) return;
  sleepInput.value = dailyStats.sleep || '';
  stepsInput.value = dailyStats.steps || '';
  document.getElementById('sleepBar').style.width = Math.min(100, (dailyStats.sleep / SLEEP_GOAL_HOURS) * 100) + '%';
  document.getElementById('stepsBar').style.width = Math.min(100, (dailyStats.steps / STEPS_GOAL) * 100) + '%';
}

async function updateSleepHours(){
  dailyStats.sleep = Math.max(0, Number(document.getElementById('sleepInput').value) || 0);
  await saveKey('dailyStats', dailyStats);
  renderDailyStats();
}

async function updateSteps(){
  dailyStats.steps = Math.max(0, Number(document.getElementById('stepsInput').value) || 0);
  await saveKey('dailyStats', dailyStats);
  renderDailyStats();
}

/* ================================================================
   PROGRAM — which days of the week the user trains (user-defined)
   ================================================================ */
function renderDayPicker(){
  const c = document.getElementById('dayPicker');
  if(!c) return;
  const today = new Date().getDay();
  const names = t('dayNamesShort');
  c.innerHTML = names.map((n, i) => `
    <button class="day-btn ${trainingDays[i] ? 'selected' : ''} ${i === today ? 'today' : ''}" onclick="toggleTrainingDay(${i})">${n}</button>
  `).join('');
}

async function toggleTrainingDay(i){
  trainingDays[i] = !trainingDays[i];
  await saveKey('trainingDays', trainingDays);
  renderDayPicker();
}

/* ================================================================
   LIVE WORKOUT — timer + training log
   ================================================================ */
let workoutState = 'idle'; // idle | running | paused
let workoutSeconds = 0;
let workoutTimerHandle = null;

function formatTimer(sec){
  const h = String(Math.floor(sec/3600)).padStart(2,'0');
  const m = String(Math.floor((sec%3600)/60)).padStart(2,'0');
  const s = String(sec%60).padStart(2,'0');
  return `${h}:${m}:${s}`;
}

/* An in-progress workout used to be lost entirely on reload. */
function persistWorkout(){
  saveKey('workout', { state: workoutState, seconds: workoutSeconds });
}

function tickWorkout(){
  workoutSeconds++;
  const el = document.getElementById('liveTimer');
  if(el) el.textContent = formatTimer(workoutSeconds);
  if(workoutSeconds % 5 === 0) persistWorkout();
}

function startWorkout(){
  workoutState = 'running';
  clearInterval(workoutTimerHandle);
  workoutTimerHandle = setInterval(tickWorkout, 1000);
  persistWorkout();
  updateWorkoutButtons();
}

function pauseWorkout(){
  workoutState = 'paused';
  clearInterval(workoutTimerHandle);
  persistWorkout();
  updateWorkoutButtons();
}

function updateWorkoutButtons(){
  const startBtn = document.getElementById('startWorkoutBtn');
  const pauseBtn = document.getElementById('pauseWorkoutBtn');
  const finishBtn = document.getElementById('finishWorkoutBtn');
  const statusEl = document.getElementById('liveWorkoutStatus');
  if(!startBtn) return;
  if(workoutState === 'idle'){
    startBtn.style.display = '';
    startBtn.textContent = t('startWorkoutCta');
    pauseBtn.style.display = 'none';
    finishBtn.style.display = 'none';
    statusEl.textContent = t('notStartedLabel');
  } else if(workoutState === 'running'){
    startBtn.style.display = 'none';
    pauseBtn.style.display = '';
    pauseBtn.textContent = t('pauseBtn');
    finishBtn.style.display = '';
    finishBtn.textContent = t('finishWorkoutBtn');
    statusEl.textContent = t('inProgressLabel');
  } else if(workoutState === 'paused'){
    startBtn.style.display = '';
    startBtn.textContent = t('resumeBtn');
    pauseBtn.style.display = 'none';
    finishBtn.style.display = '';
    finishBtn.textContent = t('finishWorkoutBtn');
    statusEl.textContent = t('pausedLabel');
  }
}

function renderExerciseChecklist(preChecked){
  const c = document.getElementById('logExerciseChecklist');
  if(!c) return;
  const checked = preChecked || [];
  if(exercises.length === 0){
    c.innerHTML = `<div class="exercise-check-empty">${esc(t('noExercisesYet'))}</div>`;
    return;
  }
  c.innerHTML = exercises.map((ex, i) => {
    const nm = displayExerciseName(ex);
    return `
    <label><input type="checkbox" class="log-ex-check" value="${i}"${checked.indexOf(nm) !== -1 ? ' checked' : ''}> ${esc(nm)}</label>
  `;
  }).join('');
}

function finishWorkout(){
  clearInterval(workoutTimerHandle);
  // Also move the state to paused. Previously only the interval was cleared,
  // so the status still read "in progress" with a frozen clock - and
  // cancelling the form left the workout stuck in that state.
  workoutState = 'paused';
  persistWorkout();
  updateWorkoutButtons();

  editingLogId = null;
  document.getElementById('logName').value = '';
  document.getElementById('logDuration').value = Math.max(1, Math.round(workoutSeconds/60));
  document.getElementById('logCalories').value = '';
  document.getElementById('logNotes').value = '';
  renderExerciseChecklist();
  updateFormLabels();
  const form = document.getElementById('workoutLogForm');
  form.classList.add('show');
  form.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function cancelWorkoutLog(){
  editingLogId = null;
  updateFormLabels();
  document.getElementById('workoutLogForm').classList.remove('show');
}

async function saveTrainingLog(){
  const name = document.getElementById('logName').value.trim() || t('logNameDefault');
  const duration = Number(document.getElementById('logDuration').value) || Math.max(1, Math.round(workoutSeconds/60));
  const calories = Number(document.getElementById('logCalories').value) || 0;
  const notes = document.getElementById('logNotes').value.trim();
  const exerciseNames = Array.from(document.querySelectorAll('.log-ex-check:checked'))
    .map(cb => exercises[Number(cb.value)])
    .filter(Boolean)
    .map(ex => displayExerciseName(ex));

  const isEdit = editingLogId !== null;
  if(isEdit){
    const idx = trainingLog.findIndex(e => e.id === editingLogId);
    if(idx !== -1){
      trainingLog[idx] = Object.assign({}, trainingLog[idx],
        { name, durationMin: duration, calories, notes, exerciseNames });
    }
    editingLogId = null;
  } else {
    trainingLog.unshift({
      id: Date.now(),
      dateISO: new Date().toISOString(),
      name, durationMin: duration, calories, notes, exerciseNames
    });
    // only a freshly logged workout resets the timer; editing an old entry must not
    clearInterval(workoutTimerHandle);
    workoutState = 'idle';
    workoutSeconds = 0;
    document.getElementById('liveTimer').textContent = formatTimer(0);
    persistWorkout();
    updateWorkoutButtons();
  }
  await saveKey('trainingLog', trainingLog);

  document.getElementById('workoutLogForm').classList.remove('show');
  updateFormLabels();
  renderTrainingLog();
  renderWeeklyChart();
  renderHero();
  flashToast(isEdit ? t('logUpdatedToast') : t('logSavedToast'));
}

function editTrainingLog(id){
  const entry = trainingLog.find(e => e.id === id);
  if(!entry) return;
  editingLogId = id;
  document.getElementById('logName').value = entry.name || '';
  document.getElementById('logDuration').value = entry.durationMin || '';
  document.getElementById('logCalories').value = entry.calories || '';
  document.getElementById('logNotes').value = entry.notes || '';
  renderExerciseChecklist(entry.exerciseNames || []);
  updateFormLabels();
  const form = document.getElementById('workoutLogForm');
  form.classList.add('show');
  form.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

async function deleteTrainingLog(id){
  trainingLog = trainingLog.filter(e => e.id !== id);
  await saveKey('trainingLog', trainingLog);
  if(editingLogId === id){
    editingLogId = null;
    document.getElementById('workoutLogForm').classList.remove('show');
    updateFormLabels();
  }
  renderTrainingLog();
  renderWeeklyChart();
  renderHero();
  flashToast(t('logDeletedToast'));
}

function formatLogDate(iso){
  const d = new Date(iso);
  return d.toLocaleDateString(currentLang === 'he' ? 'he-IL' : 'en-US', { day: '2-digit', month: 'short' });
}

function renderTrainingLog(){
  const list = document.getElementById('trainingLogList');
  const countEl = document.getElementById('logCount');
  if(!list) return;
  countEl.textContent = trainingLog.length;
  if(trainingLog.length === 0){
    list.innerHTML = `<div class="log-empty">${esc(t('logEmptyState'))}</div>`;
    return;
  }
  list.innerHTML = trainingLog.map(entry => `
    <div class="log-entry">
      <div class="log-entry-info">
        <div class="log-entry-date">${esc(formatLogDate(entry.dateISO))}</div>
        <div class="log-entry-name">${esc(entry.name)}</div>
        <div class="log-entry-meta">⏱ ${Number(entry.durationMin) || 0} ${esc(t('minUnit'))}${entry.calories ? ' · 🔥 ' + (Number(entry.calories) || 0) + ' ' + esc(t('calUnitShort')) : ''}</div>
        ${entry.exerciseNames && entry.exerciseNames.length ? `<div class="log-entry-chips">${entry.exerciseNames.map(n => `<span class="tag">${esc(n)}</span>`).join('')}</div>` : ''}
        ${entry.notes ? `<div class="log-entry-meta" style="margin-top:4px;">${esc(entry.notes)}</div>` : ''}
      </div>
      <div class="card-actions">
        <button class="icon-action" onclick="editTrainingLog(${entry.id})" title="${esc(t('editAction'))}" aria-label="${esc(t('editAction'))}">✎</button>
        <button class="icon-action danger" onclick="deleteTrainingLog(${entry.id})" title="${esc(t('deleteAction'))}" aria-label="${esc(t('deleteAction'))}">🗑</button>
      </div>
    </div>
  `).join('');
}

function renderWeeklyChart(){
  const track = document.getElementById('weeklyChartTrack');
  if(!track) return;
  const today = new Date();
  const days = [];
  for(let i = 6; i >= 0; i--){
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    days.push(d);
  }
  const totals = days.map(d => trainingLog
    .filter(e => new Date(e.dateISO).toDateString() === d.toDateString())
    .reduce((s, e) => s + Number(e.durationMin || 0), 0));
  const max = Math.max(...totals, 30);
  track.innerHTML = totals.map((min, i) => {
    const pct = Math.max(6, Math.round((min / max) * 100));
    const isToday = i === totals.length - 1;
    const color = isToday && min > 0 ? '#d7ff2b' : '#2a2a2a';
    return `<div style="flex:1; background:${color}; border-radius:3px; height:${pct}%;" title="${min} ${t('minUnit')}"></div>`;
  }).join('');
}

/* ================================================================
   NUTRITION SCREEN
   ================================================================ */
function toggleMealForm(show){
  document.getElementById('mealForm').classList.toggle('show', show);
  if(!show){
    editingMealIndex = null;
    ['mealName','mealCal','mealProtein','mealCarbs'].forEach(id=>document.getElementById(id).value='');
  }
  updateFormLabels();
}

async function saveMeal(){
  const name = document.getElementById('mealName').value.trim();
  const tag = document.getElementById('mealTag').value;
  const cal = Number(document.getElementById('mealCal').value) || 0;
  const protein = Number(document.getElementById('mealProtein').value) || 0;
  const carbs = Number(document.getElementById('mealCarbs').value) || 0;

  if(!name){ alert(t('mealNameAlert')); return; }

  const isEdit = editingMealIndex !== null;
  if(isEdit){
    meals[editingMealIndex] = { name, tag, cal, protein, carbs };
  } else {
    meals.push({ name, tag, cal, protein, carbs });
  }
  await saveKey('meals', meals);

  editingMealIndex = null;
  renderMeals();
  renderDashboardGoal();
  toggleMealForm(false);
  flashToast(isEdit ? t('mealUpdatedToast') : t('mealSavedToast'));
}

function editMeal(i){
  const m = meals[i];
  if(!m) return;
  editingMealIndex = i;
  document.getElementById('mealName').value = m.name || '';
  document.getElementById('mealTag').value = m.tag || 'breakfast';
  document.getElementById('mealCal').value = m.cal || '';
  document.getElementById('mealProtein').value = m.protein || '';
  document.getElementById('mealCarbs').value = m.carbs || '';
  const f = document.getElementById('mealForm');
  f.classList.add('show');
  updateFormLabels();
  f.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

async function deleteMeal(i){
  if(!meals[i]) return;
  meals.splice(i, 1);
  await saveKey('meals', meals);
  // indices shifted, so never leave the form bound to a stale row
  if(editingMealIndex !== null) toggleMealForm(false);
  renderMeals();
  renderDashboardGoal();
  flashToast(t('mealDeletedToast'));
}

function renderMeals(){
  const c = document.getElementById('mealsList');
  if(meals.length === 0){
    c.innerHTML = `<div class="log-empty">${esc(t('mealsEmptyState'))}</div>`;
    renderNutritionSummary();
    return;
  }
  c.innerHTML = meals.map((m, i) => `
    <div class="meal-card">
      <div class="meal-cal">
        <div class="meal-cal-num">${Number(m.cal) || 0}</div>
        <div class="meal-cal-label">${esc(t('calUnitLabel'))}</div>
      </div>
      <div class="meal-info">
        <span class="meal-tag">${esc(displayMealTag(m))}</span>
        <div class="meal-name">${esc(displayMealName(m))}</div>
        <div class="meal-meta">🔥 ${Number(m.protein) || 0}${esc(t('gramUnit'))} | 🌾 ${Number(m.carbs) || 0}${esc(t('gramUnit'))}</div>
      </div>
      <div class="meal-thumb">${MEAL_TAG_EMOJI[m.tag] || '🍽️'}</div>
      <div class="card-actions">
        <button class="icon-action" onclick="editMeal(${i})" title="${esc(t('editAction'))}" aria-label="${esc(t('editAction'))}">✎</button>
        <button class="icon-action danger" onclick="deleteMeal(${i})" title="${esc(t('deleteAction'))}" aria-label="${esc(t('deleteAction'))}">🗑</button>
      </div>
    </div>
  `).join('');

  renderNutritionSummary();
}

function renderNutritionSummary(){
  if(!metrics) return;
  const g = metrics.macroTarget;
  const totalCal = meals.reduce((s,m)=>s+Number(m.cal||0),0);
  const totalProt = meals.reduce((s,m)=>s+Number(m.protein||0),0);
  const totalCarb = meals.reduce((s,m)=>s+Number(m.carbs||0),0);
  const totalFat = Math.max(0, Math.round((totalCal - totalProt*4 - totalCarb*4)/9));
  const g_ = t('gramUnit');

  document.getElementById('sumCal').textContent = totalCal.toLocaleString() + ' / ' + g.calories.toLocaleString();
  document.getElementById('sumProt').textContent = totalProt + g_ + " / " + g.protein + g_;
  document.getElementById('sumCarb').textContent = totalCarb + g_ + " / " + g.carbs + g_;
  document.getElementById('sumFat').textContent = totalFat + g_ + " / " + g.fats + g_;

  document.getElementById('sumCalBar').style.width = Math.min(100, totalCal/g.calories*100) + '%';
  document.getElementById('sumProtBar').style.width = Math.min(100, totalProt/g.protein*100) + '%';
  document.getElementById('sumCarbBar').style.width = Math.min(100, totalCarb/g.carbs*100) + '%';
  document.getElementById('sumFatBar').style.width = Math.min(100, totalFat/g.fats*100) + '%';
}

/* ================================================================
   PROGRAM SCREEN
   ================================================================ */
function toggleExerciseForm(show){
  document.getElementById('exerciseForm').classList.toggle('show', show);
  if(!show){
    editingExerciseIndex = null;
    ['exName','exTag','exSets','exReps'].forEach(id=>document.getElementById(id).value='');
  }
  updateFormLabels();
}

async function saveExercise(){
  const name = document.getElementById('exName').value.trim();
  const tag = document.getElementById('exTag').value.trim() || t('generalTag');
  const sets = document.getElementById('exSets').value || '3';
  const reps = document.getElementById('exReps').value || '10';

  if(!name){ alert(t('exerciseNameAlert')); return; }

  const isEdit = editingExerciseIndex !== null;
  if(isEdit){
    exercises[editingExerciseIndex] = { name, tag, sets, reps };
  } else {
    exercises.push({ name, tag, sets, reps });
  }
  await saveKey('exercises', exercises);

  editingExerciseIndex = null;
  renderExercises();
  renderHero();
  toggleExerciseForm(false);
  flashToast(isEdit ? t('exerciseUpdatedToast') : t('exerciseSavedToast'));
}

function editExercise(i){
  const ex = exercises[i];
  if(!ex) return;
  editingExerciseIndex = i;
  document.getElementById('exName').value = ex.name || '';
  document.getElementById('exTag').value = ex.tag || '';
  document.getElementById('exSets').value = ex.sets || '';
  document.getElementById('exReps').value = ex.reps || '';
  const f = document.getElementById('exerciseForm');
  f.classList.add('show');
  updateFormLabels();
  f.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

async function deleteExercise(i){
  if(!exercises[i]) return;
  exercises.splice(i, 1);
  await saveKey('exercises', exercises);
  if(editingExerciseIndex !== null) toggleExerciseForm(false);
  renderExercises();
  renderHero();
  flashToast(t('exerciseDeletedToast'));
}

function renderExercises(){
  const c = document.getElementById('exercisesGrid');
  if(exercises.length === 0){
    c.innerHTML = `<div class="log-empty" style="grid-column: 1 / -1;">${esc(t('exercisesEmptyState'))}</div>`;
    return;
  }
  c.innerHTML = exercises.map((ex, i) => `
    <div class="ex-card">
      <div class="ex-thumb">🏋️</div>
      <div class="ex-body">
        <div class="ex-name">${esc(displayExerciseName(ex))}</div>
        <div class="ex-meta">${esc(ex.sets)} ${esc(t('setsUnit'))} · ${esc(ex.reps)}</div>
        <div class="ex-tags"><span class="tag">${esc(displayExerciseTag(ex))}</span></div>
        <div class="card-actions" style="margin-top:6px;">
          <button class="icon-action" onclick="editExercise(${i})" title="${esc(t('editAction'))}" aria-label="${esc(t('editAction'))}">✎</button>
          <button class="icon-action danger" onclick="deleteExercise(${i})" title="${esc(t('deleteAction'))}" aria-label="${esc(t('deleteAction'))}">🗑</button>
        </div>
      </div>
    </div>
  `).join('');
}

function renderMetricsForm(){
  if(!metrics) return;
  document.getElementById('metricAge').value = metrics.age;
  document.getElementById('metricHeight').value = metrics.height;
  document.getElementById('metricWeight').value = metrics.weight;
}

async function updateMetrics(){
  const age = Number(document.getElementById('metricAge').value) || metrics.age;
  const height = Number(document.getElementById('metricHeight').value) || metrics.height;
  const weight = Number(document.getElementById('metricWeight').value) || metrics.weight;

  const tdee = calculateTDEE(age, user.gender, weight, height);
  const macroTarget = calculateMacros(tdee, user.goal, weight);

  metrics = { age, height, weight, tdee, macroTarget };
  user.age = age; user.height = height; user.weight = weight;

  await saveKey('metrics', metrics);
  await saveKey('user', user);

  renderDashboardGoal();
  renderNutritionSummary();
  flashToast(t('metricsUpdatedToast'));
}

/* ================================================================
   TOAST
   ================================================================ */
let toastTimer;
function flashToast(msg){
  const t = document.getElementById('saveToast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}

/* ================================================================
   STARTUP — skip onboarding on repeat visits
   ================================================================ */
async function init(){
  const savedLang = await loadKey('lang', 'he');
  applyLanguage(savedLang);

  const savedUser = await loadKey('user', null);
  if(savedUser){
    user = savedUser;
    metrics = await loadKey('metrics', null);
    meals = await loadKey('meals', meals);
    exercises = await loadKey('exercises', exercises);
    trainingLog = await loadKey('trainingLog', trainingLog);
    dailyStats = await loadKey('dailyStats', dailyStats);
    trainingDays = await loadKey('trainingDays', trainingDays);
    const savedWorkout = await loadKey('workout', null);
    let restored = false;
    if(savedWorkout && Number(savedWorkout.seconds) > 0){
      // Come back paused rather than silently counting time the user wasn't training.
      workoutSeconds = Number(savedWorkout.seconds) || 0;
      workoutState = 'paused';
      restored = true;
    }
    if(metrics){
      enterApp();
      if(restored) flashToast(t('workoutRestoredToast'));
      return;
    }
  }
  // No saved user — show onboarding, run initial macro preview
  calcMacros();
}
init();
</script>
</body>
</html>

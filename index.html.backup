<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FitPro</title>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Heebo, Arial, sans-serif; background: #161616; }

/* ============ ONBOARDING (from פתיחת_אתר.html) ============ */
.container { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
.container.hidden { display: none; }
.onboard-card { position: relative; background: #232323; border: 1px solid #333; border-radius: 20px; padding: 40px; max-width: 500px; width: 100%; }
.logo { text-align: center; margin-bottom: 32px; }
.logo svg { width: 60px; height: 60px; margin-bottom: 12px; color: #d7ff2b; }
.title { text-align: center; font-size: 24px; font-weight: 800; color: #f2f2f2; margin-bottom: 8px; }
.subtitle { text-align: center; font-size: 14px; color: #9c9c9c; margin-bottom: 32px; }
.form { display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.label { font-size: 13px; font-weight: 600; color: #f2f2f2; }
.input, .select { background: #2a2a2a; border: 1px solid #333; color: #f2f2f2; padding: 11px 14px; border-radius: 8px; font-family: inherit; font-size: 14px; }
.input:focus, .select:focus { outline: none; border-color: #3fd7e8; }
.input::placeholder { color: #6f6f6f; }
.radio-group { display: flex; gap: 20px; margin-top: 8px; }
.radio-group label { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #f2f2f2; cursor: pointer; }
.radio-group input { cursor: pointer; }
.macro-display { background: #2a2a2a; border: 1px solid #333; border-radius: 12px; padding: 20px; margin-top: 20px; display: none; }
.macro-display.show { display: block; animation: slideIn 0.3s ease; }
@keyframes slideIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
.macro-title { font-size: 14px; font-weight: 700; margin-bottom: 16px; }
.macro-badge { display: inline-block; background: rgba(215,255,43,0.15); color: #d7ff2b; font-size: 12px; padding: 6px 12px; border-radius: 20px; margin-bottom: 12px; font-weight: 700; }
.macro-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
.macro-card { background: #1a1a1a; border-radius: 8px; padding: 12px; text-align: center; }
.macro-card.cals { border: 2px solid #d7ff2b; }
.macro-card.protein { border: 2px solid #3fd7e8; }
.macro-card.carbs { border: 2px solid #e0c93f; }
.macro-card.fats { border: 2px solid #ff9500; }
.macro-label { font-size: 11px; color: #9c9c9c; margin-bottom: 6px; }
.macro-value { font-size: 24px; font-weight: 800; margin-bottom: 2px; }
.macro-value.cals { color: #d7ff2b; }
.macro-value.protein { color: #3fd7e8; }
.macro-value.carbs { color: #e0c93f; }
.macro-value.fats { color: #ff9500; }
.macro-unit { font-size: 10px; color: #6f6f6f; }
.macro-info { background: rgba(215,255,43,0.06); border-inline-start: 3px solid #d7ff2b; padding: 12px; border-radius: 8px; margin-top: 12px; }
.macro-info-text { font-size: 12px; color: #9c9c9c; line-height: 1.5; }
.macro-info-text strong { color: #d7ff2b; }
.submit-btn { background: #d7ff2b; color: #141400; border: none; padding: 12px; border-radius: 10px; font-family: inherit; font-weight: 700; font-size: 14px; cursor: pointer; margin-top: 8px; }
.submit-btn:hover { filter: brightness(1.08); }
.field-error { color: #ff6b6b; font-size: 12px; display: none; }
.lang-toggle { background: #2a2a2a; color: #d7ff2b; border: 1px solid #333; padding: 8px; border-radius: 8px; font-family: inherit; font-weight: 700; cursor: pointer; font-size: 11px; width: 100%; transition: background 0.2s; }
.lang-toggle:hover { background: #333; }
.lang-toggle.corner { position: absolute; top: 20px; inset-inline-end: 20px; width: auto; padding: 6px 14px; border-radius: 20px; background: rgba(215,255,43,0.15); border: none; }
.lang-toggle.corner:hover { background: rgba(215,255,43,0.25); }

/* ============ APP (from פתיחת_אתר_2.html) ============ */
.app { display: none; height: 100vh; height: 100dvh; background: #161616; color: #f2f2f2; }
.app.active { display: flex; }
.sidebar { width: 180px; background: #1e1e1e; border-inline-start: 1px solid #333; padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; }
.brand { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; padding: 8px; }
.brand-icon { width: 32px; height: 32px; background: #d7ff2b; border-radius: 6px; flex-shrink: 0; display:flex; align-items:center; justify-content:center; }
.brand-text { font-size: 12px; }
.brand-name { font-weight: 700; color: #d7ff2b; }
.nav { display: flex; flex-direction: column; gap: 2px; margin-bottom: auto; }
.nav-btn { background: none; border: none; color: #9c9c9c; padding: 10px; border-radius: 8px; font-family: inherit; cursor: pointer; text-align: start; font-size: 12px; font-weight: 500; transition: all 0.2s; }
.nav-btn:hover { background: #232323; color: #f2f2f2; }
.nav-btn.active { background: #2a2a2a; color: #d7ff2b; }
.sidebar-footer { display: flex; flex-direction: column; gap: 8px; }
.btn-start { background: #d7ff2b; color: #141400; border: none; padding: 10px; border-radius: 8px; font-family: inherit; font-weight: 700; cursor: pointer; font-size: 12px; }
.main { flex: 1; padding: 24px 32px; overflow-y: auto; }
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; position: sticky; top: 0; background: #161616; z-index: 10; padding-top: 4px; margin-top: -4px; }
.topbar h1 { font-size: 18px; }
.topbar-icons { display: flex; gap: 12px; }
.icon-btn { width: 32px; height: 32px; border-radius: 50%; background: #232323; border: none; color: #9c9c9c; cursor: pointer; }
.screen { display: none; }
.screen.active { display: block; }
.card { background: #232323; border: 1px solid #333; border-radius: 12px; padding: 18px; margin-bottom: 16px; }
.card-title { font-size: 11px; color: #9c9c9c; margin-bottom: 8px; text-transform: uppercase; }
.stat-unit { font-size: 12px; color: #6f6f6f; margin-inline-start: 4px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
.hero-card { background: linear-gradient(135deg, #232323, #2a2a2a); border: 1px solid #333; border-radius: 12px; padding: 20px; }
.hero-stat { background: rgba(0,0,0,0.3); border-radius: 8px; padding: 8px; text-align: center; font-size: 11px; }
.hero-stat svg { width: 14px; height: 14px; color: #d7ff2b; margin-bottom: 4px; }
.badge { background: rgba(215,255,43,0.15); color: #d7ff2b; font-size: 10px; padding: 4px 8px; border-radius: 12px; display: inline-block; }
.btn-group { display: flex; gap: 8px; margin-top: 12px; }
.btn { flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #333; color: #9c9c9c; background: transparent; font-family: inherit; cursor: pointer; font-weight: 600; font-size: 12px; transition: all 0.2s; }
.btn:hover { background: #2a2a2a; color: #f2f2f2; }
.btn-accent { background: #d7ff2b; color: #141400; border: none; }
.btn-accent:hover { filter: brightness(1.08); }
.meal-card { background: #232323; border: 1px solid #333; border-radius: 12px; padding: 12px; display: flex; gap: 12px; margin-bottom: 12px; }
.meal-cal { text-align: center; min-width: 50px; }
.meal-cal-num { font-size: 18px; font-weight: 800; color: #d7ff2b; }
.meal-cal-label { font-size: 10px; color: #6f6f6f; }
.meal-info { flex: 1; min-width: 0; }
.meal-tag { display: inline-block; font-size: 10px; padding: 3px 8px; border-radius: 12px; margin-bottom: 6px; background: rgba(215,255,43,0.15); color: #d7ff2b; font-weight: 700; }
.meal-name { font-size: 12px; font-weight: 700; margin-bottom: 4px; }
.meal-meta { font-size: 10px; color: #9c9c9c; }
.meal-thumb { width: 50px; height: 50px; border-radius: 8px; background: #1a1a1a; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 22px; }
.add-form { background: #2a2a2a; border-radius: 8px; padding: 12px; margin-bottom: 12px; display: none; }
.add-form.show { display: block; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.form-input { background: #1a1a1a; border: 1px solid #333; color: #f2f2f2; padding: 8px; border-radius: 6px; font-family: inherit; font-size: 12px; width: 100%; }
.form-input::placeholder { color: #6f6f6f; }
.form-actions { display: flex; gap: 8px; margin-top: 8px; }
.form-actions button { flex: 1; padding: 8px; border-radius: 6px; border: none; font-family: inherit; cursor: pointer; font-size: 12px; font-weight: 700; }
.form-save { background: #d7ff2b; color: #141400; }
.form-cancel { background: #333; color: #9c9c9c; }
.bar-track { height: 6px; background: #2a2a2a; border-radius: 4px; margin-top: 8px; overflow: hidden; }
.bar-fill { height: 100%; background: #d7ff2b; border-radius: 4px; transition: width 0.4s ease; }
.ex-card { background: #232323; border-radius: 8px; overflow: hidden; }
.ex-thumb { height: 50px; background: #1a1a1a; display: flex; align-items: center; justify-content: center; font-size: 22px; }
.ex-body { padding: 8px; }
.ex-name { font-size: 11px; font-weight: 700; }
.ex-meta { font-size: 10px; color: #9c9c9c; margin: 2px 0 4px; }
.ex-tags { display: flex; gap: 4px; }
.tag { font-size: 9px; padding: 2px 6px; border-radius: 10px; background: rgba(215,255,43,0.15); color: #d7ff2b; font-weight: 600; }
.metric-row { padding: 12px 0; border-top: 1px solid #333; }
.metric-row:first-of-type { border: none; padding-top: 0; }
.metric-label { font-size: 11px; color: #9c9c9c; }
.metric-input { background: #2a2a2a; border: 1px solid #333; color: #f2f2f2; padding: 8px; border-radius: 6px; font-family: inherit; font-size: 12px; width: 100%; }
.save-toast { position: fixed; bottom: calc(24px + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%) translateY(100px); background: #d7ff2b; color: #141400; padding: 12px 24px; border-radius: 20px; font-weight: 700; font-size: 13px; transition: transform 0.3s ease; z-index: 140; max-width: calc(100vw - 32px); text-align: center; }
.save-toast.show { transform: translateX(-50%) translateY(0); }

/* ============ WORKOUT TIMER / TRAINING LOG ============ */
.timer-display { font-size: 40px; font-weight: 800; letter-spacing: 1px; text-align: center; margin: 12px 0; font-variant-numeric: tabular-nums; }
.log-entry { background: #1a1a1a; border: 1px solid #333; border-radius: 10px; padding: 12px; margin-bottom: 10px; display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
.log-entry-info { flex: 1; min-width: 0; }
.log-entry-date { font-size: 10px; color: #6f6f6f; margin-bottom: 4px; }
.log-entry-name { font-size: 13px; font-weight: 700; margin-bottom: 4px; }
.log-entry-meta { font-size: 11px; color: #9c9c9c; }
.log-entry-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
.card-actions { display: flex; gap: 2px; flex-shrink: 0; align-items: flex-start; }
.icon-action { background: none; border: none; color: #6f6f6f; cursor: pointer; font-size: 14px; padding: 4px; line-height: 1; border-radius: 6px; }
.icon-action:hover { color: #d7ff2b; background: #2a2a2a; }
.icon-action.danger:hover { color: #ff6b6b; background: #2a2a2a; }
.log-empty { text-align: center; padding: 20px; color: #6f6f6f; font-size: 12px; }
.exercise-check-list { display: flex; flex-direction: column; gap: 6px; max-height: 160px; overflow-y: auto; background: #1a1a1a; border-radius: 8px; padding: 8px; margin-top: 6px; }
.exercise-check-list label { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #f2f2f2; cursor: pointer; }
.exercise-check-empty { font-size: 11px; color: #6f6f6f; padding: 4px; }
.ex-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

/* ============ EDITABLE STATS + DAY PICKER ============ */
.stat-input { background: transparent; border: none; border-bottom: 1px dashed #333; color: #f2f2f2; font-family: inherit; font-size: 28px; font-weight: 700; width: 100%; padding: 0 0 2px; }
.stat-input:focus { outline: none; border-bottom-color: #3fd7e8; }
.stat-input::placeholder { color: #6f6f6f; }
.day-picker { display: flex; gap: 4px; margin-top: 12px; }
.day-btn { flex: 1; height: 40px; background: #2a2a2a; border: none; border-radius: 6px; color: #9c9c9c; font-family: inherit; font-weight: 700; font-size: 11px; cursor: pointer; transition: background 0.15s, color 0.15s; }
.day-btn:hover { background: #333; }
.day-btn.selected { background: #3fd7e8; color: #141400; }
.day-btn.today { box-shadow: inset 0 0 0 2px #d7ff2b; }

/* ============ MOBILE MENU (hamburger + off-canvas sidebar) ============ */
.menu-toggle { display: none; background: #232323; border: 1px solid #333; color: #f2f2f2; width: 36px; height: 36px; min-width: 36px; border-radius: 8px; cursor: pointer; font-size: 16px; align-items: center; justify-content: center; flex-shrink: 0; }
.menu-toggle:hover { background: #2a2a2a; }
.topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
.sidebar-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 150; opacity: 0; pointer-events: none; transition: opacity 0.25s ease; }
.sidebar-backdrop.show { opacity: 1; pointer-events: auto; }

@media (max-width: 860px) {
  .menu-toggle { display: flex; }
  .sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-start: -100%;
    width: 260px;
    max-width: 82vw;
    height: 100dvh;
    z-index: 200;
    transition: inset-inline-start 0.28s ease;
  }
  .sidebar.open { inset-inline-start: 0; box-shadow: 0 0 32px rgba(0,0,0,0.55); }
  .sidebar-backdrop { display: block; }
  .main { padding: 16px; }
  .grid-2, .grid-3 { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .meal-card { flex-wrap: wrap; }
  .topbar h1 { font-size: 16px; }
  .onboard-card { padding: 24px 20px; }
}

@media (max-width: 420px) {
  .ex-grid { grid-template-columns: 1fr; }
  .macro-cards { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<!-- ============================================================ -->
<!-- SCREEN 1: ONBOARDING (from פתיחת_אתר.html)                   -->
<!-- ============================================================ -->
<div class="container" id="onboardingContainer">
  <div class="onboard-card">
    <button type="button" class="lang-toggle corner" onclick="toggleLanguage()" data-i18n="langToggle">EN</button>
    <div class="logo">
      <svg viewBox="0 0 24 24" fill="none"><path d="M3 12L11 12M11 12L8 8M11 12L8 16M13 6H21M13 18H21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="title">FitPro</div>
      <div class="subtitle" data-i18n="onboardSubtitle">בואו נתחיל את הטיול שלך לכושר</div>
    </div>

    <form class="form" id="onboardForm" onsubmit="handleSubmit(event)">
      <div class="field">
        <label class="label" data-i18n="fieldName">שם פרטי</label>
        <input class="input" type="text" id="name" placeholder="לדוגמה: דניאל" data-i18n-placeholder="placeholderName">
        <div class="field-error" id="nameError" data-i18n="errorName">נא להזין שם</div>
      </div>

      <div class="field">
        <label class="label" data-i18n="fieldAge">גיל</label>
        <input class="input" type="number" id="age" placeholder="28" min="13" max="120" value="28" onchange="calcMacros()" oninput="calcMacros()">
        <div class="field-error" id="ageError" data-i18n="errorAge">נא להזין גיל בין 13 ל-120</div>
      </div>

      <div class="field">
        <label class="label" data-i18n="fieldGender">מין</label>
        <div class="radio-group">
          <label><input type="radio" name="gender" value="male" checked onchange="calcMacros()"> <span data-i18n="genderMale">זכר</span></label>
          <label><input type="radio" name="gender" value="female" onchange="calcMacros()"> <span data-i18n="genderFemale">נקבה</span></label>
        </div>
      </div>

      <div class="field">
        <label class="label" data-i18n="fieldWeight">משקל (ק״ג)</label>
        <input class="input" type="number" id="weight" placeholder="84.5" step="0.1" min="20" max="300" value="84" onchange="calcMacros()" oninput="calcMacros()">
        <div class="field-error" id="weightError" data-i18n="errorWeight">נא להזין משקל בין 20 ל-300 ק״ג</div>
      </div>

      <div class="field">
        <label class="label" data-i18n="fieldHeight">גובה (ס״מ)</label>
        <input class="input" type="number" id="height" placeholder="182" min="100" max="250" value="182" onchange="calcMacros()" oninput="calcMacros()">
        <div class="field-error" id="heightError" data-i18n="errorHeight">נא להזין גובה בין 100 ל-250 ס״מ</div>
      </div>

      <div class="field">
        <label class="label" data-i18n="fieldGoal">מה היעד שלך?</label>
        <select class="select" id="goal" onchange="calcMacros()">
          <option value="" data-i18n="goalPlaceholder">בחר יעד...</option>
          <option value="weight-loss" data-i18n="goalWeightLoss">🔥 חיטוב (הפחתת משקל)</option>
          <option value="maintenance" data-i18n="goalMaintenance">⚖️ שמירה על משקל</option>
          <option value="muscle-gain" data-i18n="goalMuscleGain">💪 בנייה שרירית</option>
        </select>
        <div class="field-error" id="goalError" data-i18n="errorGoal">נא לבחור יעד</div>
      </div>

      <!-- Macro recommendations -->
      <div class="macro-display" id="macroDisplay">
        <div class="macro-title" data-i18n="macroTitle">🎯 התוכנית התזונתית שלך</div>
        <div class="macro-badge" id="goalLabel"></div>
        <div class="macro-cards">
          <div class="macro-card cals">
            <div class="macro-label" data-i18n="macroCals">קלוריות</div>
            <div class="macro-value cals" id="cals">0</div>
            <div class="macro-unit" data-i18n="unitKcalDay">kcal/יום</div>
          </div>
          <div class="macro-card protein">
            <div class="macro-label" data-i18n="macroProtein">חלבון</div>
            <div class="macro-value protein" id="protein">0</div>
            <div class="macro-unit" data-i18n="unitGramDay">גרם/יום</div>
          </div>
          <div class="macro-card carbs">
            <div class="macro-label" data-i18n="macroCarbs">פחמימות</div>
            <div class="macro-value carbs" id="carbs">0</div>
            <div class="macro-unit" data-i18n="unitGramDay">גרם/יום</div>
          </div>
          <div class="macro-card fats">
            <div class="macro-label" data-i18n="macroFats">שומן</div>
            <div class="macro-value fats" id="fats">0</div>
            <div class="macro-unit" data-i18n="unitGramDay">גרם/יום</div>
          </div>
        </div>
        <div class="macro-info">
          <div class="macro-info-text" data-i18n-html="macroTip">
            <strong>💡 טיפ:</strong> הנתונים האלו מחושבים בהתאם לפרופיל שלך. אתה יכול לשנות אותם בכל עת.
          </div>
        </div>
      </div>

      <button type="submit" class="submit-btn" data-i18n="submitBtn">התחל עכשיו</button>
    </form>
  </div>
</div>

<!-- ============================================================ -->
<!-- SCREEN 2: MAIN APP (from פתיחת_אתר_2.html)                   -->
<!-- ============================================================ -->
<div class="app" id="mainApp">
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M3 12L11 12M11 12L8 8M11 12L8 16M13 6H21M13 18H21" stroke="#141400" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="brand-text">
        <div class="brand-name">FitPro</div>
        <div style="font-size: 10px; color: #6f6f6f;" data-i18n="brandSubtitle">מאמן אישי</div>
      </div>
    </div>

    <nav class="nav">
      <button class="nav-btn active" data-screen="dashboard" onclick="switchScreen('dashboard', this)" data-i18n="navDashboard">לוח בקרה</button>
      <button class="nav-btn" data-screen="live" onclick="switchScreen('live', this)" data-i18n="navLive">אימון חי</button>
      <button class="nav-btn" data-screen="program" onclick="switchScreen('program', this)" data-i18n="navProgram">תוכנית אימונים</button>
      <button class="nav-btn" data-screen="nutrition" onclick="switchScreen('nutrition', this)" data-i18n="navNutrition">תזונה ומדדים</button>
    </nav>

    <div class="sidebar-footer">
      <button class="lang-toggle" onclick="toggleLanguage()" data-i18n="langToggle">EN</button>
      <button class="btn-start" onclick="switchScreen('live')" data-i18n="startWorkoutBtn">התחל אימון</button>
    </div>
  </aside>

  <main class="main">
    <!-- DASHBOARD SCREEN -->
    <div id="dashboard" class="screen active">
      <div class="topbar">
        <div class="topbar-left">
          <button class="menu-toggle" onclick="openSidebar()" aria-label="Menu">☰</button>
          <h1 id="greetingText">שלום 👋</h1>
        </div>
        <div class="topbar-icons">
          <button class="icon-btn" onclick="showNotificationsToast()">🔔</button>
          <button class="icon-btn" onclick="showProfileToast()">👤</button>
        </div>
      </div>

      <div class="hero-card">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
          <div>
            <div style="font-size: 24px; font-weight: 700; line-height: 1;" id="heroDay">05</div>
            <div style="font-size: 11px; color: #6f6f6f;" id="heroMonth">מרץ</div>
          </div>
          <span class="badge" id="heroBadge">—</span>
        </div>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 14px; font-weight: 700; margin-bottom: 4px;" id="heroTitle">—</div>
          <div style="font-size: 11px; color: #9c9c9c;" id="heroMeta">—</div>
        </div>
        <div class="grid-3" style="margin-bottom: 12px;">
          <div class="hero-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7v10M18 7v10M3 12h18M4 9v6M20 9v6"/></svg><div style="font-weight: 700;" id="heroExCount">0</div><div style="font-size: 10px;" data-i18n="heroExercisesLabel">תרגילים</div></div>
          <div class="hero-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg><div style="font-weight: 700;" id="heroMinutes">0</div><div style="font-size: 10px;" data-i18n="heroMinutesLabel">דקות</div></div>
          <div class="hero-stat"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 11-14h-8l1-6z"/></svg><div style="font-weight: 700;" id="heroCalories">0</div><div style="font-size: 10px;" data-i18n="heroCalLabel">קק״ל</div></div>
        </div>
        <div class="btn-group">
          <button class="btn" onclick="switchScreen('program')" data-i18n="editPlanBtn">ערוך תוכנית</button>
          <button class="btn btn-accent" onclick="switchScreen('live')" data-i18n="startNowBtn">התחל עכשיו ▶</button>
        </div>
      </div>

      <!-- 🎯 Nutrition goal card — connected to onboarding data -->
      <div class="card">
        <div class="card-title" data-i18n="nutritionGoalTitle">🎯 היעד התזונתי שלך היום</div>
        <div style="display: flex; justify-content: space-between; font-size: 12px; margin: 10px 0 6px;">
          <span id="dashGoalLabel" style="font-weight: 700; color: #d7ff2b;">—</span>
          <span id="dashCalGoal" style="font-weight: 700;">0 קק"ל</span>
        </div>
        <div class="bar-track"><div class="bar-fill" id="dashCalBar" style="width:0%;"></div></div>
        <div class="grid-3" style="margin-top: 12px;">
          <div class="hero-stat" style="background:#1a1a1a;"><div style="color:#3fd7e8; font-weight:700;" id="dashProtGoal">0ג'</div><div style="font-size:10px;" data-i18n="macroProtein">חלבון</div></div>
          <div class="hero-stat" style="background:#1a1a1a;"><div style="color:#e0c93f; font-weight:700;" id="dashCarbGoal">0ג'</div><div style="font-size:10px;" data-i18n="macroCarbs">פחמימות</div></div>
          <div class="hero-stat" style="background:#1a1a1a;"><div style="color:#ff9500; font-weight:700;" id="dashFatGoal">0ג'</div><div style="font-size:10px;" data-i18n="macroFats">שומן</div></div>
        </div>
      </div>

      <div class="grid-2" style="margin-bottom: 16px;">
        <div class="card">
          <div class="card-title" data-i18n="sleepTitle">שעות שינה</div>
          <div style="display:flex; align-items:baseline; gap:6px;">
            <input class="stat-input" type="number" step="0.5" min="0" max="24" id="sleepInput" onchange="updateSleepHours()" placeholder="0">
            <span class="stat-unit" data-i18n="sleepUnit">שעות</span>
          </div>
          <div class="bar-track"><div class="bar-fill" id="sleepBar" style="width: 0%;"></div></div>
        </div>
        <div class="card">
          <div class="card-title" data-i18n="stepsTitle">צעדים</div>
          <input class="stat-input" type="number" step="100" min="0" id="stepsInput" onchange="updateSteps()" placeholder="0">
          <div class="bar-track"><div class="bar-fill" id="stepsBar" style="width: 0%;"></div></div>
        </div>
      </div>

      <div class="card">
        <div class="card-title" data-i18n="weeklyProgressTitle">התקדמות שבועית</div>
        <div style="display: flex; align-items: flex-end; gap: 6px; height: 80px; margin-top: 12px;" id="weeklyChartTrack"></div>
      </div>
    </div>

    <!-- LIVE WORKOUT SCREEN -->
    <div id="live" class="screen">
      <div class="topbar">
        <div class="topbar-left">
          <button class="menu-toggle" onclick="openSidebar()" aria-label="Menu">☰</button>
          <h1 data-i18n="liveTitle">אימון פעיל</h1>
        </div>
        <div class="topbar-icons">
          <button class="icon-btn" onclick="showInfoToast()">ℹ️</button>
          <button class="icon-btn" onclick="showNotificationsToast()">🔔</button>
        </div>
      </div>

      <div class="grid-2">
        <div>
          <div class="card">
            <div class="card-title" data-i18n="workoutTimerTitle">טיימר אימון</div>
            <div class="timer-display" id="liveTimer">00:00:00</div>
            <div id="liveWorkoutStatus" style="text-align:center; font-size:12px; color:#9c9c9c; margin-bottom:8px;" data-i18n="notStartedLabel">האימון טרם התחיל</div>
            <div class="btn-group">
              <button class="btn btn-accent" id="startWorkoutBtn" onclick="startWorkout()" style="flex:1;" data-i18n="startWorkoutCta">התחל אימון ▶</button>
              <button class="btn" id="pauseWorkoutBtn" onclick="pauseWorkout()" style="display:none; flex:1;" data-i18n="pauseBtn">השהה ⏸</button>
              <button class="btn" id="finishWorkoutBtn" onclick="finishWorkout()" style="display:none; flex:1; border-color:#d7ff2b; color:#d7ff2b;" data-i18n="finishWorkoutBtn">סיים ותעד ✓</button>
            </div>
          </div>

          <div class="add-form" id="workoutLogForm">
            <div class="form-row">
              <input class="form-input" id="logName" placeholder="שם האימון" data-i18n-placeholder="logNamePlaceholder">
              <input class="form-input" id="logDuration" placeholder="משך (דקות)" type="number" min="1">
            </div>
            <div class="field" style="margin-bottom:8px;">
              <label class="label" style="font-size:11px;" data-i18n="logExercisesLabel">תרגילים שבוצעו</label>
              <div class="exercise-check-list" id="logExerciseChecklist"></div>
            </div>
            <div class="form-row">
              <input class="form-input" id="logCalories" placeholder="קלוריות (אופציונלי)" type="number" data-i18n-placeholder="logCaloriesPlaceholder">
              <input class="form-input" id="logNotes" placeholder="הערות (אופציונלי)" data-i18n-placeholder="logNotesPlaceholder">
            </div>
            <div class="form-actions">
              <button class="form-save" id="logSaveBtnEl" onclick="saveTrainingLog()">שמור אימון ביומן</button>
              <button class="form-cancel" onclick="cancelWorkoutLog()" data-i18n="cancelBtn">ביטול</button>
            </div>
          </div>

        </div>

        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <div class="card-title" style="margin: 0;" data-i18n="trainingLogTitle">יומן אימונים</div>
            <span style="font-size: 11px; background: #2a2a2a; padding: 3px 8px; border-radius: 12px;" id="logCount">0</span>
          </div>
          <div id="trainingLogList"></div>
        </div>
      </div>
    </div>

    <!-- PROGRAM SCREEN -->
    <div id="program" class="screen">
      <div class="topbar">
        <div class="topbar-left">
          <button class="menu-toggle" onclick="openSidebar()" aria-label="Menu">☰</button>
          <h1 data-i18n="programTitle">מעקב ביצועים שבועי</h1>
        </div>
        <div class="topbar-icons">
          <button class="icon-btn" onclick="showSearchToast()">🔍</button>
        </div>
      </div>

      <div class="grid-2">
        <div>
          <div class="card">
            <div class="card-title" data-i18n="weeklyPlanTitle">תוכנית שבועית</div>
            <div style="font-size: 11px; color: #6f6f6f; margin-top: -4px; margin-bottom: 8px;" data-i18n="weeklyPlanHint">לחצו על יום כדי לסמן אותו כיום אימון</div>
            <div class="day-picker" id="dayPicker"></div>
          </div>

          <div class="card">
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
              <div class="card-title" style="margin: 0;" data-i18n="exercisesTitle">תרגילים</div>
            </div>
            <div id="exercisesGrid" class="ex-grid"></div>

            <div class="add-form" id="exerciseForm">
              <div class="form-row">
                <input class="form-input" id="exName" placeholder="שם התרגיל" data-i18n-placeholder="exNamePlaceholder">
                <input class="form-input" id="exTag" placeholder="קבוצת שריר" data-i18n-placeholder="exTagPlaceholder">
              </div>
              <div class="form-row">
                <input class="form-input" id="exSets" placeholder="סטים" type="number" data-i18n-placeholder="exSetsPlaceholder">
                <input class="form-input" id="exReps" placeholder="חזרות" type="number" data-i18n-placeholder="exRepsPlaceholder">
              </div>
              <div class="form-actions">
                <button class="form-save" id="exSaveBtn" onclick="saveExercise()">שמור תרגיל</button>
                <button class="form-cancel" onclick="toggleExerciseForm(false)" data-i18n="cancelBtn">ביטול</button>
              </div>
            </div>

            <button class="btn" style="width: 100%; margin-top: 12px;" onclick="toggleExerciseForm(true)" data-i18n="addExerciseBtn">＋ הוסף תרגיל</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="metricsTitle">מדדים אישיים</div>
          <div class="metric-row">
            <div class="metric-label" data-i18n="metricAgeLabel">גיל</div>
            <input class="metric-input" type="number" id="metricAge" value="28" />
          </div>
          <div class="metric-row">
            <div class="metric-label" data-i18n="metricHeightLabel">גובה (ס״מ)</div>
            <input class="metric-input" type="number" id="metricHeight" value="182" />
          </div>
          <div class="metric-row">
            <div class="metric-label" data-i18n="metricWeightLabel">משקל (ק״ג)</div>
            <input class="metric-input" type="number" id="metricWeight" value="84.5" />
          </div>
          <button class="btn btn-accent" style="width: 100%; margin-top: 12px;" onclick="updateMetrics()" data-i18n="updateMetricsBtn">עדכן מדדים</button>
        </div>
      </div>
    </div>

    <!-- NUTRITION SCREEN -->
    <div id="nutrition" class="screen">
      <div class="topbar">
        <div class="topbar-left">
          <button class="menu-toggle" onclick="openSidebar()" aria-label="Menu">☰</button>
          <h1 data-i18n="navNutrition">תזונה ומדדים</h1>
        </div>
        <div class="topbar-icons">
          <button class="icon-btn" onclick="showSearchToast()">🔍</button>
        </div>
      </div>

      <div class="grid-2">
        <div>
          <div id="mealsList"></div>

          <div class="add-form" id="mealForm">
            <div class="form-row">
              <input class="form-input" id="mealName" placeholder="שם הארוחה" data-i18n-placeholder="mealNamePlaceholder">
              <select class="form-input" id="mealTag">
                <option value="breakfast" data-i18n="mealTagBreakfast">ארוחת בוקר</option>
                <option value="lunch" data-i18n="mealTagLunch">ארוחת צהריים</option>
                <option value="dinner" data-i18n="mealTagDinner">ארוחת ערב</option>
                <option value="snack" data-i18n="mealTagSnack">חטיף</option>
              </select>
            </div>
            <div class="form-row">
              <input class="form-input" id="mealCal" placeholder="קלוריות" type="number" data-i18n-placeholder="mealCalPlaceholder">
              <input class="form-input" id="mealProtein" placeholder="חלבון (ג')" type="number" data-i18n-placeholder="mealProteinPlaceholder">
            </div>
            <div class="form-row">
              <input class="form-input" id="mealCarbs" placeholder="פחמימות (ג')" type="number" data-i18n-placeholder="mealCarbsPlaceholder">
              <div></div>
            </div>
            <div class="form-actions">
              <button class="form-save" id="mealSaveBtn" onclick="saveMeal()">שמור ארוחה</button>
              <button class="form-cancel" onclick="toggleMealForm(false)" data-i18n="cancelBtn">ביטול</button>
            </div>
          </div>

          <button class="btn" style="width: 100%; margin-top: 12px;" onclick="toggleMealForm(true)" data-i18n="addMealBtn">＋ הוסף ארוחה</button>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="dailySummaryTitle">סיכום יומי</div>

          <div style="margin-top: 16px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 6px;">
              <span style="color: #9c9c9c;" data-i18n="macroCals">קלוריות</span>
              <span style="font-weight: 700;" id="sumCal">0 / 0</span>
            </div>
            <div class="bar-track"><div class="bar-fill" id="sumCalBar" style="width: 0%;"></div></div>
          </div>

          <div style="margin-top: 12px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 6px;">
              <span style="color: #9c9c9c;" data-i18n="macroProtein">חלבון</span>
              <span style="font-weight: 700;" id="sumProt">0ג׳ / 0ג׳</span>
            </div>
            <div class="bar-track"><div class="bar-fill" id="sumProtBar" style="width: 0%; background: #3fd7e8;"></div></div>
          </div>

          <div style="margin-top: 12px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 6px;">
              <span style="color: #9c9c9c;" data-i18n="macroCarbs">פחמימות</span>
              <span style="font-weight: 700;" id="sumCarb">0ג׳ / 0ג׳</span>
            </div>
            <div class="bar-track"><div class="bar-fill" id="sumCarbBar" style="width: 0%; background: #e0c93f;"></div></div>
          </div>

          <div style="margin-top: 12px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 6px;">
              <span style="color: #9c9c9c;" data-i18n="macroFats">שומן</span>
              <span style="font-weight: 700;" id="sumFat">0ג׳ / 0ג׳</span>
            </div>
            <div class="bar-track"><div class="bar-fill" id="sumFatBar" style="width: 0%; background: #ff9500;"></div></div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="save-toast" id="saveToast" data-i18n="savedToastDefault">נשמר</div>

<script>
/* ================================================================
   STATE
   ================================================================ */
let user = null;
let metrics = null;
let meals = [];
let exercises = [];
let trainingLog = [];
let dailyStats = { sleep: 0, steps: 0 };
let trainingDays = [false, false, false, false, false, false, false]; // index = JS Date.getDay(), 0=Sunday
let editingMealIndex = null;
let editingExerciseIndex = null;
let editingLogId = null;

/* Meal, exercise and workout names are free text that goes back out through
   innerHTML, so escape it — otherwise a name containing markup renders as
   HTML instead of as the characters the user typed. */
function esc(v){
  return String(v == null ? '' : v).replace(/[&<>"']/g, function(c){
    return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
  });
}

const MEAL_TAG_EMOJI = { breakfast: '\u{1F373}', lunch: '\u{1F37D}\u{FE0F}', dinner: '\u{1F319}', snack: '\u{1F34E}' };

/* The add/edit forms are shared, so their submit labels depend on mode. */
function updateFormLabels(){
  const mb = document.getElementById('mealSaveBtn');
  if(mb) mb.textContent = editingMealIndex === null ? t('saveMealBtn') : t('saveChangesBtn');
  const eb = document.getElementById('exSaveBtn');
  if(eb) eb.textContent = editingExerciseIndex === null ? t('saveExerciseBtn') : t('saveChangesBtn');
  const lb = document.getElementById('logSaveBtnEl');
  if(lb) lb.textContent = editingLogId === null ? t('logSaveBtn') : t('saveChangesBtn');
}

/* ================================================================
   STORAGE HELPERS (persists between visits, via localStorage)
   ================================================================ */
async function saveKey(key, value){
  try{
    localStorage.setItem('fitpro:' + key, JSON.stringify(value));
  }catch(e){ console.warn('storage save failed', e); }
}
async function loadKey(key, fallback){
  try{
    const raw = localStorage.getItem('fitpro:' + key);
    if(raw !== null) return JSON.parse(raw);
  }catch(e){ /* key not found or storage unavailable (e.g. private browsing) */ }
  return fallback;
}

/* ================================================================
   TRANSLATIONS (Hebrew / English) — UI chrome only; free-text the
   user types (meal/exercise names they add) is never auto-translated.
   ================================================================ */
const translations = {
  he: {
    onboardSubtitle: 'בואו נתחיל את הטיול שלך לכושר',
    fieldName: 'שם פרטי', placeholderName: 'לדוגמה: דניאל', errorName: 'נא להזין שם',
    fieldAge: 'גיל', errorAge: 'נא להזין גיל בין 13 ל-120',
    fieldGender: 'מין', genderMale: 'זכר', genderFemale: 'נקבה',
    fieldWeight: 'משקל (ק״ג)', errorWeight: 'נא להזין משקל בין 20 ל-300 ק״ג',
    fieldHeight: 'גובה (ס״מ)', errorHeight: 'נא להזין גובה בין 100 ל-250 ס״מ',
    fieldGoal: 'מה היעד שלך?', goalPlaceholder: 'בחר יעד...',
    goalWeightLoss: '🔥 חיטוב (הפחתת משקל)', goalMaintenance: '⚖️ שמירה על משקל', goalMuscleGain: '💪 בנייה שרירית',
    errorGoal: 'נא לבחור יעד',
    macroTitle: '🎯 התוכנית התזונתית שלך', macroCals: 'קלוריות', macroProtein: 'חלבון', macroCarbs: 'פחמימות', macroFats: 'שומן',
    unitKcalDay: 'kcal/יום', unitGramDay: 'גרם/יום',
    macroTip: '<strong>💡 טיפ:</strong> הנתונים האלו מחושבים בהתאם לפרופיל שלך. אתה יכול לשנות אותם בכל עת.',
    submitBtn: 'התחל עכשיו',
    brandSubtitle: 'מאמן אישי',
    navDashboard: 'לוח בקרה', navLive: 'אימון חי', navProgram: 'תוכנית אימונים', navNutrition: 'תזונה ומדדים',
    startWorkoutBtn: 'התחל אימון',
    greetingDefault: 'שלום 👋',
    heroTrainingDay: 'יום אימון', heroRestDay: 'יום מנוחה',
    heroNoProgram: 'עדיין לא בנית תוכנית אימונים', heroProgramReady: 'התוכנית שלך מוכנה',
    heroMetaNoProgram: 'הוסיפו תרגילים במסך תוכנית האימונים',
    heroExercisesLabel: 'תרגילים', heroTodayLogged: 'אימונים היום', heroMinutesLabel: 'דקות', heroCalLabel: 'קק״ל',
    editPlanBtn: 'ערוך תוכנית', startNowBtn: 'התחל עכשיו ▶',
    nutritionGoalTitle: '🎯 היעד התזונתי שלך היום',
    sleepTitle: 'שעות שינה', sleepUnit: 'שעות', stepsTitle: 'צעדים', weeklyProgressTitle: 'התקדמות שבועית',
    liveTitle: 'אימון פעיל',
    workoutTimerTitle: 'טיימר אימון', notStartedLabel: 'האימון טרם התחיל', inProgressLabel: 'האימון בעיצומו…', pausedLabel: 'האימון מושהה',
    startWorkoutCta: 'התחל אימון ▶', resumeBtn: 'המשך ▶', pauseBtn: 'השהה ⏸', finishWorkoutBtn: 'סיים ותעד ✓',
    logNamePlaceholder: 'שם האימון (לדוגמה: רגליים)', logExercisesLabel: 'תרגילים שבוצעו', noExercisesYet: 'עדיין לא הוספת תרגילים בתוכנית האימונים',
    logCaloriesPlaceholder: 'קלוריות (אופציונלי)', logNotesPlaceholder: 'הערות (אופציונלי)', logSaveBtn: 'שמור אימון ביומן',
    logNameDefault: 'אימון', trainingLogTitle: 'יומן אימונים', logEmptyState: 'עדיין לא תיעדת אימונים. סיים אימון כדי להוסיף רשומה ראשונה!',
    logSavedToast: 'האימון נשמר ביומן!', minUnit: 'דק׳',
    notificationsToast: 'אין התראות חדשות', searchComingSoon: 'החיפוש יגיע בקרוב',
    liveInfoToast: 'לחצו "התחל אימון" כדי לעקוב אחרי הזמן ולתעד אותו ביומן האימונים',
    programTitle: 'מעקב ביצועים שבועי', weeklyPlanTitle: 'תוכנית שבועית', weeklyPlanHint: 'לחצו על יום כדי לסמן אותו כיום אימון', exercisesTitle: 'תרגילים',

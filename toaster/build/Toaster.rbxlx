      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CosmeticDefinitions</string>
          <string name="Source"><![CDATA[--!strict
-- Cosmetics are purely visual: nothing here may change gameplay stats.
-- Source "Crumbs" = bought with crumbs, "GamePass"/"Product" = Robux (see Monetization),
-- "Achievement" = unlocked by an achievement.

export type Cosmetic = {
	Id: string,
	Slot: string, -- "Hat" | "Trail"
	DisplayName: string,
	Source: string,
	Price: number,
	Color: { number }, -- RGB 0-255, used by the procedural builders
}

local list: { Cosmetic } = {
	{ Id = "PartyHat", Slot = "Hat", DisplayName = "Party Hat", Source = "Crumbs", Price = 250, Color = { 255, 90, 140 } },
	{ Id = "ChefHat", Slot = "Hat", DisplayName = "Chef Hat", Source = "Crumbs", Price = 400, Color = { 245, 240, 230 } },
	{ Id = "Crown", Slot = "Hat", DisplayName = "Golden Crown", Source = "GamePass", Price = 0, Color = { 255, 212, 71 } },
	{ Id = "CrumbTrail", Slot = "Trail", DisplayName = "Crumb Trail", Source = "Crumbs", Price = 200, Color = { 217, 163, 95 } },
	{ Id = "FlameTrail", Slot = "Trail", DisplayName = "Flame Trail", Source = "Crumbs", Price = 600, Color = { 255, 122, 26 } },
	{ Id = "ButterTrail", Slot = "Trail", DisplayName = "Butter Trail", Source = "Achievement", Price = 0, Color = { 246, 226, 122 } },
	{ Id = "GoldenTrail", Slot = "Trail", DisplayName = "Golden Trail", Source = "GamePass", Price = 0, Color = { 255, 212, 71 } },
}

local byId: { [string]: Cosmetic } = {}
for _, cosmetic in list do
	byId[cosmetic.Id] = cosmetic
end

return {
	List = list,
	ById = byId,
	Slots = { "Hat", "Trail" },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DataSchema</string>
          <string name="Source"><![CDATA[--!strict
-- Saved player data: defaults, reconciliation and corruption protection.
-- Pure Luau so it can be unit tested outside Roblox.

local DataSchema = {}

DataSchema.Version = 1
DataSchema.MaxReceipts = 50

local function defaultStatistics()
	return {
		RoundsPlayed = 0,
		RoundsSurvived = 0,
		TotalCrumbs = 0,
		BestLandingScore = 0,
		ButterSurvivals = 0,
		PlayersBlackened = 0,
		WaffleUnlocked = 0,
		VintageQuestDone = 0,
	}
end

function DataSchema.Default()
	return {
		Version = DataSchema.Version,
		Crumbs = 0,
		XP = 0,
		BreadLevel = 1,
		UnlockedBreads = { Bread = true },
		UnlockedCosmetics = {},
		EquippedBread = "Bread",
		EquippedCosmetics = {},
		EquippedTitle = "",
		Achievements = {},
		VintageCrumbsFound = {},
		ProcessedReceipts = {},
		Statistics = defaultStatistics(),
	}
end

local function sanitizeNumber(value: any, fallback: number, minValue: number?): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	if minValue and value < minValue then
		return minValue
	end
	return value
end

local function sanitizeString(value: any, fallback: string): string
	if type(value) ~= "string" or #value > 64 then
		return fallback
	end
	return value
end

-- Sets of ids are stored as { [id] = true }. Anything else is dropped.
local function sanitizeSet(value: any): { [string]: boolean }
	local result = {}
	if type(value) ~= "table" then
		return result
	end
	for key, flag in value do
		if type(key) == "string" and flag == true then
			result[key] = true
		end
	end
	return result
end

local function sanitizeStringMap(value: any): { [string]: string }
	local result = {}
	if type(value) ~= "table" then
		return result
	end
	for key, item in value do
		if type(key) == "string" and type(item) == "string" then
			result[key] = item
		end
	end
	return result
end

-- Returns a fully valid copy of `raw` (which may be nil, partial or corrupt)
-- plus a flag saying whether the input was a recognisable save at all.
function DataSchema.Reconcile(raw: any): (any, boolean)
	local data = DataSchema.Default()
	if type(raw) ~= "table" then
		return data, false
	end

	data.Crumbs = math.floor(sanitizeNumber(raw.Crumbs, 0, 0))
	data.XP = math.floor(sanitizeNumber(raw.XP, 0, 0))
	data.BreadLevel = math.floor(sanitizeNumber(raw.BreadLevel, 1, 1))
	data.UnlockedBreads = sanitizeSet(raw.UnlockedBreads)
	data.UnlockedBreads.Bread = true
	data.UnlockedCosmetics = sanitizeSet(raw.UnlockedCosmetics)
	data.EquippedBread = sanitizeString(raw.EquippedBread, "Bread")
	if not data.UnlockedBreads[data.EquippedBread] then
		data.EquippedBread = "Bread"
	end
	data.EquippedCosmetics = sanitizeStringMap(raw.EquippedCosmetics)
	for slot, cosmeticId in data.EquippedCosmetics do
		if not data.UnlockedCosmetics[cosmeticId] then
			data.EquippedCosmetics[slot] = nil
		end
	end
	data.EquippedTitle = sanitizeString(raw.EquippedTitle, "")
	data.Achievements = sanitizeSet(raw.Achievements)
	data.VintageCrumbsFound = sanitizeSet(raw.VintageCrumbsFound)

	if type(raw.ProcessedReceipts) == "table" then
		for _, receiptId in raw.ProcessedReceipts do
			if type(receiptId) == "string" and #data.ProcessedReceipts < DataSchema.MaxReceipts then
				table.insert(data.ProcessedReceipts, receiptId)
			end
		end
	end

	local stats = defaultStatistics()
	if type(raw.Statistics) == "table" then
		for key, fallback in stats do
			stats[key] = math.floor(sanitizeNumber(raw.Statistics[key], fallback :: number, 0))
		end
	end
	data.Statistics = stats

	return data, true
end

function DataSchema.RememberReceipt(data: any, receiptId: string)
	table.insert(data.ProcessedReceipts, receiptId)
	while #data.ProcessedReceipts > DataSchema.MaxReceipts do
		table.remove(data.ProcessedReceipts, 1)
	end
end

function DataSchema.HasReceipt(data: any, receiptId: string): boolean
	return table.find(data.ProcessedReceipts, receiptId) ~= nil
end

return DataSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ForkPath</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic figure-eight path for the Giant Fork. Server (zaps) and
-- clients (rendering) evaluate the same function on the shared server clock,
-- so the fork looks smooth everywhere without streaming positions.

local ForkPath = {}

export type PathConfig = { PathRadiusX: number, PathRadiusZ: number, LapTime: number }

-- Returns the XZ offset from the toaster centre `elapsed` seconds into the event.
function ForkPath.Offset(elapsed: number, cfg: PathConfig): (number, number)
	local u = (elapsed / cfg.LapTime) * math.pi * 2
	return math.sin(u) * cfg.PathRadiusX, math.sin(u * 2) * cfg.PathRadiusZ
end

return ForkPath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">HeatMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure heat calculations shared by the server (authoritative) and the client
-- (display only). No Roblox types, so it is unit-testable.

local HeatMath = {}

export type HeatConfig = {
	MaxHeat: number,
	WarmThreshold: number,
	VeryHotThreshold: number,
	CriticalThreshold: number,
	BurnThreshold: number,
}

export type ZoneConfig = {
	CenterMultiplier: number,
	CoilMultiplier: number,
	SafeMultiplier: number,
	CoilBand: number,
	SafeNookDepth: number,
	SafeNookHalfWidth: number,
}

export type MapConfig = {
	InteriorLength: number,
	InteriorWidth: number,
}

export type HeatModifiers = {
	zoneMultiplier: number,
	breadResistance: number,
	shieldMultiplier: number?, -- set while a Butter Shield is active
	abilityResistance: number?, -- e.g. Waffle Slam
	hotSpotMultiplier: number?, -- set while standing in an active hot spot
}

function HeatMath.GetState(heat: number, cfg: HeatConfig): string
	if heat >= cfg.BurnThreshold then
		return "Burnt"
	elseif heat >= cfg.CriticalThreshold then
		return "Critical"
	elseif heat >= cfg.VeryHotThreshold then
		return "VeryHot"
	elseif heat >= cfg.WarmThreshold then
		return "Warm"
	end
	return "Normal"
end

-- localX / localZ are relative to the toaster centre. Coils run along the two
-- long (±Z) walls; the cool "safe nooks" sit in the middle of the two end walls.
function HeatMath.GetZone(localX: number, localZ: number, map: MapConfig, zones: ZoneConfig): (string, number)
	local halfLength = map.InteriorLength / 2
	local halfWidth = map.InteriorWidth / 2

	if math.abs(localX) >= halfLength - zones.SafeNookDepth and math.abs(localZ) <= zones.SafeNookHalfWidth then
		return "Safe", zones.SafeMultiplier
	end
	if math.abs(localZ) >= halfWidth - zones.CoilBand then
		return "Coils", zones.CoilMultiplier
	end
	return "Center", zones.CenterMultiplier
end

function HeatMath.ComputeDelta(baseRate: number, dt: number, mods: HeatModifiers): number
	local rate = baseRate * mods.zoneMultiplier * mods.breadResistance
	if mods.hotSpotMultiplier then
		rate *= mods.hotSpotMultiplier
	end
	if mods.abilityResistance then
		rate *= mods.abilityResistance
	end
	if mods.shieldMultiplier then
		rate *= mods.shieldMultiplier
	end
	return math.max(0, rate * dt)
end

function HeatMath.Clamp(heat: number, cfg: HeatConfig): number
	return math.clamp(heat, 0, cfg.MaxHeat)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Toast colour ramp: raw -> golden -> brown -> charcoal. Returns 0-255 RGB.
local STOPS = {
	{ 0, 247, 226, 181 },
	{ 35, 242, 194, 107 },
	{ 70, 201, 121, 46 },
	{ 90, 110, 60, 26 },
	{ 100, 30, 22, 18 },
}

function HeatMath.ToastRGB(heat: number): (number, number, number)
	local h = math.clamp(heat, 0, 100)
	for i = 2, #STOPS do
		local hi = STOPS[i]
		if h <= hi[1] then
			local lo = STOPS[i - 1]
			local t = (h - lo[1]) / (hi[1] - lo[1])
			return lerp(lo[2], hi[2], t), lerp(lo[3], hi[3], t), lerp(lo[4], hi[4], t)
		end
	end
	local last = STOPS[#STOPS]
	return last[2], last[3], last[4]
end

-- Darken an RGB triple by `amount` (0 = unchanged, 1 = black).
function HeatMath.Darken(r: number, g: number, b: number, amount: number): (number, number, number)
	local k = 1 - math.clamp(amount, 0, 1)
	return r * k, g * k, b * k
end

return HeatMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">LandingMath</string>
          <string name="Source"><![CDATA[--!strict
-- Pure launch + landing maths. The launch is a controlled ballistic shot:
-- each player gets a landing target derived from where they stood in the
-- toaster, and we solve the exact velocity that reaches it in FlightTime.

local LandingMath = {}

export type Zone = { Id: string, Name: string, Radius: number, Points: number }

export type LaunchConfig = {
	FlightTime: number,
	OffsetScale: number,
	RandomSpread: number,
	PadRadius: number,
	PadSpread: number,
}

-- Velocity that moves a projectile from p to t in `flightTime` seconds under `gravity`.
function LandingMath.SolveVelocity(
	px: number,
	py: number,
	pz: number,
	tx: number,
	ty: number,
	tz: number,
	flightTime: number,
	gravity: number
): (number, number, number)
	assert(flightTime > 0, "flightTime must be positive")
	local vx = (tx - px) / flightTime
	local vz = (tz - pz) / flightTime
	local vy = (ty - py + 0.5 * gravity * flightTime * flightTime) / flightTime
	return vx, vy, vz
end

-- Position along the arc after `t` seconds. Used for tests and fallbacks.
function LandingMath.PositionAt(
	px: number,
	py: number,
	pz: number,
	vx: number,
	vy: number,
	vz: number,
	gravity: number,
	t: number
): (number, number, number)
	return px + vx * t, py + vy * t - 0.5 * gravity * t * t, pz + vz * t
end

-- Landing offset from the bullseye. Standing near the toaster centre lands you
-- near the bullseye; the POP pad tightens the random spread.
-- `randAngle` and `randRadius` are in [0, 1) so callers control randomness.
function LandingMath.TargetOffset(
	localX: number,
	localZ: number,
	cfg: LaunchConfig,
	randAngle: number,
	randRadius: number
): (number, number)
	local distFromCentre = math.sqrt(localX * localX + localZ * localZ)
	local onPad = distFromCentre <= cfg.PadRadius
	local spread = if onPad then cfg.PadSpread else cfg.RandomSpread
	local angle = randAngle * math.pi * 2
	local radius = math.sqrt(randRadius) * spread
	local scale = if onPad then 0 else cfg.OffsetScale
	return localX * scale + math.cos(angle) * radius, localZ * scale + math.sin(angle) * radius
end

function LandingMath.IsOnPad(localX: number, localZ: number, cfg: LaunchConfig): boolean
	return math.sqrt(localX * localX + localZ * localZ) <= cfg.PadRadius
end

-- Zones must be ordered best -> worst with increasing radius.
function LandingMath.ZoneForDistance(distance: number, zones: { Zone }): Zone
	for _, zone in zones do
		if distance <= zone.Radius then
			return zone
		end
	end
	return zones[#zones]
end

return LandingMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Maid</string>
          <string name="Source"><![CDATA[-- Owns cleanup for connections, instances, threads and callbacks so every
-- event connection has an explicit lifecycle.

local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable({} :: { _tasks: { [any]: any } }, Maid))

function Maid.new(): Maid
	return setmetatable({ _tasks = {} }, Maid)
end

local function cleanupTask(job: any)
	local kind = typeof(job)
	if kind == "RBXScriptConnection" then
		job:Disconnect()
	elseif kind == "Instance" then
		job:Destroy()
	elseif kind == "function" then
		job()
	elseif kind == "thread" then
		if coroutine.status(job) ~= "dead" then
			pcall(task.cancel, job)
		end
	elseif kind == "table" and type(job.Destroy) == "function" then
		job:Destroy()
	end
end

-- Adds a task; returns it for convenience.
function Maid.Give<T>(self: Maid, job: T): T
	table.insert(self._tasks, job)
	return job
end

-- Named task: replacing a name cleans the previous task.
function Maid.Set(self: Maid, name: string, job: any)
	local previous = self._tasks[name]
	self._tasks[name] = job
	if previous ~= nil and previous ~= job then
		cleanupTask(previous)
	end
end

function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for _, job in tasks do
		cleanupTask(job)
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></string>
        </Properties>
      </Item>

      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Entry point: builds the world, then initialises and starts every server
-- manager in dependency order. Managers receive the registry in Init so they
-- can reference each other without circular requires.

local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")

local ORDER = {
	"Messaging",
	"MapBuilder",
	"DataManager",
	"CurrencyManager",
	"PlayerManager",
	"HeatManager",
	"PickupManager",
	"LaunchManager",
	"RewardManager",
	"AchievementManager",
	"AbilityManager",
	"EventManager",
	"CrumbWorldManager",
	"ShopManager",
	"RoundManager",
}

local registry = {}
for _, name in ORDER do
	registry[name] = require(Server:WaitForChild(name))
end

registry.MapBuilder.Build()

for _, name in ORDER do
	local service = registry[name]
	if type(service.Init) == "function" then
		service.Init(registry)
	end
end

-- PlayerManager starts last so every other manager is already listening
-- (e.g. DataManager.OnLoaded) before the first player is processed.
local START_LAST = "PlayerManager"
for _, name in ORDER do
	local service = registry[name]
	if name ~= START_LAST and type(service.Start) == "function" then
		service.Start()
	end
end
registry[START_LAST].Start()

print("[TOASTER] 🍞 Server ready.")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">AbilityManager</string>
          <string name="Source"><![CDATA[-- Validates and resolves every player action request: bread abilities
-- (Roll / Flake Trail / Waffle Slam), the Butter Shield and thrown spreads
-- (Jam / Nutella). The client only asks; the server checks rate limits,
-- round state, ownership, cooldowns and arguments, then decides the outcome.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AbilityDefinitions = require(Shared.AbilityDefinitions)
local BreadDefinitions = require(Shared.BreadDefinitions)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Net = require(Shared.Net)
local RateLimiter = require(Shared.RateLimiter)

local AbilityManager = {}

local PHASES = Constants.Phases
local ATTR = Constants.Attr
local services
local limiter = RateLimiter.new(Config.RateLimits.Ability.Capacity, Config.RateLimits.Ability.RefillPerSecond)

type Hazard = {
	Kind: string, -- "Flake" | "Puddle"
	Position: Vector3,
	Radius: number,
	ExpiresAt: number,
	Owner: Player?,
}

local hazards: { Hazard } = {}
local slipCooldowns: { [Player]: number } = {}
local hazardLoop: thread? = nil
local roundToken = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

function AbilityManager.Init(registry)
	services = registry
end

-- Knockback is applied by the victim's own client (it owns its physics).
function AbilityManager.Push(session, velocity: Vector3)
	services.Messaging.Effect(session.Player, "Knockback", { Velocity = velocity })
end

local function reject(player: Player, message: string)
	services.Messaging.Notify(player, message, "Info", 1.6)
	services.Messaging.Sound(player, "Error")
end

local function startCooldown(session, key: string, duration: number)
	local endsAt = now() + duration
	session.Cooldowns[key] = endsAt
	session.Player:SetAttribute(ATTR.CooldownPrefix .. key, endsAt)
end

local function onCooldown(session, key: string): boolean
	return now() < (session.Cooldowns[key] or 0)
end

local function otherSessionsNear(position: Vector3, radius: number, exclude: Player?): { any }
	local result = {}
	for _, session in services.PlayerManager.InRound() do
		if session.Player ~= exclude then
			local root = services.PlayerManager.GetBody(session)
			if root and (root.Position - position).Magnitude <= radius then
				table.insert(result, { Session = session, Root = root })
			end
		end
	end
	return result
end

local function outward(from: Vector3, to: Vector3, force: number, lift: number): Vector3
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local dir = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(1, 0, 0)
	return dir * force + Vector3.new(0, lift, 0)
end

local function slip(victim, kind: string, duration: number, position: Vector3)
	local player = victim.Player
	local t = now()
	if t < (slipCooldowns[player] or 0) then
		return
	end
	slipCooldowns[player] = t + duration + 0.6
	if kind == "Puddle" then
		services.Messaging.Effect(player, "Slide", { Duration = duration })
		services.Messaging.Sound(nil, "NutellaSlip", position)
	else
		services.Messaging.Effect(player, "Slip", { Duration = duration })
		services.Messaging.Notify(player, "🥐 You slipped on a flake!", "Info", 1.5)
		services.Messaging.Sound(nil, "Slip", position)
	end
end

local function stepHazards()
	local t = now()
	for i = #hazards, 1, -1 do
		if t >= hazards[i].ExpiresAt then
			table.remove(hazards, i)
		end
	end
	if #hazards == 0 then
		return false
	end
	for _, session in services.PlayerManager.InRound() do
		local root = services.PlayerManager.GetBody(session)
		if root then
			for _, hazard in hazards do
				local flat = Vector3.new(root.Position.X - hazard.Position.X, 0, root.Position.Z - hazard.Position.Z)
				if
					hazard.Owner ~= session.Player
					and flat.Magnitude <= hazard.Radius
					and math.abs(root.Position.Y - hazard.Position.Y) < 5
				then
					if hazard.Kind == "Puddle" then
						slip(session, "Puddle", Config.Spreads.Nutella.SlideDuration, root.Position)
					else
						slip(session, "Flake", AbilityDefinitions.FlakeTrail.SlipDuration, root.Position)
					end
					break
				end
			end
		end
	end
	return true
end

-- Runs only while hazards exist.
local function ensureHazardLoop()
	if hazardLoop then
		return
	end
	hazardLoop = task.defer(function()
		while stepHazards() do
			task.wait(0.1)
		end
		hazardLoop = nil
	end)
end

local function addHazard(hazard: Hazard)
	table.insert(hazards, hazard)
	ensureHazardLoop()
end

------------------------------------------------------------------ abilities

local ABILITIES = {}

function ABILITIES.Roll(session, root: BasePart)
	local def = AbilityDefinitions.Roll
	local player = session.Player
	local character = player.Character :: Model
	character:SetAttribute(Constants.CharAttr.Rolling, true)
	services.Messaging.Effect(player, "Roll", { Duration = def.Duration, Speed = def.Speed, TurnRate = def.TurnRate })
	services.Messaging.Sound(nil, "Ability", root.Position)
	local token = roundToken
	task.spawn(function()
		local bumped = {}
		local deadline = os.clock() + def.Duration
		while os.clock() < deadline and token == roundToken do
			local currentRoot = services.PlayerManager.GetBody(session)
			if not currentRoot then
				break
			end
			for _, hit in otherSessionsNear(currentRoot.Position, def.BumpRadius, player) do
				if not bumped[hit.Session] then
					bumped[hit.Session] = true
					AbilityManager.Push(hit.Session, outward(currentRoot.Position, hit.Root.Position, def.BumpForce, 25))
					services.Messaging.Sound(nil, "Knock", hit.Root.Position)
				end
			end
			task.wait(0.1)
		end
		if character.Parent then
			character:SetAttribute(Constants.CharAttr.Rolling, false)
		end
	end)
end

function ABILITIES.FlakeTrail(session, root: BasePart)
	local def = AbilityDefinitions.FlakeTrail
	services.Messaging.Sound(nil, "Ability", root.Position)
	local token = roundToken
	task.spawn(function()
		local deadline = os.clock() + def.Duration
		while os.clock() < deadline and token == roundToken do
			local currentRoot = services.PlayerManager.GetBody(session)
			if not currentRoot then
				break
			end
			local drop = currentRoot.Position - currentRoot.CFrame.LookVector * 2.5 - Vector3.new(0, 2.6, 0)
			addHazard({
				Kind = "Flake",
				Position = drop,
				Radius = def.FlakeRadius,
				ExpiresAt = now() + def.FlakeLifetime,
				Owner = session.Player,
			})
			services.Messaging.Effect(nil, "Flake", { Position = drop, Lifetime = def.FlakeLifetime })
			task.wait(def.DropInterval)
		end
	end)
end

function ABILITIES.WaffleSlam(session, root: BasePart)
	local def = AbilityDefinitions.WaffleSlam
	local player = session.Player
	services.Messaging.Effect(player, "SlamJump", { Velocity = def.JumpVelocity })
	services.Messaging.Sound(nil, "Ability", root.Position)
	local token = roundToken
	task.delay(def.SlamDelay, function()
		if token ~= roundToken then
			return
		end
		local currentRoot = services.PlayerManager.GetBody(session)
		if not currentRoot then
			return
		end
		local center = currentRoot.Position
		session.ResistUntil = now() + def.HeatResistDuration
		session.ResistMultiplier = def.HeatResistMultiplier
		for _, hit in otherSessionsNear(center, def.Radius, player) do
			AbilityManager.Push(hit.Session, outward(center, hit.Root.Position, def.Knockback, 35))
		end
		services.Messaging.Effect(nil, "Shockwave", { Position = center - Vector3.new(0, 2.5, 0), Radius = def.Radius })
		services.Messaging.Sound(nil, "Slam", center)
		services.Messaging.Notify(player, "🧇 WAFFLE SLAM! Heat resistance up!", "Legend", 1.8)
	end)
end

------------------------------------------------------------------ spreads

local function rayParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { services.MapBuilder.Info.Folders.Pickups, services.MapBuilder.Info.Folders.EventObjects }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	return params
end

local function throwJam(session, root: BasePart, direction: Vector3)
	local cfg = Config.Spreads.Jam
	local origin = root.Position + Vector3.new(0, 1.5, 0)

	-- Closest target along the throw line within the hit radius.
	local best, bestDistance = nil, math.huge
	for _, hit in otherSessionsNear(origin, cfg.Range, session.Player) do
		local offset = hit.Root.Position - origin
		local along = offset:Dot(direction)
		if along > 0 and along < bestDistance then
			local perpendicular = (offset - direction * along).Magnitude
			if perpendicular <= cfg.HitRadius then
				best, bestDistance = hit, along
			end
		end
	end

	local params = rayParams()
	local travelDistance = if best then bestDistance else cfg.Range
	local wall = workspace:Raycast(origin, direction * travelDistance, params)
	local endPoint = origin + direction * travelDistance
	if wall then
		best = nil -- a wall is in the way
		endPoint = wall.Position
	end

	local flightTime = (endPoint - origin).Magnitude / cfg.ProjectileSpeed
	services.Messaging.Effect(nil, "Projectile", { Kind = "Jam", From = origin, To = endPoint, Duration = flightTime })
	services.Messaging.Sound(nil, "Throw", origin)

	local token = roundToken
	task.delay(flightTime, function()
		if token ~= roundToken then
			return
		end
		services.Messaging.Effect(nil, "Splat", { Kind = "Jam", Position = endPoint })
		if not best then
			return
		end
		local victim = best.Session
		if not victim.InRound or not services.PlayerManager.GetBody(victim) then
			return
		end
		victim.StuckUntil = now() + cfg.StuckDuration
		services.PlayerManager.RefreshMovement(victim)
		local character = victim.Player.Character
		if character then
			character:SetAttribute(Constants.CharAttr.Stuck, true)
		end
		services.Messaging.Notify(victim.Player, `🍓 {session.Player.DisplayName} JAMMED you!`, "Danger", 1.8)
		services.Messaging.Notify(session.Player, `🍓 Direct hit on {victim.Player.DisplayName}!`, "Good", 1.5)
		services.Messaging.Sound(nil, "JamHit", endPoint)
	end)
end

local function throwNutella(session, root: BasePart, direction: Vector3)
	local cfg = Config.Spreads.Nutella
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local params = rayParams()
	local flatDir = Vector3.new(direction.X, 0, direction.Z)
	flatDir = if flatDir.Magnitude > 0.01 then flatDir.Unit else root.CFrame.LookVector
	local reach = cfg.Range
	local wall = workspace:Raycast(origin, flatDir * reach, params)
	if wall then
		reach = math.max(0, (wall.Position - origin).Magnitude - cfg.PuddleRadius * 0.5)
	end
	local above = origin + flatDir * reach
	local ground = workspace:Raycast(above, Vector3.new(0, -60, 0), params)
	local landing = if ground then ground.Position else above - Vector3.new(0, 4, 0)

	local flightTime = math.max(0.3, (landing - origin).Magnitude / Config.Spreads.Jam.ProjectileSpeed)
	services.Messaging.Effect(nil, "Projectile", { Kind = "Nutella", From = origin, To = landing, Duration = flightTime })
	services.Messaging.Sound(nil, "Throw", origin)
	local token = roundToken
	task.delay(flightTime, function()
		if token ~= roundToken then
			return
		end
		addHazard({
			Kind = "Puddle",
			Position = landing,
			Radius = cfg.PuddleRadius,
			ExpiresAt = now() + cfg.PuddleDuration,
			Owner = nil,
		})
		services.Messaging.Effect(nil, "Puddle", { Position = landing, Radius = cfg.PuddleRadius, Duration = cfg.PuddleDuration })
	end)
end

------------------------------------------------------------------ request handling

local ACTION_PHASES = {
	[PHASES.Calm] = true,
	[PHASES.Heating] = true,
}

local function validDirection(value: any): Vector3?
	if typeof(value) ~= "Vector3" then
		return nil
	end
	local v = value :: Vector3
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z or v.Magnitude < 0.1 or v.Magnitude > 1e4 then
		return nil
	end
	return v.Unit
end

local function handle(player: Player, action: any, arg1: any, arg2: any)
	if type(action) ~= "string" or not limiter:Allow(player) then
		return
	end
	local session = services.PlayerManager.Get(player)
	if not session or not session.InRound then
		return
	end
	local root = services.PlayerManager.GetBody(session)
	if not root then
		return
	end
	local phase = services.RoundManager.GetPhase()

	if action == "Butter" then
		if phase ~= PHASES.Heating then
			reject(player, "🧈 Save your butter for when the toaster is ON!")
		elseif session.ButterCarried <= 0 then
			reject(player, "🧈 You don't have any butter.")
		elseif not services.HeatManager.ActivateShield(session) then
			reject(player, "🧈 Shield already active.")
		end
		return
	end

	if not ACTION_PHASES[phase] then
		return
	end
	if session.IsCharcoal then
		reject(player, "🪨 Charcoal can't do that... but your touch blackens others!")
		return
	end
	if now() < session.StuckUntil then
		return
	end

	if action == "Ability" then
		local bread = BreadDefinitions.ById[services.PlayerManager.EquippedBread(session)]
		local abilityName = bread and bread.Ability
		if not abilityName or not ABILITIES[abilityName] then
			reject(player, "🍞 Bread slices have no ability. Unlock a Bagel in the shop!")
			return
		end
		if onCooldown(session, "Ability") then
			return
		end
		startCooldown(session, "Ability", AbilityDefinitions[abilityName].Cooldown)
		ABILITIES[abilityName](session, root)
	elseif action == "Spread" then
		local kind = arg1
		local direction = validDirection(arg2)
		if (kind ~= "Jam" and kind ~= "Nutella") or not direction then
			return
		end
		if onCooldown(session, kind) then
			return
		end
		startCooldown(session, kind, Config.Spreads[kind].Cooldown)
		if kind == "Jam" then
			throwJam(session, root, direction)
		else
			throwNutella(session, root, direction)
		end
	end
end

function AbilityManager.Start()
	Net.AbilityEvent.OnServerEvent:Connect(function(player, action, arg1, arg2)
		local ok, err = pcall(handle, player, action, arg1, arg2)
		if not ok then
			warn("[AbilityManager] request failed:", err)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		limiter:Forget(player)
		slipCooldowns[player] = nil
	end)
end

function AbilityManager.ResetRound()
	roundToken += 1
	table.clear(hazards)
	table.clear(slipCooldowns)
end

return AbilityManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">AchievementManager</string>
          <string name="Source"><![CDATA[-- Unlocks achievements (titles, sometimes a cosmetic) from saved statistics.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AchievementDefinitions = require(Shared.AchievementDefinitions)

local AchievementManager = {}

local services

function AchievementManager.Init(registry)
	services = registry
end

function AchievementManager.Evaluate(player: Player)
	local data = services.DataManager.Get(player)
	if not data then
		return
	end
	local unlocked = {}
	for _, achievement in AchievementDefinitions.List do
		if not data.Achievements[achievement.Id] and (data.Statistics[achievement.Stat] or 0) >= achievement.Goal then
			table.insert(unlocked, achievement)
		end
	end
	if #unlocked == 0 then
		return
	end
	services.DataManager.Update(player, function(d)
		for _, achievement in unlocked do
			d.Achievements[achievement.Id] = true
			if achievement.RewardCosmetic then
				d.UnlockedCosmetics[achievement.RewardCosmetic] = true
			end
			if d.EquippedTitle == "" then
				d.EquippedTitle = achievement.Title
			end
		end
	end)
	for _, achievement in unlocked do
		services.Messaging.Notify(player, `🏆 ACHIEVEMENT: {achievement.Title}`, "Legend", 3.5)
	end
	services.ShopManager.SendProfile(player)
end

return AchievementManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">CrumbWorldManager</string>
          <string name="Source"><![CDATA[-- CRUMB WORLD: the hidden area beneath the toaster. Players slip through the
-- secret crack during the calm phase, chat with Old Crumb (a crumb from 1987)
-- and hunt three vintage crumbs for a one-time reward. Never required for the
-- core loop; everyone is sent back up when the toaster turns on.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)

local CrumbWorldManager = {}

local PHASES = Constants.Phases
local services
local debounce: { [Player]: number } = {}
local talkIndex: { [Player]: number } = {}

local LORE = {
	"Back in 1987, we didn't have Wi-Fi.",
	"We had crumbs.",
	"And we liked it.",
	"You kids and your 'bagels'. In my day a hole in your bread meant a MOUSE.",
	"I've been toasted four thousand times. You get used to it. ...You don't, actually.",
	"Never trust the hand. It giveth crumbs. It also pusheth the lever.",
	"The fork? Don't talk to me about the fork.",
	"Psst. Be on the POP pad when the countdown starts. Thank me later.",
	"The ends of the toaster run cool. Your crust will thank you.",
	"Butter's not a snack, kid. It's armour.",
}

local VINTAGE_TOTAL = 3

local function vintageFound(data): number
	local count = 0
	for _ in data.VintageCrumbsFound do
		count += 1
	end
	return count
end

local function publishVintage(player: Player, data)
	local ids = {}
	for id in data.VintageCrumbsFound do
		table.insert(ids, id)
	end
	player:SetAttribute("VintageFound", table.concat(ids, ","))
end

local function bodyOf(player: Player): BasePart?
	local session = services.PlayerManager.Get(player)
	if not session then
		return nil
	end
	return (services.PlayerManager.GetBody(session))
end

local function touchedPlayer(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function debounced(player: Player, seconds: number): boolean
	local t = os.clock()
	if t < (debounce[player] or 0) then
		return true
	end
	debounce[player] = t + seconds
	return false
end

local function canEnter(): boolean
	local phase = services.RoundManager.GetPhase()
	return phase == PHASES.Calm or phase == PHASES.RoundStart or not Config.CrumbWorld.OpenDuringCalmOnly
end

local function enter(player: Player)
	local session = services.PlayerManager.Get(player)
	local root = bodyOf(player)
	if not session or not session.InRound or not root or not canEnter() then
		return
	end
	if (root.Position - services.MapBuilder.Info.SecretSensor.Position).Magnitude > 8 then
		return
	end
	local character = player.Character
	if character then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(CFrame.new(services.MapBuilder.Info.CrumbWorld.Entry))
	end
	services.Messaging.Notify(player, "🌎 You slipped through the crack... WELCOME TO CRUMB WORLD!", "Legend", 3.5)
	services.Messaging.Sound(player, "SecretArea")
end

local function leave(player: Player)
	local session = services.PlayerManager.Get(player)
	if not session then
		return
	end
	local phase = services.RoundManager.GetPhase()
	if session.InRound and (phase == PHASES.Calm or phase == PHASES.RoundStart or phase == PHASES.Heating) then
		services.PlayerManager.TeleportToToaster(session)
	else
		services.PlayerManager.TeleportToLobby(session)
	end
	services.Messaging.Notify(player, "⬆️ Back to the toaster!", "Info", 1.5)
end

local function onVintage(player: Player, crumb: BasePart)
	local id = crumb:GetAttribute("VintageId")
	local data = services.DataManager.Get(player)
	local root = bodyOf(player)
	if type(id) ~= "string" or not data or not root or data.VintageCrumbsFound[id] then
		return
	end
	if (root.Position - crumb.Position).Magnitude > 10 then
		return
	end
	services.DataManager.Update(player, function(d)
		d.VintageCrumbsFound[id] = true
	end)
	publishVintage(player, data)
	local found = vintageFound(data)
	services.Messaging.Sound(player, "GoldenCrumb")
	if found >= VINTAGE_TOTAL then
		services.Messaging.Notify(player, "✨ All 3 vintage crumbs found! Go see Old Crumb.", "Legend", 3)
	else
		services.Messaging.Notify(player, `✨ Vintage crumb found ({found}/{VINTAGE_TOTAL})`, "Good", 2)
	end
end

local function talk(player: Player)
	local data = services.DataManager.Get(player)
	if not data then
		return
	end
	local found = vintageFound(data)
	local line
	if found >= VINTAGE_TOTAL and data.Statistics.VintageQuestDone == 0 then
		services.DataManager.Update(player, function(d)
			d.Statistics.VintageQuestDone = 1
		end)
		services.CurrencyManager.Add(player, "Crumbs", Config.CrumbWorld.VintageCrumbReward, "VintageQuest")
		services.AchievementManager.Evaluate(player)
		line = `MY CRUMBS! You found 'em all! Here's {Config.CrumbWorld.VintageCrumbReward} crumbs. Don't spend it all on butter.`
	else
		local index = (talkIndex[player] or 0) + 1
		talkIndex[player] = index
		if data.Statistics.VintageQuestDone == 0 and index % 4 == 1 then
			if found == 0 then
				line = "I lost three vintage crumbs from '87. Golden ones. Find 'em for an old crumb, would ya?"
			else
				line = `You've found {found} of my {VINTAGE_TOTAL} vintage crumbs. Keep looking. One likes rooftops.`
			end
		else
			line = LORE[((index - 1) % #LORE) + 1]
		end
	end
	services.Messaging.Dialogue(player, "OLD CRUMB", line)
	services.Messaging.Sound(player, "NpcTalk")
end

-- Called when the toaster turns on: nobody hides down here from the heat.
function CrumbWorldManager.EvictAll()
	for _, player in Players:GetPlayers() do
		local root = bodyOf(player)
		if root and services.MapBuilder.IsInCrumbWorld(root.Position) then
			services.Messaging.Dialogue(player, "OLD CRUMB", "The toaster's ON! Up you go, kid!")
			leave(player)
		end
	end
end

function CrumbWorldManager.Init(registry)
	services = registry
end

function CrumbWorldManager.Start()
	local world = services.MapBuilder.Info.CrumbWorld

	services.MapBuilder.Info.SecretSensor.Touched:Connect(function(hit)
		local player = touchedPlayer(hit)
		if player and not debounced(player, 1.5) then
			enter(player)
		end
	end)

	world.ReturnPad.Touched:Connect(function(hit)
		local player = touchedPlayer(hit)
		if player and not debounced(player, 1.5) then
			leave(player)
		end
	end)

	world.NpcPrompt.Triggered:Connect(function(player)
		local root = bodyOf(player)
		if root and (root.Position - world.NpcHead.Position).Magnitude <= world.NpcPrompt.MaxActivationDistance + 4 then
			talk(player)
		end
	end)

	for _, crumb in world.VintageCrumbs do
		crumb.Touched:Connect(function(hit)
			local player = touchedPlayer(hit)
			if player then
				onVintage(player, crumb)
			end
		end)
	end

	services.DataManager.OnLoaded(function(player)
		local data = services.DataManager.Get(player)
		if data then
			publishVintage(player, data)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		debounce[player] = nil
		talkIndex[player] = nil
	end)
end

return CrumbWorldManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">CurrencyManager</string>
          <string name="Source"><![CDATA[-- Reusable currency system. Every grant/spend is validated server-side;
-- add a new currency by listing it in CURRENCIES and in DataSchema.

local CurrencyManager = {}

local CURRENCIES = {
	Crumbs = { StatKey = "TotalCrumbs" },
}

local services

function CurrencyManager.Init(registry)
	services = registry
end

local function validAmount(amount: number): boolean
	return type(amount) == "number" and amount == amount and amount > 0 and amount < 1e7 and math.floor(amount) == amount
end

function CurrencyManager.Get(player: Player, currency: string): number
	local data = services.DataManager.Get(player)
	if not data or not CURRENCIES[currency] then
		return 0
	end
	return data[currency] or 0
end

-- Returns true if granted.
function CurrencyManager.Add(player: Player, currency: string, amount: number, _reason: string?): boolean
	local def = CURRENCIES[currency]
	if not def or not validAmount(amount) or not services.DataManager.Get(player) then
		return false
	end
	services.DataManager.Update(player, function(data)
		data[currency] += amount
		if def.StatKey then
			data.Statistics[def.StatKey] += amount
		end
	end)
	return true
end

-- Returns true only if the player could afford it.
function CurrencyManager.Spend(player: Player, currency: string, amount: number, _reason: string?): boolean
	if not CURRENCIES[currency] or not validAmount(amount) then
		return false
	end
	local data = services.DataManager.Get(player)
	if not data or data[currency] < amount then
		return false
	end
	services.DataManager.Update(player, function(d)
		d[currency] -= amount
	end)
	return true
end

return CurrencyManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- Persistent player data with safe DataStore patterns:
--  * load with retries; on failure the session is marked unsaveable so valid
--    saved data is never overwritten with defaults
--  * every load is reconciled/sanitised (corruption protection)
--  * UpdateAsync saves with retries, on leave, on autosave and on shutdown
--  * saves only when something changed

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local DataSchema = require(Shared.DataSchema)
local Progression = require(Shared.Progression)

local DataManager = {}

type Profile = {
	Data: any,
	Loaded: boolean, -- true only when the stored value was read successfully
	Dirty: boolean,
	Saving: boolean,
}

local profiles: { [Player]: Profile } = {}
local loadedSignal = Instance.new("BindableEvent")
local store: DataStore? = nil
local services

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

-- Errors that will never succeed on retry (e.g. Studio without API access).
local function isPermanent(err: any): boolean
	local message = tostring(err)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
		or string.find(message, "must publish", 1, true) ~= nil
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T?)
	local cfg = Config.Data
	for attempt = 1, cfg.MaxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(`[DataManager] {label} failed (attempt {attempt}/{cfg.MaxRetries}): {result}`)
		if isPermanent(result) then
			break
		end
		if attempt < cfg.MaxRetries then
			task.wait(cfg.RetryDelay * attempt)
		end
	end
	return false, nil
end

local function publishAttributes(player: Player, data: any)
	player:SetAttribute(Constants.Attr.Crumbs, data.Crumbs)
	player:SetAttribute(Constants.Attr.XP, data.XP)
	player:SetAttribute(Constants.Attr.Level, Progression.LevelForXP(data.XP, Config.Progression.LevelXP))
	player:SetAttribute(Constants.Attr.Bread, data.EquippedBread)
	player:SetAttribute(Constants.Attr.Title, data.EquippedTitle)
end

function DataManager.Init(registry)
	services = registry
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataManager] DataStores unavailable; progress will not be saved this session:", result)
	end
end

function DataManager.Load(player: Player)
	local profile: Profile = { Data = DataSchema.Default(), Loaded = false, Dirty = false, Saving = false }
	profiles[player] = profile

	if store then
		local key = keyFor(player)
		local ok, raw = withRetries("Load " .. key, function()
			return (store :: DataStore):GetAsync(key)
		end)
		if ok then
			local data, recognised = DataSchema.Reconcile(raw)
			if raw ~= nil and not recognised then
				-- Corrupt value: keep a copy under a backup key before we ever overwrite it.
				warn("[DataManager] Unrecognised save for", key, "- backing it up")
				pcall(function()
					(store :: DataStore):SetAsync(key .. "_corrupt_" .. os.time(), raw)
				end)
			end
			profile.Data = data
			profile.Loaded = true
		end
	end

	if player.Parent ~= Players then
		profiles[player] = nil
		return
	end

	-- Achievement-linked flags are derived from data so they stay consistent.
	if profile.Data.UnlockedBreads.Waffle then
		profile.Data.Statistics.WaffleUnlocked = 1
	end
	publishAttributes(player, profile.Data)
	player:SetAttribute(Constants.Attr.DataLoaded, true)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local crumbs = Instance.new("IntValue")
	crumbs.Name = "Crumbs"
	crumbs.Value = profile.Data.Crumbs
	crumbs.Parent = leaderstats
	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Value = profile.Data.Statistics.BestLandingScore
	best.Parent = leaderstats
	leaderstats.Parent = player

	if not profile.Loaded and store then
		services.Messaging.Notify(player, "⚠️ Couldn't load your save. Progress this session won't be saved.", "Warning", 6)
	end
	loadedSignal:Fire(player)
end

function DataManager.Get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.Data
end

function DataManager.IsLoaded(player: Player): boolean
	return player:GetAttribute(Constants.Attr.DataLoaded) == true
end

-- All mutations go through Update so the profile is marked dirty and
-- replicated attributes stay in sync.
function DataManager.Update(player: Player, mutator: (data: any) -> ())
	local profile = profiles[player]
	if not profile then
		return
	end
	mutator(profile.Data)
	profile.Dirty = true
	publishAttributes(player, profile.Data)
	local leaderstats: any = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Crumbs.Value = profile.Data.Crumbs
		leaderstats.Best.Value = profile.Data.Statistics.BestLandingScore
	end
end

function DataManager.Save(player: Player, force: boolean?)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	if not profile.Loaded then
		return -- never overwrite real data with defaults after a failed load
	end
	if (not profile.Dirty and not force) or profile.Saving then
		return
	end
	profile.Saving = true
	profile.Dirty = false
	local snapshot = deepCopy(profile.Data)
	local key = keyFor(player)
	local ok = withRetries("Save " .. key, function()
		return (store :: DataStore):UpdateAsync(key, function(_old)
			return snapshot
		end)
	end)
	if not ok then
		profile.Dirty = true
	end
	profile.Saving = false
end

function DataManager.OnLoaded(callback: (Player) -> ()): RBXScriptConnection
	return loadedSignal.Event:Connect(callback)
end

function DataManager.Release(player: Player)
	DataManager.Save(player)
	profiles[player] = nil
end

function DataManager.Start()
	Players.PlayerRemoving:Connect(function(player)
		DataManager.Release(player)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player in profiles do
				task.spawn(DataManager.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataManager.Save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">EventManager</string>
          <string name="Source"><![CDATA[-- Heating-phase chaos: random telegraphed events (falling food, hot spots,
-- steam bursts, toaster shakes, falling butter) and the rare Giant Fork boss.
-- Every hazard is announced to clients before it can affect anyone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local ForkPath = require(Shared.ForkPath)

local EventManager = {}

local EVENTS = Config.Events
local FORK = Config.Fork
local services
local rng = Random.new()

type HotSpot = { Position: Vector3, Radius: number, StartsAt: number, EndsAt: number }

local heatingToken = 0
local hotSpots: { HotSpot } = {}
local roundsSinceFork = 0
local forkThisRound = false

local function now(): number
	return workspace:GetServerTimeNow()
end

function EventManager.Init(registry)
	services = registry
end

local function info()
	return services.MapBuilder.Info
end

local function randomFloorPoint(margin: number): Vector3
	local i = info()
	return Vector3.new(
		rng:NextNumber(-i.HalfLength + margin, i.HalfLength - margin),
		i.FloorY,
		rng:NextNumber(-i.HalfWidth + margin, i.HalfWidth - margin)
	)
end

-- Runs `fn` after `delay` seconds unless heating ended in the meantime.
local function later(delay: number, fn: () -> ())
	local token = heatingToken
	task.delay(delay, function()
		if token == heatingToken then
			fn()
		end
	end)
end

local function sessionsNear(position: Vector3, radius: number): { any }
	local result = {}
	for _, session in services.PlayerManager.InRound() do
		local root = services.PlayerManager.GetBody(session)
		if root then
			local flat = Vector3.new(root.Position.X - position.X, 0, root.Position.Z - position.Z)
			if flat.Magnitude <= radius and math.abs(root.Position.Y - position.Y) < 12 then
				table.insert(result, { Session = session, Root = root })
			end
		end
	end
	return result
end

local function pushAway(center: Vector3, root: BasePart, force: number, lift: number): Vector3
	local flat = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z)
	local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
	return dir * force + Vector3.new(0, lift, 0)
end

------------------------------------------------------------------ events

local RUNNERS = {}

local function dropItem(kind: string, position: Vector3)
	local cfg = EVENTS.FallingFood
	local impactIn = EVENTS.WarningTime + cfg.FallTime
	services.Messaging.Effect(nil, "FallingItem", {
		Kind = kind,
		Position = position,
		ImpactAt = now() + impactIn,
		FallTime = cfg.FallTime,
	})
	later(impactIn, function()
		services.Messaging.Effect(nil, "Impact", { Position = position, Kind = kind })
		if kind == "Junk" then
			for _, hit in sessionsNear(position, cfg.ImpactRadius) do
				services.AbilityManager.Push(hit.Session, pushAway(position, hit.Root, cfg.JunkKnockback, 30))
				services.Messaging.Notify(hit.Session.Player, "💥 BONK! Kitchen junk!", "Danger", 1.4)
			end
			services.Messaging.Sound(nil, "Impact", position)
		else
			services.PickupManager.SpawnAt(kind, position + Vector3.new(0, 1, 0), 12)
		end
	end)
end

function RUNNERS.FallingFood()
	local cfg = EVENTS.FallingFood
	services.Messaging.Notify(nil, "🍞 Food is falling from the sky!", "Warning", 2)
	for _ = 1, rng:NextInteger(cfg.CountMin, cfg.CountMax) do
		local roll = rng:NextNumber()
		local kind = if roll < cfg.JunkChance then "Junk" elseif roll < cfg.JunkChance + 0.1 then "GoldenCrumb" else "Crumb"
		dropItem(kind, randomFloorPoint(6))
	end
end

function RUNNERS.FallingButter()
	services.Messaging.Notify(nil, "🧈 BUTTER INCOMING! Look for the shadow!", "Good", 2.5)
	dropItem("Butter", randomFloorPoint(10))
end

function RUNNERS.HotSpot()
	local cfg = EVENTS.HotSpot
	local spot: HotSpot = {
		Position = randomFloorPoint(cfg.Radius),
		Radius = cfg.Radius,
		StartsAt = now() + EVENTS.WarningTime,
		EndsAt = now() + EVENTS.WarningTime + cfg.Duration,
	}
	table.insert(hotSpots, spot)
	services.Messaging.Effect(nil, "HotSpot", spot)
	services.Messaging.Notify(nil, "⚠️ HOT ZONE! Get out of the red circle!", "Danger", 2)
end

function RUNNERS.SteamBurst()
	local cfg = EVENTS.SteamBurst
	local i = info()
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	local position = Vector3.new(rng:NextNumber(-i.HalfLength + 10, i.HalfLength - 10), i.FloorY, side * (i.HalfWidth - cfg.Radius))
	services.Messaging.Effect(nil, "SteamWarning", { Position = position, Radius = cfg.Radius, At = now() + EVENTS.WarningTime })
	later(EVENTS.WarningTime, function()
		services.Messaging.Effect(nil, "Steam", { Position = position, Radius = cfg.Radius })
		services.Messaging.Sound(nil, "Steam", position)
		for _, hit in sessionsNear(position, cfg.Radius) do
			services.AbilityManager.Push(hit.Session, Vector3.new(0, cfg.Lift, 0))
			services.HeatManager.AddHeat(hit.Session, cfg.Heat)
			services.Messaging.Notify(hit.Session.Player, "♨️ STEAMED!", "Danger", 1.4)
		end
	end)
end

function RUNNERS.ToasterShake()
	local cfg = EVENTS.ToasterShake
	services.Messaging.Notify(nil, "📳 THE TOASTER IS SHAKING!", "Warning", 2)
	services.Messaging.Effect(nil, "Shake", { Intensity = 0.4, Duration = EVENTS.WarningTime })
	services.Messaging.Sound(nil, "Shake")
	later(EVENTS.WarningTime, function()
		services.Messaging.Effect(nil, "Shake", { Intensity = 1.2, Duration = cfg.Duration })
		for _, session in services.PlayerManager.InRound() do
			local angle = rng:NextNumber(0, math.pi * 2)
			services.AbilityManager.Push(session, Vector3.new(math.cos(angle) * cfg.Shove, 18, math.sin(angle) * cfg.Shove))
		end
	end)
end

local function pickEvent(): string
	local total = 0
	for _, weight in EVENTS.Weights do
		total += weight
	end
	local roll = rng:NextNumber(0, total)
	for name, weight in EVENTS.Weights do
		roll -= weight
		if roll <= 0 then
			return name
		end
	end
	return "FallingFood"
end

------------------------------------------------------------------ fork boss

local function zap(position: Vector3)
	services.Messaging.Effect(nil, "ForkZap", { Position = position, Radius = FORK.ZapRadius })
	services.Messaging.Sound(nil, "ForkZap", position)
	for _, hit in sessionsNear(position, FORK.ZapRadius) do
		services.HeatManager.AddHeat(hit.Session, FORK.ZapHeat)
		services.AbilityManager.Push(hit.Session, pushAway(position, hit.Root, FORK.ZapKnockback, 40))
		services.Messaging.Notify(hit.Session.Player, "⚡ ZAPPED BY THE FORK!", "Electric", 1.6)
	end
end

local function startFork()
	local startAt = now() + FORK.WarningDuration
	local endAt = startAt + FORK.Duration
	local center = info().ToasterCenter
	services.RoundManager.SetRoundAttribute(Constants.RoundAttr.ForkActive, true)
	services.Messaging.Notify(nil, "⚠️ WARNING\nTHE FORK IS HERE!", "Electric", 3)
	services.Messaging.Sound(nil, "ForkWarning")
	services.Messaging.Effect(nil, "Fork", {
		StartAt = startAt,
		EndAt = endAt,
		Center = center,
		PathRadiusX = FORK.PathRadiusX,
		PathRadiusZ = FORK.PathRadiusZ,
		LapTime = FORK.LapTime,
	})

	later(FORK.WarningDuration, function()
		services.Messaging.Notify(nil, "⚡ ELECTRICAL EVENT ACTIVE", "Electric", 2.5)
	end)

	-- Schedule zaps: each one is announced ZapWarning seconds ahead at the
	-- spot the fork will be when it strikes.
	local zapTime = startAt + FORK.ZapInterval
	while zapTime < endAt do
		local strikeAt = zapTime
		local warnDelay = math.max(0, strikeAt - FORK.ZapWarning - now())
		later(warnDelay, function()
			local ox, oz = ForkPath.Offset(strikeAt - startAt, FORK)
			local position = center + Vector3.new(ox, 0, oz)
			services.Messaging.Effect(nil, "ForkZapWarning", { Position = position, Radius = FORK.ZapRadius, At = strikeAt })
			later(math.max(0, strikeAt - now()), function()
				zap(position)
			end)
		end)
		zapTime += FORK.ZapInterval
	end

	later(endAt - now(), function()
		services.RoundManager.SetRoundAttribute(Constants.RoundAttr.ForkActive, false)
		services.Messaging.Notify(nil, "🍴 The fork has left the toaster.", "Info", 2)
	end)
end

------------------------------------------------------------------ lifecycle

function EventManager.PrepareRound(_roundNumber: number)
	roundsSinceFork += 1
	forkThisRound = FORK.ForceEveryRound
		or (roundsSinceFork >= FORK.MinRoundsBetween and (rng:NextNumber() < FORK.Chance or roundsSinceFork >= FORK.GuaranteeAfter))
	if forkThisRound then
		roundsSinceFork = 0
	end
end

function EventManager.StartHeating()
	heatingToken += 1
	local token = heatingToken
	if forkThisRound then
		later(FORK.StartDelay, startFork)
	end
	task.spawn(function()
		task.wait(EVENTS.FirstEventDelay)
		while token == heatingToken do
			local name = pickEvent()
			local ok, err = pcall(RUNNERS[name])
			if not ok then
				warn("[EventManager] event", name, "failed:", err)
			end
			task.wait(rng:NextNumber(EVENTS.IntervalMin, EVENTS.IntervalMax))
		end
	end)
end

function EventManager.StopHeating()
	heatingToken += 1
	table.clear(hotSpots)
	services.RoundManager.SetRoundAttribute(Constants.RoundAttr.ForkActive, false)
	services.Messaging.Effect(nil, "ClearHazards", {})
end

function EventManager.Cleanup()
	EventManager.StopHeating()
	forkThisRound = false
end

function EventManager.HotSpotMultiplierAt(position: Vector3): number?
	if #hotSpots == 0 then
		return nil
	end
	local t = now()
	local best: number? = nil
	for i = #hotSpots, 1, -1 do
		local spot = hotSpots[i]
		if t >= spot.EndsAt then
			table.remove(hotSpots, i)
		elseif t >= spot.StartsAt then
			local flat = Vector3.new(position.X - spot.Position.X, 0, position.Z - spot.Position.Z)
			if flat.Magnitude <= spot.Radius then
				best = Config.HeatZones.HotSpotMultiplier
			end
		end
	end
	return best
end

return EventManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">HeatManager</string>
          <string name="Source"><![CDATA[-- Server-authoritative heat. A fixed-interval loop (not per-frame) raises
-- every in-round player's heat based on the zone they stand in, butter
-- shields, ability resistance and active hot spots. It also runs the
-- charcoal-touch proximity check and butter shield expiry.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BreadDefinitions = require(Shared.BreadDefinitions)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local HeatMath = require(Shared.HeatMath)

local HeatManager = {}

local ATTR = Constants.Attr
local HEAT = Config.Heat
local services
local heatActive = false
local blackenCooldowns: { [Player]: { [Player]: number } } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

function HeatManager.Init(registry)
	services = registry
end

function HeatManager.SetActive(active: boolean)
	heatActive = active
	services.RoundManager.SetRoundAttribute(Constants.RoundAttr.HeatActive, active)
end

function HeatManager.IsActive(): boolean
	return heatActive
end

local function replicate(session)
	local player = session.Player
	if math.abs(session.Heat - session.LastReplicatedHeat) >= HEAT.ReplicationStep or session.Heat >= HEAT.MaxHeat then
		session.LastReplicatedHeat = session.Heat
		player:SetAttribute(ATTR.Heat, math.floor(session.Heat * 10) / 10)
	end
	local bucket = math.floor(session.Heat / 5)
	if bucket ~= session.LastToastBucket then
		session.LastToastBucket = bucket
		services.PlayerManager.RefreshAppearance(session)
	end
end

local STATE_ORDER = { Normal = 0, Warm = 1, VeryHot = 2, Critical = 3, Burnt = 4 }

local STATE_MESSAGES = {
	Warm = { "♨️ You're getting warm...", "Warning" },
	VeryHot = { "🔥 VERY HOT! Find a cool spot or butter!", "Warning" },
	Critical = { "🚨 CRITICAL HEAT! MOVE!", "Danger" },
}

local function setState(session, state: string)
	if session.HeatState == state then
		return
	end
	local rising = (STATE_ORDER[state] or 0) > (STATE_ORDER[session.HeatState] or 0)
	session.HeatState = state
	session.Player:SetAttribute(ATTR.HeatState, state)
	services.PlayerManager.RefreshAppearance(session)
	local message = STATE_MESSAGES[state]
	if message and rising then
		services.Messaging.Notify(session.Player, message[1], message[2], 2)
		services.Messaging.Sound(session.Player, "HeatWarning")
	end
end

local function applyHeat(session, amount: number)
	if session.IsCharcoal or amount <= 0 then
		return
	end
	session.Heat = HeatMath.Clamp(session.Heat + amount, HEAT)
	local state = HeatMath.GetState(session.Heat, HEAT)
	if state == "Burnt" then
		services.PlayerManager.Burn(session)
		return
	end
	setState(session, state)
	replicate(session)
end

local function shieldMultiplier(session): number?
	if session.ShieldActive then
		return Config.Butter.HeatMultiplier
	end
	return nil
end

-- External heat (steam, fork zaps, charcoal touch). Shields still protect.
function HeatManager.AddHeat(session, amount: number)
	if not session.InRound or not heatActive then
		return
	end
	local mult = shieldMultiplier(session)
	applyHeat(session, amount * (mult or 1))
end

function HeatManager.ActivateShield(session): boolean
	if session.ButterCarried <= 0 or session.ShieldActive or session.IsCharcoal then
		return false
	end
	session.ButterCarried -= 1
	session.ShieldActive = true
	session.UsedButterThisRound = true
	session.ShieldEndsAt = now() + Config.Butter.Duration
	local player = session.Player
	player:SetAttribute(ATTR.ButterCarried, session.ButterCarried)
	player:SetAttribute(ATTR.ShieldEndsAt, session.ShieldEndsAt)
	services.PlayerManager.RefreshAppearance(session)
	local root = services.PlayerManager.GetBody(session)
	services.Messaging.Notify(player, "🧈 BUTTER SHIELD!", "Good", 2)
	services.Messaging.Sound(nil, "ButterShield", root and root.Position or nil)
	return true
end

local function expireShield(session)
	session.ShieldActive = false
	session.ShieldEndsAt = 0
	session.Player:SetAttribute(ATTR.ShieldEndsAt, 0)
	services.PlayerManager.RefreshAppearance(session)
	services.Messaging.Notify(session.Player, "🧈 Your butter melted!", "Warning", 1.8)
	services.Messaging.Sound(session.Player, "ButterExpire")
end

local function charcoalTouch(sessionList, positions, t: number)
	local cfg = Config.Charcoal
	for _, attacker in sessionList do
		local attackerPos = positions[attacker]
		if attacker.IsCharcoal and attackerPos then
			local cooldowns = blackenCooldowns[attacker.Player]
			if not cooldowns then
				cooldowns = {}
				blackenCooldowns[attacker.Player] = cooldowns
			end
			for _, victim in sessionList do
				local victimPos = positions[victim]
				if
					victim ~= attacker
					and not victim.IsCharcoal
					and victimPos
					and (victimPos - attackerPos).Magnitude <= cfg.TouchRadius
				then
					if t >= (cooldowns[victim.Player] or 0) then
						cooldowns[victim.Player] = t + cfg.TouchCooldown
						victim.BlackenedUntil = t + cfg.BlackenDuration
						services.PlayerManager.RefreshAppearance(victim)
						HeatManager.AddHeat(victim, cfg.BlackenHeat)
						services.Messaging.Notify(victim.Player, `🪨 {attacker.Player.DisplayName} blackened you!`, "Danger", 1.8)
						services.Messaging.Sound(nil, "Knock", victimPos)
						services.DataManager.Update(attacker.Player, function(data)
							data.Statistics.PlayersBlackened += 1
						end)
						services.AchievementManager.Evaluate(attacker.Player)
						task.delay(cfg.BlackenDuration + 0.1, function()
							if victim.BlackenedUntil <= workspace:GetServerTimeNow() then
								services.PlayerManager.RefreshAppearance(victim)
							end
						end)
					end
				end
			end
		end
	end
end

local function tick(dt: number)
	local t = now()
	local sessionList = services.PlayerManager.InRound()
	local positions = {}
	local info = services.MapBuilder.Info
	local center = info.ToasterCenter

	for _, session in sessionList do
		local root = services.PlayerManager.GetBody(session)
		if root then
			positions[session] = root.Position
		end
		if session.ShieldActive and t >= session.ShieldEndsAt then
			expireShield(session)
		end
		-- Stuck (jam) wears off here too.
		if session.StuckUntil > 0 and t >= session.StuckUntil then
			session.StuckUntil = 0
			services.PlayerManager.RefreshMovement(session)
			local character = session.Player.Character
			if character then
				character:SetAttribute(Constants.CharAttr.Stuck, false)
			end
		end
	end

	if heatActive then
		for _, session in sessionList do
			local pos = positions[session]
			if pos and not session.IsCharcoal and services.MapBuilder.IsInsideToaster(pos) then
				local zoneName, zoneMult = HeatMath.GetZone(pos.X - center.X, pos.Z - center.Z, Config.Map, Config.HeatZones)
				if zoneName ~= session.HeatZone then
					session.HeatZone = zoneName
					session.Player:SetAttribute(ATTR.HeatZone, zoneName)
				end
				local bread = BreadDefinitions.ById[services.PlayerManager.EquippedBread(session)]
				local delta = HeatMath.ComputeDelta(HEAT.BaseRate, dt, {
					zoneMultiplier = zoneMult,
					breadResistance = bread.HeatResistance,
					shieldMultiplier = shieldMultiplier(session),
					abilityResistance = if t < session.ResistUntil then session.ResistMultiplier else nil,
					hotSpotMultiplier = services.EventManager.HotSpotMultiplierAt(pos),
				})
				applyHeat(session, delta)
			end
		end
	end

	charcoalTouch(sessionList, positions, t)
end

function HeatManager.Start()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(HEAT.TickInterval)
			local current = os.clock()
			local dt = math.min(current - last, HEAT.TickInterval * 4)
			last = current
			local ok, err = pcall(tick, dt)
			if not ok then
				warn("[HeatManager] tick failed:", err)
			end
		end
	end)
end

function HeatManager.ResetRound()
	table.clear(blackenCooldowns)
	HeatManager.SetActive(false)
end

return HeatManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">LaunchManager</string>
          <string name="Source"><![CDATA[-- The POP. A controlled ballistic launch: each player's landing target comes
-- from where they stood (centre = bullseye, POP pad = tight spread), and we
-- solve the exact velocity to reach it. During flight the server owns the
-- character's physics so the landing is authoritative, and launched bread
-- does not collide with the toaster or with each other.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local LandingMath = require(Shared.LandingMath)
local Theme = require(Shared.Theme)

local LaunchManager = {}

local LAUNCH = Config.Launch
local GROUPS = Constants.CollisionGroups
local services
local rng = Random.new()

type Flight = {
	Session: any,
	LaunchedAt: number,
	Target: Vector3,
}

local flights: { [Player]: Flight } = {}
local heartbeat: RBXScriptConnection? = nil

function LaunchManager.Init(registry)
	services = registry
end

local function restoreControl(session)
	local root, humanoid = services.PlayerManager.GetBody(session)
	local character = session.Player.Character
	if character then
		services.PlayerManager.SetCollisionGroup(character, GROUPS.Players)
	end
	if root and humanoid then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		root.AssemblyAngularVelocity = Vector3.zero
		pcall(function()
			root:SetNetworkOwner(session.Player)
		end)
	end
end

local function scoreLanding(session, position: Vector3)
	if session.Landed then
		return
	end
	session.Landed = true
	local info = services.MapBuilder.Info
	local offset = Vector3.new(position.X - info.FieldCenter.X, 0, position.Z - info.FieldCenter.Z)
	local zone = LandingMath.ZoneForDistance(offset.Magnitude, Config.Landing.Zones)
	session.LandingZoneId = zone.Id
	session.LandingZoneName = zone.Name
	session.LandingPoints = zone.Points

	local player = session.Player
	local color = Theme.ZoneColors[zone.Id]
	services.Messaging.FloatingText(nil, position + Vector3.new(0, 6, 0), `{zone.Name}\n+{zone.Points}`, color)
	services.Messaging.Effect(nil, "Landing", { Position = position, Zone = zone.Id })
	services.Messaging.Effect(player, "Shake", { Intensity = 0.8, Duration = 0.4 })
	if zone.Id == "Jackpot" then
		services.Messaging.Notify(nil, `💰 {player.DisplayName} HIT THE JACKPOT!`, "Legend", 3)
	elseif zone.Id == "Perfect" then
		services.Messaging.Notify(player, "🏆 PERFECT LANDING!", "Legend", 2.5)
	else
		services.Messaging.Notify(player, `🎯 {zone.Name}! +{zone.Points}`, "Good", 2)
	end
end

local function finishFlight(player: Player, landedAt: Vector3)
	local flight = flights[player]
	if not flight then
		return
	end
	flights[player] = nil
	scoreLanding(flight.Session, landedAt)
	task.delay(0.7, function()
		if player.Parent == Players then
			restoreControl(flight.Session)
		end
	end)
end

local function stepFlights()
	local t = os.clock()
	local groundY = services.MapBuilder.Info.FieldGroundY
	for player, flight in flights do
		local root = services.PlayerManager.GetBody(flight.Session)
		if not root or player.Parent ~= Players then
			flights[player] = nil
		else
			local airTime = t - flight.LaunchedAt
			local pos = root.Position
			if airTime > LAUNCH.MinAirTime and pos.Y <= groundY + LAUNCH.GroundedHeight and root.AssemblyLinearVelocity.Y <= 1 then
				finishFlight(player, pos)
			elseif airTime > LAUNCH.FlightTime + LAUNCH.LandingTimeout or pos.Y < groundY - 30 then
				-- Physics fallback: put them on their intended target.
				root.AssemblyLinearVelocity = Vector3.zero
				local character = player.Character
				if character then
					character:PivotTo(CFrame.new(flight.Target + Vector3.new(0, 3, 0)))
				end
				finishFlight(player, flight.Target)
			end
		end
	end
	if next(flights) == nil and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

function LaunchManager.LaunchAll()
	local info = services.MapBuilder.Info
	local gravity = workspace.Gravity
	local center = info.ToasterCenter
	local bullseye = info.FieldCenter

	for _, session in services.PlayerManager.InRound() do
		local root, humanoid = services.PlayerManager.GetBody(session)
		local character = session.Player.Character
		if root and humanoid and character then
			-- Survival is decided at the moment of the POP.
			session.Survived = not session.IsCharcoal
			if session.Survived then
				session.Golden = true
				character:SetAttribute(Constants.CharAttr.Golden, true)
				services.PlayerManager.RefreshAppearance(session)
				services.Messaging.Notify(session.Player, `✨ SURVIVED! +{Config.Rewards.SurvivalBonus} BONUS`, "Legend", 3)
				services.Messaging.Sound(nil, "Golden", root.Position)
			end

			if not services.MapBuilder.IsInsideToaster(root.Position) then
				services.PlayerManager.TeleportToToaster(session)
			end
			local localPos = root.Position - center
			local ox, oz = LandingMath.TargetOffset(localPos.X, localPos.Z, LAUNCH, rng:NextNumber(), rng:NextNumber())
			local target = Vector3.new(bullseye.X + ox, info.FieldGroundY + 3, bullseye.Z + oz)
			local start = root.Position
			local vx, vy, vz =
				LandingMath.SolveVelocity(start.X, start.Y, start.Z, target.X, target.Y, target.Z, LAUNCH.FlightTime, gravity)

			session.StuckUntil = 0
			character:SetAttribute(Constants.CharAttr.Stuck, false)
			character:SetAttribute(Constants.CharAttr.Rolling, false)
			services.PlayerManager.SetCollisionGroup(character, GROUPS.Launched)
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
			humanoid.PlatformStand = true
			root.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
			root.AssemblyAngularVelocity = Vector3.new(
				rng:NextNumber(-LAUNCH.SpinMax, LAUNCH.SpinMax),
				rng:NextNumber(-LAUNCH.SpinMax, LAUNCH.SpinMax),
				rng:NextNumber(-LAUNCH.SpinMax, LAUNCH.SpinMax)
			)
			flights[session.Player] = { Session = session, LaunchedAt = os.clock(), Target = target }
			services.Messaging.Round(session.Player, "Launched", { FlightTime = LAUNCH.FlightTime })
		end
	end

	services.Messaging.Sound(nil, "Launch", center + Vector3.new(0, 40, 0))
	services.Messaging.Effect(nil, "Pop", { Position = center + Vector3.new(0, Config.Map.WallHeight, 0) })
	if not heartbeat and next(flights) ~= nil then
		heartbeat = RunService.Heartbeat:Connect(stepFlights)
	end
end

function LaunchManager.AllLanded(): boolean
	return next(flights) == nil
end

-- Anyone still airborne (or who reset during landing) lands where they are,
-- or at their target as a safe fallback.
function LaunchManager.FallbackLand(session)
	local player = session.Player
	local flight = flights[player]
	local root = services.PlayerManager.GetBody(session)
	local info = services.MapBuilder.Info
	local spot = if flight then flight.Target else info.FieldCenter + Vector3.new(rng:NextNumber(-60, 60), 3, rng:NextNumber(-60, 60))
	if root and player.Character then
		root.AssemblyLinearVelocity = Vector3.zero
		player.Character:PivotTo(CFrame.new(spot + Vector3.new(0, 3, 0)))
	end
	if flight then
		finishFlight(player, spot)
	elseif not session.Landed then
		scoreLanding(session, spot)
		restoreControl(session)
	end
end

function LaunchManager.FinalizeAll()
	for _, session in services.PlayerManager.InRound() do
		if not session.Landed then
			LaunchManager.FallbackLand(session)
		end
	end
end

function LaunchManager.Reset()
	for _, flight in flights do
		restoreControl(flight.Session)
	end
	table.clear(flights)
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

return LaunchManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds the whole world from primitive parts at server start: the kitchen
-- counter, the giant toaster (coils, lever, POP pad, heat zones, secret crack),
-- the lobby plate, the landing target, the giant hand, the fork and Crumb World.
-- Everything is generated so the place file needs no hand-made models; tweak
-- dimensions in Config.Map.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Theme = require(Shared.Theme)

local MapBuilder = {}

local MAP = Config.Map
local GROUPS = Constants.CollisionGroups
local C = Theme.Colors

export type MapInfo = {
	ToasterCenter: Vector3,
	FloorY: number,
	HalfLength: number,
	HalfWidth: number,
	ToasterSpawns: { Vector3 },
	CrumbArea: { minX: number, maxX: number, minZ: number, maxZ: number },
	ButterSpots: { Vector3 },
	LobbyCenter: Vector3,
	LobbySpawnRadius: number,
	FieldCenter: Vector3,
	FieldGroundY: number,
	LeverKnob: BasePart,
	KnobUpY: number,
	KnobDownY: number,
	Hand: Model,
	Fork: Model,
	SecretSensor: BasePart,
	CrumbWorld: {
		Entry: Vector3,
		Floor: number,
		ReturnPad: BasePart,
		NpcPrompt: ProximityPrompt,
		NpcHead: BasePart,
		VintageCrumbs: { BasePart },
		Bounds: { minY: number, maxY: number },
	},
	Folders: { [string]: Folder },
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	Reflectance: number?,
	CanCollide: boolean?,
	CanQuery: boolean?,
	CanTouch: boolean?,
	CastShadow: boolean?,
	Group: string?,
	Wedge: boolean?,
}

local function part(parent: Instance, props: PartProps): BasePart
	local p: BasePart
	if props.Wedge then
		p = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		block.Shape = props.Shape or Enum.PartType.Block
		p = block
	end
	p.Name = props.Name or "Part"
	p.Anchored = true
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or C.Chrome
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	p.Reflectance = props.Reflectance or 0
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.CanQuery = if props.CanQuery == nil then true else props.CanQuery
	p.CanTouch = if props.CanTouch == nil then false else props.CanTouch
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Group then
		p.CollisionGroup = props.Group
	end
	p.Parent = parent
	return p
end

local UP_AXIS = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis along Y
local Z_AXIS = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis along Z

local function disc(
	parent: Instance,
	name: string,
	center: Vector3,
	radius: number,
	thickness: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part(parent, {
		Name = name,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * UP_AXIS,
		Shape = Enum.PartType.Cylinder,
		Color = color,
		Material = material,
	})
end

-- A SurfaceGui label on one face of a part.
local function label(target: BasePart, face: Enum.NormalId, text: string, color: Color3?, pixelsPerStud: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 0.2
	local text_ = Instance.new("TextLabel")
	text_.BackgroundTransparency = 1
	text_.Size = UDim2.fromScale(1, 1)
	text_.Font = Theme.Fonts.Display
	text_.TextScaled = true
	text_.TextColor3 = color or C.Cream
	text_.Text = text
	text_.Parent = gui
	gui.Parent = target
end

local function billboard(parent: BasePart, text: string, color: Color3, size: UDim2, offset: Vector3?, maxDistance: number?)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset or Vector3.zero
	gui.MaxDistance = maxDistance or 400
	gui.LightInfluence = 0
	local text_ = Instance.new("TextLabel")
	text_.BackgroundTransparency = 1
	text_.Size = UDim2.fromScale(1, 1)
	text_.Font = Theme.Fonts.Display
	text_.TextScaled = true
	text_.TextColor3 = color
	text_.TextStrokeTransparency = 0.3
	text_.Text = text
	text_.Parent = gui
	gui.Parent = parent
end

local function folder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(90, 80, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 135, 120)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
end

local function buildKitchen(world: Folder)
	part(world, {
		Name = "Counter",
		Size = Vector3.new(1600, 20, 1000),
		CFrame = CFrame.new(0, -10, 0),
		Color = C.Counter,
		Material = Enum.Material.WoodPlanks,
	})
	part(world, {
		Name = "Backsplash",
		Size = Vector3.new(1600, 320, 8),
		CFrame = CFrame.new(0, 160, -504),
		Color = C.Tile,
		Material = Enum.Material.Marble,
	})
	-- Giant props for scale.
	local jar = disc(world, "JamJar", Vector3.new(180, 45, -260), 30, 90, C.Jam, Enum.Material.Glass)
	jar.Transparency = 0.15
	disc(world, "JamLid", Vector3.new(180, 93, -260), 31, 8, C.Cream)
	disc(world, "Mug", Vector3.new(-120, 40, -300), 34, 80, Color3.fromRGB(88, 150, 230))
	part(world, {
		Name = "ButterDish",
		Size = Vector3.new(90, 14, 60),
		CFrame = CFrame.new(-120, 7, 260),
		Color = C.Cream,
	})
	part(world, {
		Name = "GiantButter",
		Size = Vector3.new(70, 22, 40),
		CFrame = CFrame.new(-120, 25, 260),
		Color = C.Butter,
	})
end

local function buildLobby(folders: { [string]: Folder }): (Vector3, number)
	local lobby = folders.Lobby
	local center = Vector3.new(MAP.LobbyCenterX, 0, 0)
	disc(lobby, "Plate", center + Vector3.new(0, 1, 0), MAP.LobbyRadius, 2, C.Cream, Enum.Material.Marble)
	disc(lobby, "PlateRim", center + Vector3.new(0, 0.8, 0), MAP.LobbyRadius + 6, 1.6, Color3.fromRGB(88, 150, 230))

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, 2.5, 0))
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = C.Gold
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Transparency = 0.2
	spawn.Parent = lobby

	local sign = part(lobby, {
		Name = "LobbySign",
		Size = Vector3.new(60, 20, 2),
		CFrame = CFrame.new(center + Vector3.new(0, 26, -MAP.LobbyRadius + 4)),
		Color = C.Charcoal,
	})
	label(sign, Enum.NormalId.Back, "TOASTER 🍞", C.Orange)
	label(sign, Enum.NormalId.Front, "TOASTER 🍞", C.Orange)
	part(lobby, {
		Name = "SignPost",
		Size = Vector3.new(3, 18, 3),
		CFrame = CFrame.new(center + Vector3.new(0, 9, -MAP.LobbyRadius + 4)),
		Color = C.CharcoalSoft,
	})
	local tip = part(lobby, {
		Name = "TipSign",
		Size = Vector3.new(36, 8, 1),
		CFrame = CFrame.new(center + Vector3.new(MAP.LobbyRadius - 12, 6, 0)) * CFrame.Angles(0, math.rad(-90), 0),
		Color = C.Panel,
	})
	label(tip, Enum.NormalId.Front, "Stand near the CENTRE at POP for the best landing!", C.Cream)
	label(tip, Enum.NormalId.Back, "Stand near the CENTRE at POP for the best landing!", C.Cream)
	return center + Vector3.new(0, 5, 0), MAP.LobbyRadius - 15
end

local function buildToaster(folders: { [string]: Folder }): any
	local toaster = folders.Toaster
	local L, W, H, T = MAP.InteriorLength, MAP.InteriorWidth, MAP.WallHeight, MAP.WallThickness
	local floorY = MAP.FloorY
	local halfL, halfW = L / 2, W / 2
	local outerL, outerW = halfL + T, halfW + T
	local topY = floorY + H
	local midY = floorY + H / 2

	local function chrome(name: string, size: Vector3, cf: CFrame, color: Color3?): BasePart
		return part(toaster, {
			Name = name,
			Size = size,
			CFrame = cf,
			Color = color or C.Chrome,
			Material = Enum.Material.Metal,
			Reflectance = 0.12,
			Group = GROUPS.Toaster,
		})
	end

	-- Feet + floor
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			part(toaster, {
				Name = "Foot",
				Size = Vector3.new(14, 2, 14),
				CFrame = CFrame.new(sx * (outerL - 10), 1, sz * (outerW - 10)),
				Color = C.Charcoal,
				Group = GROUPS.Toaster,
			})
		end
	end
	chrome("Base", Vector3.new(outerL * 2, floorY - 2, outerW * 2), CFrame.new(0, (floorY + 2) / 2, 0), C.ChromeDark)
	part(toaster, {
		Name = "InteriorFloor",
		Size = Vector3.new(L, 0.4, W),
		CFrame = CFrame.new(0, floorY - 0.2, 0),
		Color = Color3.fromRGB(72, 60, 52),
		Material = Enum.Material.Slate,
		Group = GROUPS.Toaster,
	})

	-- End walls (cool) and the solid long wall
	chrome("WallWest", Vector3.new(T, H, outerW * 2), CFrame.new(-(halfL + T / 2), midY, 0))
	chrome("WallEast", Vector3.new(T, H, outerW * 2), CFrame.new(halfL + T / 2, midY, 0))
	chrome("WallNorth", Vector3.new(L, H, T), CFrame.new(0, midY, -(halfW + T / 2)))

	-- Long wall with the window (lever side, +Z)
	local windowBottom, windowTop = floorY + 40, topY - 6
	local windowHalf = 40
	local southZ = halfW + T / 2
	chrome("WallSouthLow", Vector3.new(L, windowBottom - floorY, T), CFrame.new(0, (floorY + windowBottom) / 2, southZ))
	chrome("WallSouthTop", Vector3.new(L, topY - windowTop, T), CFrame.new(0, (windowTop + topY) / 2, southZ))
	for _, side in { -1, 1 } do
		local width = halfL - windowHalf
		chrome(
			"WallSouthSide",
			Vector3.new(width, windowTop - windowBottom, T),
			CFrame.new(side * (windowHalf + width / 2), (windowBottom + windowTop) / 2, southZ)
		)
	end
	part(toaster, {
		Name = "Window",
		Size = Vector3.new(windowHalf * 2, windowTop - windowBottom, 1),
		CFrame = CFrame.new(0, (windowBottom + windowTop) / 2, southZ),
		Color = Color3.fromRGB(200, 230, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.6,
		Group = GROUPS.Toaster,
	})

	-- Rim around the slot
	for _, sz in { -1, 1 } do
		chrome("Rim", Vector3.new(outerL * 2, 3, T), CFrame.new(0, topY + 1.5, sz * southZ), C.ChromeDark)
	end
	for _, sx in { -1, 1 } do
		chrome("Rim", Vector3.new(T, 3, outerW * 2), CFrame.new(sx * (halfL + T / 2), topY + 1.5, 0), C.ChromeDark)
	end

	-- Invisible lid: keeps bread inside but lets launched bread through.
	part(toaster, {
		Name = "Ceiling",
		Size = Vector3.new(L, 2, W),
		CFrame = CFrame.new(0, topY + 1, 0),
		Transparency = 1,
		CanQuery = false,
		CastShadow = false,
		Group = GROUPS.ToasterCeiling,
	})

	-- Mica liners and heating coils on both long walls
	for _, sz in { -1, 1 } do
		local wallZ = sz * (halfW - 0.3)
		part(toaster, {
			Name = "Mica",
			Size = Vector3.new(L, windowBottom - floorY - 2, 0.6),
			CFrame = CFrame.new(0, (floorY + windowBottom) / 2, wallZ),
			Color = Color3.fromRGB(60, 48, 40),
			Material = Enum.Material.Slate,
			Group = GROUPS.Toaster,
		})
		for row = 0, 5 do
			local coil = part(toaster, {
				Name = "Coil",
				Size = Vector3.new(L - 12, 1.4, 1.4),
				CFrame = CFrame.new(0, floorY + 4 + row * 6, sz * (halfW - 1.4)),
				Shape = Enum.PartType.Cylinder,
				Color = C.CoilCold,
				CanCollide = false,
				Group = GROUPS.Toaster,
			})
			CollectionService:AddTag(coil, Constants.Tags.Coil)
		end
		for i = -2, 2 do
			part(toaster, {
				Name = "CoilBracket",
				Size = Vector3.new(1, 34, 2.4),
				CFrame = CFrame.new(i * 30, floorY + 19, sz * (halfW - 1.4)),
				Color = C.ChromeDark,
				Group = GROUPS.Toaster,
			})
		end
	end

	-- Heat zone floor markings (purely visual; HeatMath decides the real zones)
	local zones = Config.HeatZones
	for _, sz in { -1, 1 } do
		local strip = part(toaster, {
			Name = "HotZone",
			Size = Vector3.new(L, 0.1, zones.CoilBand),
			CFrame = CFrame.new(0, floorY + 0.05, sz * (halfW - zones.CoilBand / 2)),
			Color = C.HotFloor,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
		})
		label(strip, Enum.NormalId.Top, "HOT ZONE ×2      HOT ZONE ×2      HOT ZONE ×2", Color3.fromRGB(255, 160, 110), 6)
	end
	for _, sx in { -1, 1 } do
		local nook = part(toaster, {
			Name = "CoolSpot",
			Size = Vector3.new(zones.SafeNookDepth, 0.1, zones.SafeNookHalfWidth * 2),
			CFrame = CFrame.new(sx * (halfL - zones.SafeNookDepth / 2), floorY + 0.06, 0),
			Color = C.Safe,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
		})
		label(nook, Enum.NormalId.Top, "COOL\n×0.5", Color3.new(1, 1, 1), 8)
	end
	local pad = disc(toaster, "PopPad", Vector3.new(0, floorY + 0.08, 0), Config.Launch.PadRadius, 0.12, Color3.fromRGB(150, 70, 30))
	pad.CanCollide = false
	pad.CanQuery = false
	CollectionService:AddTag(pad, Constants.Tags.PopPad)
	local padLabel = part(toaster, {
		Name = "PopPadLabel",
		Size = Vector3.new(10, 0.1, 4),
		CFrame = CFrame.new(0, floorY + 0.16, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	label(padLabel, Enum.NormalId.Top, "POP PAD", C.Cream, 10)

	-- Lever on the outside of the window wall
	local leverX = halfL - 18
	local outerZ = halfW + T
	local knobUpY, knobDownY = topY - 8, floorY + 14
	part(toaster, {
		Name = "LeverTrack",
		Size = Vector3.new(3, knobUpY - knobDownY + 8, 1),
		CFrame = CFrame.new(leverX, (knobUpY + knobDownY) / 2, outerZ + 0.5),
		Color = C.Charcoal,
		Group = GROUPS.Toaster,
	})
	local knob = part(toaster, {
		Name = "LeverKnob",
		Size = Vector3.new(12, 5, 14),
		CFrame = CFrame.new(leverX, knobUpY, outerZ + 7),
		Color = C.Charcoal,
		Material = Enum.Material.SmoothPlastic,
		Group = GROUPS.Toaster,
	})
	CollectionService:AddTag(knob, Constants.Tags.LeverKnob)
	knob:SetAttribute("UpY", knobUpY)
	knob:SetAttribute("DownY", knobDownY)
	local dial = disc(toaster, "Dial", Vector3.new(-leverX, floorY + 22, outerZ + 1), 6, 2, C.Charcoal)
	dial.CFrame = CFrame.new(-leverX, floorY + 22, outerZ + 1) * Z_AXIS
	local brand = part(toaster, {
		Name = "Brand",
		Size = Vector3.new(50, 10, 0.2),
		CFrame = CFrame.new(0, floorY + 18, outerZ + 0.1),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	label(brand, Enum.NormalId.Back, "TOASTMASTER 3000", C.Charcoal)

	-- Secret crack in the floor (Crumb World entrance)
	part(toaster, {
		Name = "SecretCrack",
		Size = Vector3.new(5, 0.12, 1.2),
		CFrame = CFrame.new(-44, floorY + 0.1, 16) * CFrame.Angles(0, math.rad(20), 0),
		Color = Color3.fromRGB(12, 9, 8),
		CanCollide = false,
		CanQuery = false,
	})
	for i = 1, 5 do
		part(toaster, {
			Name = "CrumbHint",
			Size = Vector3.new(0.8, 0.5, 0.7),
			CFrame = CFrame.new(-44 + math.cos(i) * 3.5, floorY + 0.25, 16 + math.sin(i) * 3.5) * CFrame.Angles(0, i, 0),
			Color = C.Crumb,
			CanCollide = false,
			CanQuery = false,
		})
	end
	local sensor = part(toaster, {
		Name = "SecretSensor",
		Size = Vector3.new(5, 3, 2.5),
		CFrame = CFrame.new(-44, floorY + 1.5, 16) * CFrame.Angles(0, math.rad(20), 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = true,
	})

	-- Spawn markers (also used to avoid stacking players)
	local spawns: { Vector3 } = {}
	local step = MAP.SpawnSpacing
	local x = -halfL + 14
	while x <= halfL - 14 do
		local z = -halfW + 15
		while z <= halfW - 15 do
			if math.sqrt(x * x + z * z) > Config.Launch.PadRadius + 2 then
				local pos = Vector3.new(x, floorY + 4, z)
				table.insert(spawns, pos)
				part(folders.SpawnPoints, {
					Name = "ToasterSpawn",
					Size = Vector3.new(1, 1, 1),
					CFrame = CFrame.new(pos),
					Transparency = 1,
					CanCollide = false,
					CanQuery = false,
				})
			end
			z += step
		end
		x += step
	end

	local butterSpots = {
		Vector3.new(-30, floorY + 1.2, -12),
		Vector3.new(30, floorY + 1.2, 12),
		Vector3.new(0, floorY + 1.2, -26),
		Vector3.new(-58, floorY + 1.2, 20),
		Vector3.new(58, floorY + 1.2, -20),
		Vector3.new(12, floorY + 1.2, 27),
	}

	return {
		spawns = spawns,
		butterSpots = butterSpots,
		knob = knob,
		knobUpY = knobUpY,
		knobDownY = knobDownY,
		sensor = sensor,
	}
end

local function buildField(folders: { [string]: Folder }): Vector3
	local zonesFolder = folders.LandingZones
	local center = Vector3.new(MAP.FieldCenterX, 0, 0)
	disc(
		zonesFolder,
		"Board",
		center + Vector3.new(0, 0.1, 0),
		MAP.FieldRadius,
		0.2,
		Color3.fromRGB(176, 128, 82),
		Enum.Material.WoodPlanks
	)
	local zones = Config.Landing.Zones
	for i = #zones, 1, -1 do
		local zone = zones[i]
		if zone.Radius ~= math.huge then
			local ring = disc(
				zonesFolder,
				zone.Id .. "Zone",
				center + Vector3.new(0, 0.25 + (#zones - i) * 0.05, 0),
				zone.Radius,
				0.1,
				Theme.ZoneColors[zone.Id],
				if zone.Id == "Jackpot" then Enum.Material.Neon else Enum.Material.SmoothPlastic
			)
			ring.CanCollide = false
			local marker = part(zonesFolder, {
				Name = zone.Id .. "Label",
				Size = Vector3.new(1, 1, 1),
				CFrame = CFrame.new(center + Vector3.new(-zone.Radius + 2, 3, 0)),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
			})
			billboard(marker, `{zone.Name}\n{zone.Points}`, Theme.ZoneColors[zone.Id], UDim2.fromOffset(160, 56))
		end
	end
	local sign = part(zonesFolder, {
		Name = "FieldSign",
		Size = Vector3.new(70, 18, 2),
		CFrame = CFrame.new(center + Vector3.new(MAP.FieldRadius + 10, 22, 0)) * CFrame.Angles(0, math.rad(90), 0),
		Color = C.Charcoal,
	})
	label(sign, Enum.NormalId.Front, "LANDING ZONE 🎯", C.Gold)
	label(sign, Enum.NormalId.Back, "LANDING ZONE 🎯", C.Gold)
	return center
end

-- Two enormous fingers and a bit of palm. Pivot = fingertips. Clients animate it.
local function buildHand(folders: { [string]: Folder }): Model
	local hand = Instance.new("Model")
	hand.Name = "GiantHand"
	local pivot = CFrame.new(0, 2000, 0) -- parked far above the world until needed

	local function handPart(name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?): BasePart
		local p = part(hand, {
			Name = name,
			Size = size,
			CFrame = pivot * offset,
			Color = color,
			Shape = shape,
			CanCollide = false,
			CanQuery = false,
			CastShadow = true,
		})
		CollectionService:AddTag(p, Constants.Tags.HandPart)
		return p
	end

	for i, fx in { -6.5, 6.5 } do
		local lift = if i == 2 then 2 else 0
		handPart("Finger", Vector3.new(44, 11, 11), CFrame.new(fx, 22 + lift, 0) * UP_AXIS, C.Skin, Enum.PartType.Cylinder)
		handPart("Fingertip", Vector3.new(11, 11, 11), CFrame.new(fx, 0.5 + lift, 0), C.Skin, Enum.PartType.Ball)
		handPart("Nail", Vector3.new(7, 9, 1), CFrame.new(fx, 3 + lift, -5.3), C.SkinNail)
		handPart("Knuckle", Vector3.new(8, 0.6, 1), CFrame.new(fx, 26 + lift, -5.4), Color3.fromRGB(184, 122, 82))
		handPart("Knuckle", Vector3.new(8, 0.6, 1), CFrame.new(fx, 28 + lift, -5.4), Color3.fromRGB(184, 122, 82))
	end
	handPart("Palm", Vector3.new(36, 26, 22), CFrame.new(0, 54, 4), C.Skin)
	handPart("PalmEdge", Vector3.new(22, 30, 20), CFrame.new(-14, 60, 8) * CFrame.Angles(0, 0, math.rad(12)), C.Skin)
	local primary = handPart("Pivot", Vector3.new(1, 1, 1), CFrame.new(), C.Skin)
	primary.Transparency = 1
	hand.PrimaryPart = primary
	hand.Parent = folders.EventObjects
	return hand
end

-- The boss fork. Pivot = tine tips. Clients animate it on a shared clock.
local function buildFork(folders: { [string]: Folder }): Model
	local fork = Instance.new("Model")
	fork.Name = "GiantFork"
	local pivot = CFrame.new(0, 2200, 0)
	local metal = Color3.fromRGB(210, 216, 222)
	local function forkPart(name: string, size: Vector3, offset: CFrame, shape: Enum.PartType?): BasePart
		return part(fork, {
			Name = name,
			Size = size,
			CFrame = pivot * offset,
			Color = metal,
			Material = Enum.Material.Metal,
			Reflectance = 0.3,
			Shape = shape,
			CanCollide = false,
			CanQuery = false,
		})
	end
	for i = -1.5, 1.5 do
		forkPart("Tine", Vector3.new(26, 2.2, 2.2), CFrame.new(i * 3.2, 13, 0) * UP_AXIS, Enum.PartType.Cylinder)
	end
	forkPart("Head", Vector3.new(14, 8, 2.6), CFrame.new(0, 29, 0))
	forkPart("Neck", Vector3.new(6, 10, 2.4), CFrame.new(0, 37, 0))
	forkPart("Handle", Vector3.new(70, 5, 5), CFrame.new(0, 76, 0) * UP_AXIS, Enum.PartType.Cylinder)
	local glow = forkPart("Arc", Vector3.new(16, 30, 4), CFrame.new(0, 14, 0))
	glow.Color = Theme.Colors.Electric
	glow.Material = Enum.Material.ForceField
	glow.Reflectance = 0
	local light = Instance.new("PointLight")
	light.Color = Theme.Colors.Electric
	light.Range = 30
	light.Brightness = 4
	light.Parent = glow
	local primary = forkPart("Pivot", Vector3.new(1, 1, 1), CFrame.new())
	primary.Transparency = 1
	fork.PrimaryPart = primary
	fork.Parent = folders.EventObjects
	return fork
end

local function buildCrumbWorld(folders: { [string]: Folder }): any
	local area = folders.SecretArea
	local floorY = MAP.CrumbWorldY
	local halfX, halfZ, height = 80, 50, 60
	local base = Vector3.new(0, floorY, 0)
	local wallColor = Color3.fromRGB(60, 42, 30)

	part(area, {
		Name = "Floor",
		Size = Vector3.new(halfX * 2, 4, halfZ * 2),
		CFrame = CFrame.new(base - Vector3.new(0, 2, 0)),
		Color = Color3.fromRGB(110, 76, 46),
		Material = Enum.Material.Sand,
	})
	part(area, {
		Name = "Ceiling",
		Size = Vector3.new(halfX * 2, 4, halfZ * 2),
		CFrame = CFrame.new(base + Vector3.new(0, height + 2, 0)),
		Color = wallColor,
		Material = Enum.Material.Slate,
	})
	for _, sx in { -1, 1 } do
		part(area, {
			Name = "Wall",
			Size = Vector3.new(4, height, halfZ * 2),
			CFrame = CFrame.new(base + Vector3.new(sx * (halfX + 2), height / 2, 0)),
			Color = wallColor,
			Material = Enum.Material.Slate,
		})
	end
	for _, sz in { -1, 1 } do
		part(area, {
			Name = "Wall",
			Size = Vector3.new(halfX * 2, height, 4),
			CFrame = CFrame.new(base + Vector3.new(0, height / 2, sz * (halfZ + 2))),
			Color = wallColor,
			Material = Enum.Material.Slate,
		})
	end

	-- Warm lamps
	for _, x in { -50, 0, 50 } do
		local lamp = part(area, {
			Name = "Lamp",
			Size = Vector3.new(3, 3, 3),
			CFrame = CFrame.new(base + Vector3.new(x, height - 4, 0)),
			Shape = Enum.PartType.Ball,
			Color = C.Gold,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		local light = Instance.new("PointLight")
		light.Range = 60
		light.Brightness = 2
		light.Color = Color3.fromRGB(255, 200, 140)
		light.Parent = lamp
	end

	-- Crumb piles (deterministic so every server looks the same)
	local rng = Random.new(1987)
	for _ = 1, 70 do
		local size = rng:NextNumber(0.8, 2.6)
		part(area, {
			Name = "Crumb",
			Size = Vector3.new(size, size * 0.7, size * 0.9),
			CFrame = CFrame.new(
				base + Vector3.new(rng:NextNumber(-halfX + 4, halfX - 4), size * 0.3, rng:NextNumber(-halfZ + 4, halfZ - 4))
			) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0),
			Color = if rng:NextNumber() > 0.5 then C.Crumb else C.Crust,
			CanCollide = false,
		})
	end

	-- Tiny buildings
	local buildings = {
		{ x = -55, z = -30, name = "CRUMB BANK", color = Color3.fromRGB(200, 150, 90) },
		{ x = -20, z = -34, name = "TOAST MUSEUM\nEST. 1987", color = Color3.fromRGB(170, 110, 70) },
		{ x = 25, z = -32, name = "BUTTER INN", color = C.Butter },
		{ x = 66, z = -28, name = "LOST & FOUND", color = Color3.fromRGB(150, 120, 100) },
	}
	for _, b in buildings do
		part(area, {
			Name = "House",
			Size = Vector3.new(16, 12, 12),
			CFrame = CFrame.new(base + Vector3.new(b.x, 6, b.z)),
			Color = b.color,
			Material = Enum.Material.Brick,
		})
		for _, side in { -1, 1 } do
			part(area, {
				Name = "Roof",
				Size = Vector3.new(16, 5, 6),
				CFrame = CFrame.new(base + Vector3.new(b.x, 14.5, b.z + side * 3))
					* CFrame.Angles(0, if side == 1 then math.rad(180) else 0, 0),
				Color = C.Crust,
				Wedge = true,
			})
		end
		part(area, {
			Name = "Door",
			Size = Vector3.new(4, 6, 0.4),
			CFrame = CFrame.new(base + Vector3.new(b.x, 3, b.z + 6.1)),
			Color = C.Charcoal,
		})
		local sign = part(area, {
			Name = "HouseSign",
			Size = Vector3.new(12, 3.5, 0.4),
			CFrame = CFrame.new(base + Vector3.new(b.x, 9.5, b.z + 6.2)),
			Color = C.Panel,
		})
		label(sign, Enum.NormalId.Back, b.name, C.Cream)
	end

	-- Sugar-cube steps up to the Butter Inn roof (a vintage crumb hides up there).
	for i, stepHeight in { 4, 8, 12 } do
		local cube = part(area, {
			Name = "SugarCube",
			Size = Vector3.new(6, stepHeight, 6),
			CFrame = CFrame.new(base + Vector3.new(36 + (3 - i) * 6, stepHeight / 2, -32)),
			Color = Color3.fromRGB(250, 248, 240),
			Material = Enum.Material.Sand,
		})
		if i == 1 then
			label(cube, Enum.NormalId.Front, "SUGAR", Theme.Colors.CreamMuted)
		end
	end

	local function signPost(text: string, pos: Vector3, yaw: number)
		local board = part(area, {
			Name = "Sign",
			Size = Vector3.new(16, 6, 0.6),
			CFrame = CFrame.new(base + pos + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
			Color = Color3.fromRGB(107, 58, 30),
			Material = Enum.Material.Wood,
		})
		label(board, Enum.NormalId.Front, text, Color3.fromRGB(242, 201, 135))
		label(board, Enum.NormalId.Back, text, Color3.fromRGB(242, 201, 135))
		part(area, {
			Name = "Post",
			Size = Vector3.new(1, 6, 1),
			CFrame = CFrame.new(base + pos + Vector3.new(0, 3, 0)),
			Color = Color3.fromRGB(74, 40, 20),
		})
	end
	signPost("WELCOME TO CRUMB WORLD\nPOPULATION: CRUMBS", Vector3.new(-62, 0, 10), 90)
	signPost("PLEASE DO NOT\nTOAST THE LOCALS", Vector3.new(10, 0, 30), 180)
	signPost("NO BREAD BEYOND\nTHIS POINT (JK)", Vector3.new(60, 0, 20), -90)

	-- Old Crumb
	local npc = Instance.new("Model")
	npc.Name = "OldCrumb"
	local npcBase = base + Vector3.new(0, 0, -8)
	local crumbBody = part(npc, {
		Name = "Body",
		Size = Vector3.new(5, 4.5, 4),
		CFrame = CFrame.new(npcBase + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0.15, 0.3, 0.1),
		Color = Color3.fromRGB(196, 138, 72),
		Material = Enum.Material.Sand,
	})
	part(npc, {
		Name = "Chunk",
		Size = Vector3.new(3.5, 3, 3.5),
		CFrame = CFrame.new(npcBase + Vector3.new(1.2, 4.2, 0.3)) * CFrame.Angles(0.4, 0.8, 0.2),
		Color = Color3.fromRGB(184, 128, 64),
		Material = Enum.Material.Sand,
	})
	for _, side in { -1, 1 } do
		part(npc, {
			Name = "Lens",
			Size = Vector3.new(0.3, 1.6, 1.6),
			CFrame = CFrame.new(npcBase + Vector3.new(side * 1, 3.6, 2.3)) * Z_AXIS,
			Shape = Enum.PartType.Cylinder,
			Color = Color3.fromRGB(20, 20, 20),
			Material = Enum.Material.Glass,
			Transparency = 0.3,
			CanCollide = false,
		})
	end
	part(npc, {
		Name = "Mustache",
		Size = Vector3.new(3.4, 0.7, 0.6),
		CFrame = CFrame.new(npcBase + Vector3.new(0, 2.5, 2.25)),
		Color = C.Cream,
		CanCollide = false,
	})
	part(npc, {
		Name = "Cane",
		Size = Vector3.new(0.4, 5, 0.4),
		CFrame = CFrame.new(npcBase + Vector3.new(3.2, 2.5, 1)),
		Color = Color3.fromRGB(107, 58, 30),
		CanCollide = false,
	})
	billboard(crumbBody, "OLD CRUMB\n(since 1987)", C.Gold, UDim2.fromOffset(180, 50), Vector3.new(0, 5, 0), 80)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Talk"
	prompt.ObjectText = "Old Crumb"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = crumbBody
	npc.PrimaryPart = crumbBody
	npc.Parent = area

	-- Three vintage crumbs hidden around the world
	local vintage: { BasePart } = {}
	local spots = {
		Vector3.new(-55, 1.2, -42), -- behind the bank
		Vector3.new(25, 17.5, -32), -- on the inn roof
		Vector3.new(74, 1.2, 44), -- far corner
	}
	for i, pos in spots do
		local crumb = part(area, {
			Name = "VintageCrumb" .. i,
			Size = Vector3.new(1.6, 1.2, 1.4),
			CFrame = CFrame.new(base + pos) * CFrame.Angles(0.3, i, 0.2),
			Color = C.Legend,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanTouch = true,
		})
		crumb:SetAttribute("VintageId", "V" .. i)
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = C.Legend
		sparkle.Parent = crumb
		table.insert(vintage, crumb)
	end

	local returnPad = part(area, {
		Name = "ReturnPad",
		Size = Vector3.new(10, 1, 10),
		CFrame = CFrame.new(base + Vector3.new(68, 0.5, 0)),
		Color = C.Orange,
		Material = Enum.Material.Neon,
		CanTouch = true,
	})
	billboard(returnPad, "⬆ BACK TO THE TOASTER", C.Orange, UDim2.fromOffset(220, 40), Vector3.new(0, 5, 0), 120)

	return {
		Entry = base + Vector3.new(-50, 18, 0),
		Floor = floorY,
		ReturnPad = returnPad,
		NpcPrompt = prompt,
		NpcHead = crumbBody,
		VintageCrumbs = vintage,
		Bounds = { minY = floorY - 10, maxY = floorY + height + 10 },
	}
end

local function setupCollisionGroups()
	local PhysicsService = game:GetService("PhysicsService")
	for _, name in GROUPS do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	-- Launched bread flies through the toaster, the lid and each other.
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Launched, GROUPS.Launched, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Launched, GROUPS.Toaster, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Launched, GROUPS.ToasterCeiling, false)
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Launched, GROUPS.Players, false)
	-- The invisible lid only stops players.
	PhysicsService:CollisionGroupSetCollidable(GROUPS.ToasterCeiling, "Default", false)
end

MapBuilder.Info = nil :: MapInfo?

function MapBuilder.Build(): MapInfo
	setupCollisionGroups()
	setupLighting()

	local folders: { [string]: Folder } = {}
	for _, name in { "Lobby", "Toaster", "SpawnPoints", "LandingZones", "SecretArea", "EventObjects", "Kitchen", "Pickups" } do
		folders[name] = folder(workspace, name)
	end

	buildKitchen(folders.Kitchen)
	local lobbyCenter, lobbyRadius = buildLobby(folders)
	local toaster = buildToaster(folders)
	local fieldCenter = buildField(folders)
	local hand = buildHand(folders)
	local fork = buildFork(folders)
	local crumbWorld = buildCrumbWorld(folders)

	local halfL, halfW = MAP.InteriorLength / 2, MAP.InteriorWidth / 2
	local info: MapInfo = {
		ToasterCenter = Vector3.new(0, MAP.FloorY, 0),
		FloorY = MAP.FloorY,
		HalfLength = halfL,
		HalfWidth = halfW,
		ToasterSpawns = toaster.spawns,
		CrumbArea = { minX = -halfL + 4, maxX = halfL - 4, minZ = -halfW + 4, maxZ = halfW - 4 },
		ButterSpots = toaster.butterSpots,
		LobbyCenter = lobbyCenter,
		LobbySpawnRadius = lobbyRadius,
		FieldCenter = fieldCenter,
		FieldGroundY = 0,
		LeverKnob = toaster.knob,
		KnobUpY = toaster.knobUpY,
		KnobDownY = toaster.knobDownY,
		Hand = hand,
		Fork = fork,
		SecretSensor = toaster.sensor,
		CrumbWorld = crumbWorld,
		Folders = folders,
	}
	MapBuilder.Info = info
	return info
end

-- Is a world position inside the toaster's interior volume?
function MapBuilder.IsInsideToaster(position: Vector3): boolean
	local info = MapBuilder.Info
	if not info then
		return false
	end
	return math.abs(position.X) <= info.HalfLength
		and math.abs(position.Z) <= info.HalfWidth
		and position.Y >= info.FloorY - 2
		and position.Y <= info.FloorY + MAP.WallHeight + 4
end

function MapBuilder.IsInCrumbWorld(position: Vector3): boolean
	local info = MapBuilder.Info
	if not info then
		return false
	end
	local bounds = info.CrumbWorld.Bounds
	return position.Y >= bounds.minY and position.Y <= bounds.maxY
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Messaging</string>
          <string name="Source"><![CDATA[-- Thin server-side wrappers around the remotes so every manager sends UI and
-- effect messages the same way.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)

local Messaging = {}

export type NotifyStyle = "Info" | "Good" | "Warning" | "Danger" | "Legend" | "Electric"

-- target: a Player, a list of Players, or nil for everyone.
local function send(remote: RemoteEvent, target: (Player | { Player })?, ...: any)
	if target == nil then
		remote:FireAllClients(...)
	elseif typeof(target) == "Instance" then
		if (target :: Player).Parent == Players then
			remote:FireClient(target :: Player, ...)
		end
	else
		for _, player in target :: { Player } do
			if player.Parent == Players then
				remote:FireClient(player, ...)
			end
		end
	end
end

function Messaging.Notify(target: (Player | { Player })?, text: string, style: NotifyStyle?, duration: number?)
	send(Net.UIEvent, target, "Notify", { Text = text, Style = style or "Info", Duration = duration or 2.5 })
end

function Messaging.FloatingText(target: (Player | { Player })?, position: Vector3, text: string, color: Color3?)
	send(Net.UIEvent, target, "FloatingText", { Position = position, Text = text, Color = color })
end

function Messaging.Dialogue(target: Player, speaker: string, text: string)
	send(Net.UIEvent, target, "Dialogue", { Speaker = speaker, Text = text })
end

function Messaging.UI(target: (Player | { Player })?, kind: string, payload: any)
	send(Net.UIEvent, target, kind, payload)
end

function Messaging.Effect(target: (Player | { Player })?, kind: string, payload: any)
	send(Net.EffectEvent, target, kind, payload)
end

function Messaging.Round(target: (Player | { Player })?, kind: string, payload: any)
	send(Net.RoundEvent, target, kind, payload)
end

function Messaging.Sound(target: (Player | { Player })?, key: string, position: Vector3?)
	send(Net.EffectEvent, target, "Sound", { Key = key, Position = position })
end

return Messaging
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">PickupManager</string>
          <string name="Source"><![CDATA[-- Crumbs and Butter inside the toaster. Pickups are anchored, non-colliding
-- parts; the server listens to Touched and validates proximity, availability
-- and round state before granting anything. Respawning reuses the same part
-- (pooling) instead of destroying and recreating it.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Theme = require(Shared.Theme)

local PickupManager = {}

local ATTR = Constants.Attr
local services
local rng = Random.new()

type Pickup = {
	Id: number,
	Kind: string, -- "Crumb" | "GoldenCrumb" | "Butter"
	Part: BasePart,
	Available: boolean,
	Respawns: boolean,
	SpotIndex: number?,
	Connection: RBXScriptConnection?,
}

local pickups: { [number]: Pickup } = {}
local nextId = 0
local roundToken = 0
local butterSpotsUsed: { [number]: boolean } = {}
local fullWarnings: { [Player]: number } = {}

function PickupManager.Init(registry)
	services = registry
end

local function randomFloorPosition(): Vector3
	local info = services.MapBuilder.Info
	local area = info.CrumbArea
	return Vector3.new(rng:NextNumber(area.minX, area.maxX), info.FloorY + 1, rng:NextNumber(area.minZ, area.maxZ))
end

local function styleAs(pickup: Pickup)
	local p = pickup.Part
	for _, child in p:GetChildren() do
		child:Destroy()
	end
	if pickup.Kind == "Butter" then
		p.Size = Vector3.new(2.6, 1.1, 1.8)
		p.Color = Theme.Colors.Butter
		p.Material = Enum.Material.SmoothPlastic
		local light = Instance.new("PointLight")
		light.Color = Theme.Colors.Butter
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = p
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(60, 30)
		gui.StudsOffset = Vector3.new(0, 2.4, 0)
		gui.MaxDistance = 90
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 1)
		text.Font = Theme.Fonts.Display
		text.TextScaled = true
		text.TextColor3 = Theme.Colors.Butter
		text.TextStrokeTransparency = 0.3
		text.Text = "🧈 BUTTER"
		text.Parent = gui
		gui.Parent = p
	elseif pickup.Kind == "GoldenCrumb" then
		p.Size = Vector3.new(1.6, 1.2, 1.4)
		p.Color = Theme.Colors.Legend
		p.Material = Enum.Material.Neon
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Theme.Colors.Legend
		sparkles.Parent = p
	else
		p.Size = Vector3.new(1.3, 0.9, 1.1)
		p.Color = Theme.Colors.Crumb
		p.Material = Enum.Material.Sand
	end
end

local function setAvailable(pickup: Pickup, available: boolean)
	pickup.Available = available
	pickup.Part.Transparency = if available then 0 else 1
	pickup.Part.CanTouch = available
	for _, child in pickup.Part:GetChildren() do
		if child:IsA("BillboardGui") or child:IsA("Light") then
			(child :: any).Enabled = available
		elseif child:IsA("Sparkles") then
			child.Enabled = available
		end
	end
end

local function chooseButterSpot(): number?
	local info = services.MapBuilder.Info
	local free = {}
	for index in info.ButterSpots do
		if not butterSpotsUsed[index] then
			table.insert(free, index)
		end
	end
	if #free == 0 then
		return nil
	end
	return free[rng:NextInteger(1, #free)]
end

local function place(pickup: Pickup)
	local position
	if pickup.Kind == "Butter" and pickup.Respawns then
		local spot = chooseButterSpot()
		if not spot then
			return false
		end
		pickup.SpotIndex = spot
		butterSpotsUsed[spot] = true
		position = services.MapBuilder.Info.ButterSpots[spot]
	else
		if pickup.Respawns then
			pickup.Kind = if rng:NextNumber() < Config.Crumbs.GoldenChance then "GoldenCrumb" else "Crumb"
			styleAs(pickup)
		end
		position = randomFloorPosition()
	end
	pickup.Part.CFrame = CFrame.new(position) * CFrame.Angles(rng:NextNumber(0, 0.5), rng:NextNumber(0, 6.28), 0)
	setAvailable(pickup, true)
	return true
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function grant(session, pickup: Pickup): boolean
	local player = session.Player
	local position = pickup.Part.Position
	if pickup.Kind == "Butter" then
		if session.IsCharcoal then
			return false
		end
		if session.ButterCarried >= Config.Butter.MaxCarried then
			local t = os.clock()
			if t - (fullWarnings[player] or 0) > 3 then
				fullWarnings[player] = t
				services.Messaging.Notify(player, "🧈 You can only carry one butter. Use it first!", "Info", 2)
			end
			return false
		end
		session.ButterCarried += 1
		player:SetAttribute(ATTR.ButterCarried, session.ButterCarried)
		services.Messaging.Notify(player, "🧈 Butter collected! Use it when the heat is on.", "Good", 2.5)
		services.Messaging.Sound(nil, "ButterPickup", position)
	else
		local value = if pickup.Kind == "GoldenCrumb" then Config.Crumbs.GoldenValue else Config.Crumbs.Value
		if not services.CurrencyManager.Add(player, "Crumbs", value, "Pickup") then
			return false
		end
		session.RoundCrumbs += value
		player:SetAttribute(ATTR.RoundCrumbs, session.RoundCrumbs)
		if pickup.Kind == "GoldenCrumb" then
			services.Messaging.FloatingText(player, position, `+{value} 🍞`, Theme.Colors.Legend)
		end
		services.Messaging.Sound(player, if pickup.Kind == "GoldenCrumb" then "GoldenCrumb" else "CrumbPickup")
	end
	services.Messaging.Effect(nil, "Pickup", { Position = position, Kind = pickup.Kind })
	return true
end

local function onTouched(pickup: Pickup, hit: BasePart)
	if not pickup.Available then
		return
	end
	local player = playerFromHit(hit)
	if not player then
		return
	end
	local session = services.PlayerManager.Get(player)
	if not session or not session.InRound then
		return
	end
	local root = services.PlayerManager.GetBody(session)
	if not root or (root.Position - pickup.Part.Position).Magnitude > Config.Crumbs.PickupRadius then
		return -- proximity validation
	end
	if not grant(session, pickup) then
		return
	end
	setAvailable(pickup, false)
	if pickup.Kind == "Butter" and pickup.SpotIndex then
		butterSpotsUsed[pickup.SpotIndex] = false
	end
	if pickup.Respawns then
		local token = roundToken
		local delay = if pickup.Kind == "Butter" then Config.Butter.RespawnTime else Config.Crumbs.RespawnTime
		task.delay(delay, function()
			if token == roundToken and pickups[pickup.Id] then
				place(pickup)
			end
		end)
	else
		pickups[pickup.Id] = nil
		if pickup.Connection then
			pickup.Connection:Disconnect()
		end
		pickup.Part:Destroy()
	end
end

local function create(kind: string, respawns: boolean): Pickup
	nextId += 1
	local p = Instance.new("Part")
	p.Name = kind
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.CollisionGroup = Constants.CollisionGroups.Pickups
	local pickup: Pickup = {
		Id = nextId,
		Kind = kind,
		Part = p,
		Available = false,
		Respawns = respawns,
	}
	styleAs(pickup)
	pickup.Connection = p.Touched:Connect(function(hit)
		onTouched(pickup, hit)
	end)
	CollectionService:AddTag(p, Constants.Tags.Pickup)
	p.Parent = services.MapBuilder.Info.Folders.Pickups
	pickups[nextId] = pickup
	return pickup
end

function PickupManager.SpawnRoundPickups()
	for _ = 1, Config.Crumbs.SpawnCount do
		place(create("Crumb", true))
	end
	for _ = 1, Config.Butter.SpawnCount do
		local pickup = create("Butter", true)
		if not place(pickup) then
			pickup.Part:Destroy()
			pickups[pickup.Id] = nil
		end
	end
end

-- One-off pickup (e.g. dropped by a falling-food event). Despawns after lifetime.
function PickupManager.SpawnAt(kind: string, position: Vector3, lifetime: number?)
	local pickup = create(kind, false)
	pickup.Part.CFrame = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	setAvailable(pickup, true)
	local token = roundToken
	task.delay(lifetime or 15, function()
		if token == roundToken and pickups[pickup.Id] then
			pickups[pickup.Id] = nil
			pickup.Part:Destroy()
		end
	end)
end

function PickupManager.ClearRoundPickups()
	roundToken += 1
	for _, pickup in pickups do
		if pickup.Connection then
			pickup.Connection:Disconnect()
		end
		pickup.Part:Destroy()
	end
	table.clear(pickups)
	table.clear(butterSpotsUsed)
	table.clear(fullWarnings)
end

return PickupManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">PlayerManager</string>
          <string name="Source"><![CDATA[-- Owns per-player session state, character spawning/respawning, bread
-- appearance and movement stats, and teleports between lobby/toaster/field.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BreadDefinitions = require(Shared.BreadDefinitions)
local BreadVisuals = require(Shared.BreadVisuals)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Maid = require(Shared.Maid)
local Theme = require(Shared.Theme)

local PlayerManager = {}

local ATTR = Constants.Attr
local PHASES = Constants.Phases

export type Session = {
	Player: Player,
	Maid: any, -- character-scoped connections
	InRound: boolean,
	Heat: number,
	HeatState: string,
	HeatZone: string,
	LastReplicatedHeat: number,
	LastToastBucket: number,
	IsCharcoal: boolean,
	CharcoalRoundsLeft: number,
	BurntThisRound: boolean,
	ButterCarried: number,
	ShieldEndsAt: number,
	ShieldActive: boolean,
	UsedButterThisRound: boolean,
	ResistUntil: number,
	ResistMultiplier: number,
	BlackenedUntil: number,
	StuckUntil: number,
	RoundCrumbs: number,
	Survived: boolean,
	Golden: boolean,
	Landed: boolean,
	LandingZoneId: string?,
	LandingZoneName: string?,
	LandingPoints: number,
	RewardGranted: boolean,
	Reward: any?,
	Cooldowns: { [string]: number },
}

local sessions: { [Player]: Session } = {}
local services
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function newSession(player: Player): Session
	return {
		Player = player,
		Maid = Maid.new(),
		InRound = false,
		Heat = 0,
		HeatState = "Normal",
		HeatZone = "Center",
		LastReplicatedHeat = -1,
		LastToastBucket = -1,
		IsCharcoal = false,
		CharcoalRoundsLeft = 0,
		BurntThisRound = false,
		ButterCarried = 0,
		ShieldEndsAt = 0,
		ShieldActive = false,
		UsedButterThisRound = false,
		ResistUntil = 0,
		ResistMultiplier = 1,
		BlackenedUntil = 0,
		StuckUntil = 0,
		RoundCrumbs = 0,
		Survived = false,
		Golden = false,
		Landed = false,
		LandingZoneId = nil,
		LandingZoneName = nil,
		LandingPoints = 0,
		RewardGranted = false,
		Reward = nil,
		Cooldowns = {},
	}
end

function PlayerManager.Init(registry)
	services = registry
end

function PlayerManager.Get(player: Player): Session?
	return sessions[player]
end

function PlayerManager.All(): { [Player]: Session }
	return sessions
end

function PlayerManager.InRound(): { Session }
	local list = {}
	for _, session in sessions do
		if session.InRound then
			table.insert(list, session)
		end
	end
	return list
end

function PlayerManager.CountInRound(): number
	local count = 0
	for _, session in sessions do
		if session.InRound then
			count += 1
		end
	end
	return count
end

-- Root + humanoid if the character is alive, else nil.
function PlayerManager.GetBody(session: Session): (BasePart?, Humanoid?)
	local character = session.Player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

function PlayerManager.ReadyPlayers(): { Player }
	local list = {}
	for player, session in sessions do
		if services.DataManager.IsLoaded(player) and PlayerManager.GetBody(session) then
			table.insert(list, player)
		end
	end
	return list
end

function PlayerManager.SetAttr(session: Session, name: string, value: any)
	session.Player:SetAttribute(name, value)
end

function PlayerManager.EquippedBread(session: Session): string
	local data = services.DataManager.Get(session.Player)
	local breadId = data and data.EquippedBread or BreadDefinitions.Default
	if not BreadDefinitions.ById[breadId] then
		breadId = BreadDefinitions.Default
	end
	return breadId
end

function PlayerManager.RefreshMovement(session: Session)
	local _, humanoid = PlayerManager.GetBody(session)
	if not humanoid then
		return
	end
	local def = BreadDefinitions.ById[PlayerManager.EquippedBread(session)]
	humanoid.UseJumpPower = false
	if now() < session.StuckUntil then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	elseif session.IsCharcoal then
		humanoid.WalkSpeed = Config.Charcoal.WalkSpeed
		humanoid.JumpHeight = def.JumpHeight * 0.8
	else
		humanoid.WalkSpeed = def.WalkSpeed
		humanoid.JumpHeight = def.JumpHeight
	end
end

-- Colours, particles and shield bubble from the current session state.
function PlayerManager.RefreshAppearance(session: Session)
	local model = BreadVisuals.Get(session.Player.Character)
	if not model then
		return
	end
	local mode = "Normal"
	local effect = session.HeatState
	if session.IsCharcoal then
		mode, effect = "Charcoal", "Burnt"
	elseif session.Golden then
		mode, effect = "Golden", "Golden"
	elseif now() < session.BlackenedUntil then
		mode = "Blackened"
	end
	BreadVisuals.SetToast(model, session.Heat, mode)
	BreadVisuals.SetEffects(model, effect)
	BreadVisuals.SetShield(model, session.ShieldActive)
end

function PlayerManager.RebuildBread(session: Session)
	local character = session.Player.Character
	if not character then
		return
	end
	local data = services.DataManager.Get(session.Player)
	local breadId = PlayerManager.EquippedBread(session)
	BreadVisuals.Apply(character, breadId, data and data.EquippedCosmetics or nil)
	session.Player:SetAttribute(ATTR.Bread, breadId)
	PlayerManager.RefreshAppearance(session)
	PlayerManager.RefreshMovement(session)
end

function PlayerManager.SetCollisionGroup(character: Model, group: string)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
end

local function placeCharacter(session: Session, position: Vector3)
	local root = PlayerManager.GetBody(session)
	local character = session.Player.Character
	if not root or not character then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
end

function PlayerManager.TeleportToLobby(session: Session)
	local info = services.MapBuilder.Info
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = rng:NextNumber(0, info.LobbySpawnRadius)
	placeCharacter(session, info.LobbyCenter + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
end

-- Picks the toaster spawn farthest from every other player, so nobody stacks.
function PlayerManager.TeleportToToaster(session: Session, spawnPosition: Vector3?)
	local info = services.MapBuilder.Info
	local target = spawnPosition
	if not target then
		local others = {}
		for _, other in sessions do
			if other ~= session then
				local root = PlayerManager.GetBody(other)
				if root then
					table.insert(others, root.Position)
				end
			end
		end
		local best, bestScore = info.ToasterSpawns[1], -1
		for _, candidate in info.ToasterSpawns do
			local nearest = math.huge
			for _, pos in others do
				nearest = math.min(nearest, (pos - candidate).Magnitude)
			end
			local score = nearest + rng:NextNumber(0, 2)
			if score > bestScore then
				best, bestScore = candidate, score
			end
		end
		target = best
	end
	placeCharacter(session, target :: Vector3)
end

function PlayerManager.ResetRoundState(session: Session)
	session.Heat = if session.IsCharcoal then Config.Heat.MaxHeat else 0
	session.HeatState = if session.IsCharcoal then "Burnt" else "Normal"
	session.HeatZone = "Center"
	session.LastReplicatedHeat = -1
	session.LastToastBucket = -1
	session.BurntThisRound = false
	session.ButterCarried = 0
	session.ShieldEndsAt = 0
	session.ShieldActive = false
	session.UsedButterThisRound = false
	session.ResistUntil = 0
	session.BlackenedUntil = 0
	session.StuckUntil = 0
	session.RoundCrumbs = 0
	session.Survived = false
	session.Golden = false
	session.Landed = false
	session.LandingZoneId = nil
	session.LandingZoneName = nil
	session.LandingPoints = 0
	session.RewardGranted = false
	session.Reward = nil
	table.clear(session.Cooldowns)

	local player = session.Player
	player:SetAttribute(ATTR.Heat, session.Heat)
	player:SetAttribute(ATTR.HeatState, session.HeatState)
	player:SetAttribute(ATTR.HeatZone, session.HeatZone)
	player:SetAttribute(ATTR.ButterCarried, 0)
	player:SetAttribute(ATTR.ShieldEndsAt, 0)
	player:SetAttribute(ATTR.RoundCrumbs, 0)
	player:SetAttribute(ATTR.IsCharcoal, session.IsCharcoal)
	for _, key in { "Ability", "Jam", "Nutella" } do
		player:SetAttribute(ATTR.CooldownPrefix .. key, 0)
	end
	local character = player.Character
	if character then
		character:SetAttribute(Constants.CharAttr.Golden, false)
		character:SetAttribute(Constants.CharAttr.Stuck, false)
		character:SetAttribute(Constants.CharAttr.Rolling, false)
	end
end

-- Puts every given player into the round, each on a distinct spawn.
function PlayerManager.BeginRound(players: { Player })
	local spawns = table.clone(services.MapBuilder.Info.ToasterSpawns)
	for i = #spawns, 2, -1 do
		local j = rng:NextInteger(1, i)
		spawns[i], spawns[j] = spawns[j], spawns[i]
	end
	for index, player in players do
		local session = sessions[player]
		if session then
			session.InRound = true
			player:SetAttribute(ATTR.InRound, true)
			PlayerManager.ResetRoundState(session)
			PlayerManager.RebuildBread(session)
			local spawnPos = spawns[((index - 1) % #spawns) + 1]
			if index > #spawns then
				spawnPos += Vector3.new(rng:NextNumber(-2, 2), 2, rng:NextNumber(-2, 2))
			end
			PlayerManager.TeleportToToaster(session, spawnPos)
		end
	end
end

function PlayerManager.EndRound()
	for player, session in sessions do
		if session.InRound then
			if session.IsCharcoal and not session.BurntThisRound then
				session.CharcoalRoundsLeft -= 1
				if session.CharcoalRoundsLeft <= 0 then
					session.IsCharcoal = false
				end
			end
		end
		session.InRound = false
		player:SetAttribute(ATTR.InRound, false)
		PlayerManager.ResetRoundState(session)
		local character = player.Character
		if character then
			PlayerManager.SetCollisionGroup(character, Constants.CollisionGroups.Players)
		end
		local root, humanoid = PlayerManager.GetBody(session)
		if root and humanoid then
			humanoid.PlatformStand = false
			pcall(function()
				root:SetNetworkOwner(player)
			end)
			PlayerManager.RefreshAppearance(session)
			PlayerManager.RefreshMovement(session)
			PlayerManager.TeleportToLobby(session)
		end
	end
end

function PlayerManager.Burn(session: Session)
	if session.IsCharcoal then
		return
	end
	session.IsCharcoal = true
	session.BurntThisRound = true
	session.CharcoalRoundsLeft = Config.Charcoal.ExtraRounds
	session.Heat = Config.Heat.MaxHeat
	session.HeatState = "Burnt"
	session.ShieldActive = false
	session.ShieldEndsAt = 0
	local player = session.Player
	player:SetAttribute(ATTR.Heat, session.Heat)
	player:SetAttribute(ATTR.HeatState, "Burnt")
	player:SetAttribute(ATTR.IsCharcoal, true)
	player:SetAttribute(ATTR.ShieldEndsAt, 0)
	PlayerManager.RefreshAppearance(session)
	PlayerManager.RefreshMovement(session)

	local root = PlayerManager.GetBody(session)
	services.Messaging.Notify(player, "🔥 YOU'RE BURNT! You're charcoal now: touch others to blacken them.", "Danger", 4)
	services.Messaging.Notify(nil, `🔥 {player.DisplayName} got burnt!`, "Danger", 2)
	services.Messaging.Sound(nil, "Burn", root and root.Position or nil)
	services.Messaging.Effect(player, "Shake", { Intensity = 0.6, Duration = 0.6 })
end

local function humanoidDescription(): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local color = Theme.Colors.Crust
	desc.HeadColor = color
	desc.TorsoColor = color
	desc.LeftArmColor = color
	desc.RightArmColor = color
	desc.LeftLegColor = color
	desc.RightLegColor = color
	return desc
end

local function spawnCharacter(player: Player)
	if player.Parent ~= Players then
		return
	end
	local ok, err = pcall(function()
		player:LoadCharacterWithHumanoidDescriptionAsync(humanoidDescription())
	end)
	if not ok then
		warn("[PlayerManager] LoadCharacterWithHumanoidDescriptionAsync failed, falling back:", err)
		pcall(function()
			player:LoadCharacterAsync()
		end)
	end
end

local ACTIVE_ARENA_PHASES = {
	[PHASES.RoundStart] = true,
	[PHASES.Calm] = true,
	[PHASES.Heating] = true,
	[PHASES.Launch] = true,
}

local function onCharacterAdded(session: Session, character: Model)
	session.Maid:Clean()
	local player = session.Player
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root or player.Character ~= character then
		return
	end

	humanoid.BreakJointsOnDeath = false
	BreadVisuals.PrepareCharacter(character)
	PlayerManager.SetCollisionGroup(character, Constants.CollisionGroups.Players)
	session.Maid:Give(character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and descendant.CollisionGroup == "Default" then
			descendant.CollisionGroup = Constants.CollisionGroups.Players
		end
	end))
	PlayerManager.RebuildBread(session)

	session.Maid:Give(humanoid.Died:Connect(function()
		task.delay(Config.Movement.RespawnDelay, function()
			if player.Parent == Players and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end))

	-- Restore position for players who reset mid-round.
	local phase = services.RoundManager.GetPhase()
	if session.InRound and ACTIVE_ARENA_PHASES[phase] then
		PlayerManager.TeleportToToaster(session)
	elseif session.InRound and phase == PHASES.Landing then
		services.LaunchManager.FallbackLand(session)
	end
end

local function onPlayerAdded(player: Player)
	local session = newSession(player)
	sessions[player] = session
	player:SetAttribute(ATTR.InRound, false)
	player:SetAttribute(ATTR.IsCharcoal, false)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(session, character)
	end)
	player.CharacterRemoving:Connect(function()
		session.Maid:Clean()
	end)

	services.DataManager.Load(player)
	if player.Parent == Players then
		spawnCharacter(player)
	end
end

local function onPlayerRemoving(player: Player)
	local session = sessions[player]
	if session then
		session.Maid:Clean()
		sessions[player] = nil
	end
end

function PlayerManager.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return PlayerManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">RewardManager</string>
          <string name="Source"><![CDATA[-- End-of-round rewards. Each player is rewarded exactly once per round
-- (RewardGranted guard) and the results table is built from the same data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Theme = require(Shared.Theme)

local RewardManager = {}

local services

function RewardManager.Init(registry)
	services = registry
end

local function grant(session)
	if session.RewardGranted then
		return
	end
	session.RewardGranted = true
	local player = session.Player
	local reward = Progression.RoundReward({
		Participated = true,
		Survived = session.Survived,
		LandingPoints = session.LandingPoints,
		CollectedCrumbs = session.RoundCrumbs,
	}, Config.Rewards)
	session.Reward = reward

	local data = services.DataManager.Get(player)
	if not data then
		return
	end
	local levelBefore = Progression.LevelForXP(data.XP, Config.Progression.LevelXP)
	if reward.Crumbs > 0 then
		services.CurrencyManager.Add(player, "Crumbs", reward.Crumbs, "RoundReward")
	end
	services.DataManager.Update(player, function(d)
		d.XP += reward.XP
		d.BreadLevel = Progression.LevelForXP(d.XP, Config.Progression.LevelXP)
		local stats = d.Statistics
		stats.RoundsPlayed += 1
		if session.Survived then
			stats.RoundsSurvived += 1
			if session.UsedButterThisRound then
				stats.ButterSurvivals += 1
			end
		end
		stats.BestLandingScore = math.max(stats.BestLandingScore, reward.Points)
	end)
	local levelAfter = Progression.LevelForXP(data.XP, Config.Progression.LevelXP)

	local root = services.PlayerManager.GetBody(session)
	if root then
		services.Messaging.FloatingText(
			player,
			root.Position + Vector3.new(0, 9, 0),
			`+{reward.Crumbs} 🍞   +{reward.XP} XP`,
			Theme.Colors.Gold
		)
	end
	services.Messaging.Sound(player, "Score")
	if levelAfter > levelBefore then
		services.Messaging.Notify(player, `⭐ LEVEL UP! You're level {levelAfter}`, "Legend", 3)
	end
	services.AchievementManager.Evaluate(player)
end

function RewardManager.GrantRound()
	for _, session in services.PlayerManager.InRound() do
		local ok, err = pcall(grant, session)
		if not ok then
			warn("[RewardManager] reward failed for", session.Player.Name, err)
		end
	end
end

function RewardManager.BuildResults(): { any }
	local rows = {}
	for _, session in services.PlayerManager.InRound() do
		local reward = session.Reward or { Points = 0, Crumbs = 0, XP = 0 }
		table.insert(rows, {
			UserId = session.Player.UserId,
			Name = session.Player.DisplayName,
			Zone = session.LandingZoneName or "MISSED",
			ZoneId = session.LandingZoneId or "Safe",
			LandingPoints = session.LandingPoints,
			Survived = session.Survived,
			Points = reward.Points,
			Crumbs = reward.Crumbs + session.RoundCrumbs,
			XP = reward.XP,
		})
	end
	table.sort(rows, function(a, b)
		return a.Points > b.Points
	end)
	return rows
end

return RewardManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[-- Server-authoritative round state machine:
-- LOBBY -> ROUND_START -> CALM_PHASE -> HEATING_PHASE -> LAUNCH_PHASE
--       -> LANDING_PHASE -> REWARDS -> RESULTS -> LOBBY
-- Clients only read the RoundState folder attributes and one-shot events.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Net = require(Shared.Net)

local RoundManager = {}

local PHASES = Constants.Phases
local RA = Constants.RoundAttr
local ROUND = Config.Round
local services

local phase = PHASES.Lobby
local roundNumber = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

function RoundManager.Init(registry)
	services = registry
end

function RoundManager.GetPhase(): string
	return phase
end

function RoundManager.GetRoundNumber(): number
	return roundNumber
end

function RoundManager.SetRoundAttribute(name: string, value: any)
	Net.RoundState:SetAttribute(name, value)
end

local function setPhase(newPhase: string, duration: number?)
	phase = newPhase
	local t = now()
	Net.RoundState:SetAttribute(RA.Phase, newPhase)
	Net.RoundState:SetAttribute(RA.PhaseStartedAt, t)
	Net.RoundState:SetAttribute(RA.PhaseEndsAt, if duration then t + duration else 0)
	Net.RoundState:SetAttribute(RA.PlayersInRound, services.PlayerManager.CountInRound())
end

local function roundAborted(): boolean
	return services.PlayerManager.CountInRound() == 0
end

-- Waits for `duration`, returning false early if everyone left.
local function waitPhase(duration: number, untilFn: (() -> boolean)?): boolean
	local deadline = os.clock() + duration
	while os.clock() < deadline do
		if roundAborted() then
			return false
		end
		if untilFn and untilFn() then
			return true
		end
		task.wait(0.2)
	end
	return not roundAborted()
end

local function runLobby()
	setPhase(PHASES.Lobby, nil) -- "waiting for players" until enough are ready
	local readySince = nil
	while true do
		local ready = #services.PlayerManager.ReadyPlayers() >= ROUND.MinimumPlayers
		if ready then
			if not readySince then
				readySince = os.clock()
				setPhase(PHASES.Lobby, ROUND.IntermissionDuration)
			end
			if os.clock() - readySince >= ROUND.IntermissionDuration then
				return
			end
		elseif readySince then
			readySince = nil
			setPhase(PHASES.Lobby, nil) -- "waiting for players"
		end
		task.wait(0.25)
	end
end

local function runCalm(): boolean
	setPhase(PHASES.Calm, ROUND.CalmDuration)
	local warnAt = ROUND.CalmDuration - ROUND.CalmWarningLead
	if not waitPhase(warnAt) then
		return false
	end
	services.Messaging.Round(nil, "CalmWarning", { EndsAt = now() + ROUND.CalmWarningLead })
	services.Messaging.Notify(nil, "🔧 *click*... did the toaster just move?", "Warning", 3)
	return waitPhase(ROUND.CalmWarningLead)
end

local function runHeating(): boolean
	setPhase(PHASES.Heating, ROUND.HeatingDuration)
	services.CrumbWorldManager.EvictAll()
	services.Messaging.Round(nil, "HandSequence", { StartedAt = now(), Duration = ROUND.HandSequenceDuration })
	services.Messaging.Notify(nil, "🖐️ THE HAND IS COMING!", "Danger", 2.5)
	if not waitPhase(ROUND.HandSequenceDuration) then
		return false
	end
	services.HeatManager.SetActive(true)
	services.Messaging.Notify(nil, "🔥 OH NO... THE TOASTER IS ON!", "Danger", 3)
	services.EventManager.StartHeating()
	local ok = waitPhase(ROUND.HeatingDuration - ROUND.HandSequenceDuration)
	services.EventManager.StopHeating()
	services.HeatManager.SetActive(false)
	return ok
end

local function runLaunch(): boolean
	setPhase(PHASES.Launch, ROUND.LaunchDuration)
	services.Messaging.Round(nil, "Countdown", { PopAt = now() + ROUND.LaunchDuration })
	services.Messaging.Notify(nil, "🚀 GET READY TO LAUNCH! Run to the POP PAD!", "Warning", 2.5)
	if not waitPhase(ROUND.LaunchDuration) then
		return false
	end
	services.LaunchManager.LaunchAll()
	return true
end

local function runLanding(): boolean
	setPhase(PHASES.Landing, ROUND.LandingDuration)
	-- Give everyone time to land, then a short beat to look around.
	local landedEarly = waitPhase(ROUND.LandingDuration, function()
		return services.LaunchManager.AllLanded()
	end)
	services.LaunchManager.FinalizeAll()
	if landedEarly then
		task.wait(1.5)
	end
	return not roundAborted()
end

local function runRewardsAndResults()
	setPhase(PHASES.Rewards, ROUND.RewardsDuration)
	services.RewardManager.GrantRound()
	task.wait(ROUND.RewardsDuration)

	setPhase(PHASES.Results, ROUND.ResultsDuration)
	services.Messaging.Round(nil, "Results", { Round = roundNumber, Rows = services.RewardManager.BuildResults() })
	task.wait(ROUND.ResultsDuration)
end

local function cleanupRound()
	services.LaunchManager.Reset()
	services.EventManager.Cleanup()
	services.AbilityManager.ResetRound()
	services.HeatManager.ResetRound()
	services.PickupManager.ClearRoundPickups()
	services.PlayerManager.EndRound()
	services.Messaging.Round(nil, "RoundEnded", {})
end

local function runRound()
	local participants = services.PlayerManager.ReadyPlayers()
	if #participants < ROUND.MinimumPlayers then
		return
	end
	roundNumber += 1
	Net.RoundState:SetAttribute(RA.RoundNumber, roundNumber)

	services.PlayerManager.BeginRound(participants)
	services.PickupManager.SpawnRoundPickups()
	services.EventManager.PrepareRound(roundNumber)
	setPhase(PHASES.RoundStart, ROUND.RoundStartDuration)
	services.Messaging.Notify(nil, "🍞 ROUND STARTED! Grab crumbs and butter!", "Good", 3)
	services.Messaging.Sound(nil, "RoundStart")

	local ok = waitPhase(ROUND.RoundStartDuration) and runCalm() and runHeating() and runLaunch() and runLanding()
	if ok then
		runRewardsAndResults()
	else
		services.Messaging.Notify(nil, "Everyone left the toaster. Back to the lobby!", "Info", 3)
	end
	cleanupRound()
end

function RoundManager.Start()
	setPhase(PHASES.Lobby, nil)
	task.spawn(function()
		while true do
			runLobby()
			local ok, err = pcall(runRound)
			if not ok then
				warn("[RoundManager] round crashed, recovering:", err)
				pcall(cleanupRound)
			end
		end
	end)

	-- Keep the in-round count fresh when players leave mid-round.
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			Net.RoundState:SetAttribute(RA.PlayersInRound, services.PlayerManager.CountInRound())
		end)
	end)
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ShopManager</string>
          <string name="Source"><![CDATA[-- Bread unlocks, cosmetics, titles and Robux purchases. Every request is
-- validated (rate limit, ownership, price, level, round state). Robux only
-- buys cosmetics: never breads, crumbs or anything competitive.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AchievementDefinitions = require(Shared.AchievementDefinitions)
local BreadDefinitions = require(Shared.BreadDefinitions)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)
local DataSchema = require(Shared.DataSchema)
local Monetization = require(Shared.Monetization)
local Net = require(Shared.Net)
local Progression = require(Shared.Progression)
local RateLimiter = require(Shared.RateLimiter)

local ShopManager = {}

local PHASES = Constants.Phases
local services
local limiter = RateLimiter.new(Config.RateLimits.Interaction.Capacity, Config.RateLimits.Interaction.RefillPerSecond)
local vipOwners: { [Player]: boolean } = {}

local function level(data): number
	return Progression.LevelForXP(data.XP, Config.Progression.LevelXP)
end

local function availableTitles(player: Player, data): { string }
	local titles = {}
	for _, achievement in AchievementDefinitions.List do
		if data.Achievements[achievement.Id] then
			table.insert(titles, achievement.Title)
		end
	end
	if vipOwners[player] then
		table.insert(titles, Monetization.GamePasses.VIP.Title)
	end
	return titles
end

function ShopManager.SendProfile(player: Player)
	local data = services.DataManager.Get(player)
	if not data then
		return
	end
	local products = {}
	for key, product in Monetization.Products do
		if product.Id ~= 0 then
			products[key] = { DisplayName = product.DisplayName, Grants = product.Grants }
		end
	end
	services.Messaging.UI(player, "Profile", {
		Crumbs = data.Crumbs,
		XP = data.XP,
		Level = level(data),
		XPToNext = Progression.XPToNextLevel(data.XP, Config.Progression.LevelXP),
		UnlockedBreads = data.UnlockedBreads,
		EquippedBread = data.EquippedBread,
		UnlockedCosmetics = data.UnlockedCosmetics,
		EquippedCosmetics = data.EquippedCosmetics,
		Achievements = data.Achievements,
		EquippedTitle = data.EquippedTitle,
		Titles = availableTitles(player, data),
		Statistics = data.Statistics,
		VipAvailable = Monetization.GamePasses.VIP.Id ~= 0,
		VipOwned = vipOwners[player] == true,
		Products = products,
		Saving = player:GetAttribute(Constants.Attr.DataLoaded) == true,
	})
end

local function canChangeLoadout(session): boolean
	if not session.InRound then
		return true
	end
	local phase = services.RoundManager.GetPhase()
	return phase == PHASES.Lobby or phase == PHASES.Results or phase == PHASES.Rewards
end

local function rebuildIfAllowed(player: Player)
	local session = services.PlayerManager.Get(player)
	if session then
		services.PlayerManager.RebuildBread(session)
	end
end

local function fail(player: Player, reason: string)
	services.Messaging.Notify(player, reason, "Info", 2)
	services.Messaging.Sound(player, "Error")
end

local function grantCosmetics(player: Player, ids: { string })
	services.DataManager.Update(player, function(d)
		for _, id in ids do
			if CosmeticDefinitions.ById[id] then
				d.UnlockedCosmetics[id] = true
			end
		end
	end)
end

local HANDLERS = {}

function HANDLERS.RequestProfile(player: Player)
	ShopManager.SendProfile(player)
end

function HANDLERS.BuyBread(player: Player, breadId: any)
	local def = type(breadId) == "string" and BreadDefinitions.ById[breadId]
	local data = services.DataManager.Get(player)
	if not def or not data then
		return
	end
	local check = Progression.CanBuy(def.Price, def.RequiredLevel, data.Crumbs, level(data), data.UnlockedBreads[def.Id] == true)
	if not check.Ok then
		fail(player, check.Reason or "Can't buy that")
		return
	end
	if def.Price > 0 and not services.CurrencyManager.Spend(player, "Crumbs", def.Price, "Bread:" .. def.Id) then
		fail(player, "Not enough crumbs")
		return
	end
	services.DataManager.Update(player, function(d)
		d.UnlockedBreads[def.Id] = true
		if def.Id == "Waffle" then
			d.Statistics.WaffleUnlocked = 1
		end
	end)
	services.Messaging.Notify(player, `🎉 Unlocked {def.DisplayName}!`, "Legend", 3)
	services.Messaging.Sound(player, "Purchase")
	services.AchievementManager.Evaluate(player)
	HANDLERS.EquipBread(player, def.Id)
end

function HANDLERS.EquipBread(player: Player, breadId: any)
	local def = type(breadId) == "string" and BreadDefinitions.ById[breadId]
	local data = services.DataManager.Get(player)
	local session = services.PlayerManager.Get(player)
	if not def or not data or not session or not data.UnlockedBreads[def.Id] then
		return
	end
	if not canChangeLoadout(session) then
		fail(player, "Change your bread between rounds!")
		ShopManager.SendProfile(player)
		return
	end
	services.DataManager.Update(player, function(d)
		d.EquippedBread = def.Id
	end)
	rebuildIfAllowed(player)
	ShopManager.SendProfile(player)
end

function HANDLERS.BuyCosmetic(player: Player, cosmeticId: any)
	local cosmetic = type(cosmeticId) == "string" and CosmeticDefinitions.ById[cosmeticId]
	local data = services.DataManager.Get(player)
	if not cosmetic or not data or data.UnlockedCosmetics[cosmetic.Id] then
		return
	end
	if cosmetic.Source == "Crumbs" then
		if not services.CurrencyManager.Spend(player, "Crumbs", cosmetic.Price, "Cosmetic:" .. cosmetic.Id) then
			fail(player, "Not enough crumbs")
			return
		end
		grantCosmetics(player, { cosmetic.Id })
		services.Messaging.Notify(player, `🎉 Unlocked {cosmetic.DisplayName}!`, "Good", 2.5)
		services.Messaging.Sound(player, "Purchase")
		HANDLERS.EquipCosmetic(player, cosmetic.Slot, cosmetic.Id)
	elseif cosmetic.Source == "GamePass" then
		local pass = Monetization.GamePasses.VIP
		if pass.Id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		else
			fail(player, "VIP isn't available yet")
		end
	elseif cosmetic.Source == "Product" then
		for _, product in Monetization.Products do
			if product.Id ~= 0 and table.find(product.Grants, cosmetic.Id) then
				MarketplaceService:PromptProductPurchase(player, product.Id)
				return
			end
		end
		fail(player, "Not for sale yet")
	else
		fail(player, "Unlocked by an achievement")
	end
end

function HANDLERS.EquipCosmetic(player: Player, slot: any, cosmeticId: any)
	if type(slot) ~= "string" or not table.find(CosmeticDefinitions.Slots, slot) then
		return
	end
	local data = services.DataManager.Get(player)
	if not data then
		return
	end
	if cosmeticId == nil or cosmeticId == "" then
		services.DataManager.Update(player, function(d)
			d.EquippedCosmetics[slot] = nil
		end)
	else
		local cosmetic = type(cosmeticId) == "string" and CosmeticDefinitions.ById[cosmeticId]
		if not cosmetic or cosmetic.Slot ~= slot or not data.UnlockedCosmetics[cosmetic.Id] then
			return
		end
		services.DataManager.Update(player, function(d)
			d.EquippedCosmetics[slot] = cosmetic.Id
		end)
	end
	rebuildIfAllowed(player)
	ShopManager.SendProfile(player)
end

function HANDLERS.EquipTitle(player: Player, title: any)
	local data = services.DataManager.Get(player)
	if not data or type(title) ~= "string" then
		return
	end
	if title ~= "" and not table.find(availableTitles(player, data), title) then
		return
	end
	services.DataManager.Update(player, function(d)
		d.EquippedTitle = title
	end)
	ShopManager.SendProfile(player)
end

local function checkVip(player: Player)
	local pass = Monetization.GamePasses.VIP
	if pass.Id == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
	end)
	if ok and owns then
		vipOwners[player] = true
		grantCosmetics(player, pass.Grants)
		ShopManager.SendProfile(player)
	end
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = services.DataManager.Get(player)
	if not data or player:GetAttribute(Constants.Attr.DataLoaded) ~= true then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if DataSchema.HasReceipt(data, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	for _, product in Monetization.Products do
		if product.Id ~= 0 and product.Id == receipt.ProductId then
			grantCosmetics(player, product.Grants)
			services.DataManager.Update(player, function(d)
				DataSchema.RememberReceipt(d, receipt.PurchaseId)
			end)
			services.DataManager.Save(player, true)
			services.Messaging.Notify(player, `🎉 Thanks! {product.DisplayName} unlocked.`, "Legend", 3)
			ShopManager.SendProfile(player)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function ShopManager.Init(registry)
	services = registry
end

function ShopManager.Start()
	Net.InteractionEvent.OnServerEvent:Connect(function(player, action, arg1, arg2)
		if type(action) ~= "string" or not HANDLERS[action] or not limiter:Allow(player) then
			return
		end
		if not services.DataManager.Get(player) then
			return
		end
		local ok, err = pcall(HANDLERS[action], player, arg1, arg2)
		if not ok then
			warn("[ShopManager]", action, "failed:", err)
		end
	end)

	services.DataManager.OnLoaded(function(player)
		ShopManager.SendProfile(player)
		task.spawn(checkVip, player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Monetization.GamePasses.VIP.Id and passId ~= 0 then
			vipOwners[player] = true
			grantCosmetics(player, Monetization.GamePasses.VIP.Grants)
			services.Messaging.Notify(player, "👑 Welcome to VIP!", "Legend", 3)
			ShopManager.SendProfile(player)
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		vipOwners[player] = nil
		limiter:Forget(player)
	end)
end

return ShopManager
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="47">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">140</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="49">
        <Properties>
          <string name="Name">ClientController</string>
          <string name="Source"><![CDATA[-- Client entry point: initialises and starts every controller in order.

local Controllers = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"SoundController",
	"CameraController",
	"InputController",
	"UIController",
	"EffectsController",
}

local registry = {}
for _, name in ORDER do
	registry[name] = require(Controllers:WaitForChild(name))
end

for _, name in ORDER do
	local controller = registry[name]
	if type(controller.Init) == "function" then
		controller.Init(registry)
	end
end

for _, name in ORDER do
	local controller = registry[name]
	if type(controller.Start) == "function" then
		controller.Start()
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Camera comedy: shakes (via Humanoid.CameraOffset so the default camera keeps
-- working), FOV punches and a short, skippable cinematic for the lever pull.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local CameraController = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local BASE_FOV = 70

local shakeUntil = 0
local shakeIntensity = 0
local shakeBound = false
local cinematicToken = 0

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function stepShake()
	local h = humanoid()
	local t = os.clock()
	if t >= shakeUntil then
		if h then
			h.CameraOffset = Vector3.zero
		end
		RunService:UnbindFromRenderStep("ToasterShake")
		shakeBound = false
		return
	end
	if h then
		local fade = math.clamp((shakeUntil - t) / 0.3, 0, 1)
		local amount = shakeIntensity * fade
		h.CameraOffset = Vector3.new((math.random() - 0.5) * amount, (math.random() - 0.5) * amount, (math.random() - 0.5) * amount * 0.5)
	end
end

function CameraController.Shake(intensity: number, duration: number)
	local t = os.clock()
	local alreadyShaking = t < shakeUntil
	shakeIntensity = if alreadyShaking then math.max(shakeIntensity, intensity) else intensity
	shakeUntil = math.max(shakeUntil, t + duration)
	if not shakeBound then
		shakeBound = true
		RunService:BindToRenderStep("ToasterShake", Enum.RenderPriority.Camera.Value + 1, stepShake)
	end
end

function CameraController.FovPunch(amount: number, duration: number)
	camera = workspace.CurrentCamera
	local out = TweenService:Create(camera, TweenInfo.new(duration * 0.3, Enum.EasingStyle.Quad), { FieldOfView = BASE_FOV + amount })
	out:Play()
	out.Completed:Once(function()
		TweenService:Create(camera, TweenInfo.new(duration * 0.7, Enum.EasingStyle.Quad), { FieldOfView = BASE_FOV }):Play()
	end)
end

-- Look at `focus` from `from` for `duration` seconds; any input skips it.
function CameraController.PlayCinematic(from: Vector3, focus: Vector3, duration: number)
	camera = workspace.CurrentCamera
	cinematicToken += 1
	local token = cinematicToken
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(from, focus)
	TweenService:Create(camera, TweenInfo.new(duration, Enum.EasingStyle.Sine), {
		CFrame = CFrame.lookAt(from + (focus - from).Unit * 18, focus),
	}):Play()

	local skip
	local function finish()
		if token ~= cinematicToken then
			return
		end
		cinematicToken += 1
		if skip then
			skip:Disconnect()
		end
		camera.CameraType = Enum.CameraType.Custom
		local h = humanoid()
		if h then
			camera.CameraSubject = h
		end
	end
	skip = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			finish()
		end
	end)
	task.delay(duration, finish)
end

function CameraController.Init(_registry) end

function CameraController.Start()
	player.CharacterAdded:Connect(function()
		camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = BASE_FOV
	end)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[-- Local visual effects. The server sends small event payloads; every client
-- renders them here (parts are local, short-lived and cleaned with Debris).
-- Also applies physics reactions the server asks of the LOCAL character
-- (knockback, slips, slides, rolls), since each client owns its own physics.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ForkPath = require(Shared.ForkPath)
local Maid = require(Shared.Maid)
local Net = require(Shared.Net)
local Theme = require(Shared.Theme)

local EffectsController = {}

local C = Theme.Colors
local RA = Constants.RoundAttr
local PHASES = Constants.Phases
local player = Players.LocalPlayer
local registry
local rng = Random.new()

local effectsFolder: Folder
local hazardMaid = Maid.new()
local motionMaid = Maid.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function localPart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = props.Parent or effectsFolder
	return p
end

local UP_AXIS = CFrame.Angles(0, 0, math.rad(90))

local function disc(position: Vector3, radius: number, color: Color3, material: Enum.Material?, transparency: number?): BasePart
	return localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, 0.15, 0)) * UP_AXIS,
		Color = color,
		Material = material or Enum.Material.Neon,
		Transparency = transparency or 0.4,
	})
end

local function tween(
	instance: Instance,
	seconds: number,
	goal: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local t =
		TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- Reusable particle burst emitter (object pooling: one part, many Emit calls).
local burstPart: BasePart
local burstEmitter: ParticleEmitter
local function burst(position: Vector3, color: Color3, count: number, speed: number?)
	burstPart.Position = position
	burstEmitter.Color = ColorSequence.new(color)
	burstEmitter.Speed = NumberRange.new((speed or 14) * 0.5, speed or 14)
	burstEmitter:Emit(count)
end

local function root(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

------------------------------------------------------------------ toaster: coils, lever, hand, pop pad

local coilState = "Cold"
local function setCoils(state: string)
	if coilState == state then
		return
	end
	coilState = state
	for _, coil in CollectionService:GetTagged(Constants.Tags.Coil) do
		local part = coil :: BasePart
		if state == "Hot" then
			part.Material = Enum.Material.Neon
			tween(part, 1.2, { Color = C.CoilHot })
		elseif state == "Warn" then
			part.Material = Enum.Material.Neon
			part.Color = C.CoilWarn
		else
			part.Material = Enum.Material.SmoothPlastic
			tween(part, 1, { Color = C.CoilCold })
		end
	end
end

local function refreshCoils()
	local heatActive = Net.RoundState:GetAttribute(RA.HeatActive) == true
	local phase = Net.RoundState:GetAttribute(RA.Phase)
	setCoils(if heatActive or phase == PHASES.Launch then "Hot" else "Cold")
end

local function leverKnob(): BasePart?
	return CollectionService:GetTagged(Constants.Tags.LeverKnob)[1] :: BasePart?
end

local function setKnob(down: boolean, seconds: number)
	local knob = leverKnob()
	if not knob then
		return
	end
	local y = if down then knob:GetAttribute("DownY") else knob:GetAttribute("UpY")
	local target = Vector3.new(knob.Position.X, y :: number, knob.Position.Z)
	tween(knob, seconds, { CFrame = CFrame.new(target) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

local function handModel(): Model?
	local folder = workspace:FindFirstChild("EventObjects")
	return folder and folder:FindFirstChild("GiantHand") :: Model?
end

-- Tween a model's pivot on the client via a CFrameValue.
local function tweenPivot(model: Model, target: CFrame, seconds: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()
	local conn = value:GetPropertyChangedSignal("Value"):Connect(function()
		model:PivotTo(value.Value)
	end)
	local t = tween(value, seconds, { Value = target }, style, direction)
	t.Completed:Once(function()
		conn:Disconnect()
		value:Destroy()
	end)
	return t
end

local function playHandSequence(payload)
	local hand = handModel()
	local knob = leverKnob()
	if not hand or not knob then
		return
	end
	local upY = knob:GetAttribute("UpY") :: number
	local downY = knob:GetAttribute("DownY") :: number
	local knobTop = Vector3.new(knob.Position.X, upY + 2.5, knob.Position.Z)
	local face = CFrame.Angles(0, math.rad(180), 0) -- nails face the toaster window side
	local skyStart = CFrame.new(knobTop + Vector3.new(0, 220, 30)) * face
	local hover = CFrame.new(knobTop + Vector3.new(0, 26, 8)) * face
	local grab = CFrame.new(knobTop + Vector3.new(0, 1, 2)) * face
	local pulled = CFrame.new(Vector3.new(knobTop.X, downY + 2.5, knobTop.Z) + Vector3.new(0, 0, 2)) * face
	local leave = CFrame.new(Vector3.new(knobTop.X, downY + 2.5, knobTop.Z) + Vector3.new(0, 260, 40)) * face

	local elapsed = now() - (payload.StartedAt or now())
	if elapsed > 3 then
		setKnob(true, 0.1)
		return
	end
	hand:PivotTo(skyStart)
	registry.SoundController.Play("HandAppear")
	registry.CameraController.PlayCinematic(knobTop + Vector3.new(-60, 30, 120), knobTop + Vector3.new(0, 10, 0), payload.Duration or 3.4)

	task.spawn(function()
		tweenPivot(hand, hover, 0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out).Completed:Wait()
		task.wait(0.45) -- dramatic pause
		tweenPivot(hand, grab, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
		registry.SoundController.Play("Lever")
		setKnob(true, 0.55)
		tweenPivot(hand, pulled, 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
		registry.CameraController.Shake(1.4, 0.7)
		registry.CameraController.FovPunch(8, 0.6)
		registry.SoundController.Play("CoilsOn")
		setCoils("Hot")
		task.wait(0.35)
		tweenPivot(hand, leave, 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
		hand:PivotTo(CFrame.new(0, 2000, 0))
	end)
end

local function calmWarning(payload)
	-- Flickers, clicks and tiny vibrations before the hand arrives.
	task.spawn(function()
		while now() < (payload.EndsAt or 0) - 0.5 do
			local phase = Net.RoundState:GetAttribute(RA.Phase)
			if phase ~= PHASES.Calm then
				break
			end
			registry.SoundController.Play("ToasterClick")
			setCoils("Warn")
			task.wait(0.15)
			setCoils("Cold")
			registry.CameraController.Shake(0.25, 0.3)
			task.wait(rng:NextNumber(1.2, 2.4))
		end
	end)
end

local function popPadGlow(popAt: number)
	for _, pad in CollectionService:GetTagged(Constants.Tags.PopPad) do
		local part = pad :: BasePart
		local original = part.Color
		part.Material = Enum.Material.Neon
		task.spawn(function()
			while now() < popAt do
				part.Color = if math.floor(os.clock() * 4) % 2 == 0 then C.Orange else C.Gold
				task.wait(0.1)
			end
			part.Material = Enum.Material.SmoothPlastic
			part.Color = original
		end)
	end
end

------------------------------------------------------------------ fork boss

local function forkModel(): Model?
	local folder = workspace:FindFirstChild("EventObjects")
	return folder and folder:FindFirstChild("GiantFork") :: Model?
end

local function runFork(payload)
	local fork = forkModel()
	if not fork then
		return
	end
	local center: Vector3 = payload.Center
	local hoverY = 6
	local function pathPoint(t: number): Vector3
		local ox, oz = ForkPath.Offset(t - payload.StartAt, payload)
		return center + Vector3.new(ox, hoverY + math.sin(t * 3) * 1.5, oz)
	end
	local startPoint = pathPoint(payload.StartAt)
	fork:PivotTo(CFrame.new(startPoint + Vector3.new(0, 200, 0)))
	tweenPivot(fork, CFrame.new(startPoint), math.max(0.3, payload.StartAt - now()), Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	registry.SoundController.Play("ForkWarning")

	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = now()
		if t < payload.StartAt then
			return
		end
		if t >= payload.EndAt or Net.RoundState:GetAttribute(RA.ForkActive) ~= true then
			connection:Disconnect()
			local here = fork:GetPivot()
			tweenPivot(fork, here + Vector3.new(0, 220, 0), 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Once(function()
				fork:PivotTo(CFrame.new(0, 2200, 0))
			end)
			return
		end
		fork:PivotTo(CFrame.new(pathPoint(t)) * CFrame.Angles(0, t * 0.6, 0))
	end)
	hazardMaid:Give(connection)
end

local function bolt(from: Vector3, to: Vector3)
	local segments = 6
	local previous = from
	for i = 1, segments do
		local alpha = i / segments
		local point = from:Lerp(to, alpha)
		if i < segments then
			point += Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-1, 1), rng:NextNumber(-3, 3))
		end
		local length = (point - previous).Magnitude
		local seg = localPart({
			Size = Vector3.new(0.5, 0.5, length),
			CFrame = CFrame.lookAt((previous + point) / 2, point),
			Color = C.Electric,
			Material = Enum.Material.Neon,
		})
		Debris:AddItem(seg, 0.25)
		previous = point
	end
end

------------------------------------------------------------------ hazards and items

local JUNK_BUILDERS = {
	function(cf: CFrame): { BasePart }
		return {
			localPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), CFrame = cf, Color = C.Butter }),
			localPart({ Size = Vector3.new(1.6, 0.6, 1.2), CFrame = cf * CFrame.new(0, 0, -1.8), Color = C.Orange }),
		}
	end,
	function(cf: CFrame): { BasePart }
		return {
			localPart({ Size = Vector3.new(0.6, 0.4, 7), CFrame = cf, Color = C.Chrome, Material = Enum.Material.Metal }),
			localPart({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(2.2, 2.2, 2.2),
				CFrame = cf * CFrame.new(0, 0, -3.6),
				Color = C.Chrome,
				Material = Enum.Material.Metal,
			}),
		}
	end,
	function(cf: CFrame): { BasePart }
		return {
			localPart({ Size = Vector3.new(2, 4, 1.2), CFrame = cf, Color = Color3.fromRGB(230, 90, 120), Material = Enum.Material.Fabric }),
			localPart({
				Size = Vector3.new(2, 1.4, 2.8),
				CFrame = cf * CFrame.new(0, -2, -0.8),
				Color = Color3.fromRGB(230, 90, 120),
				Material = Enum.Material.Fabric,
			}),
		}
	end,
}

local function itemVisual(kind: string, cf: CFrame): { BasePart }
	if kind == "Junk" then
		return JUNK_BUILDERS[rng:NextInteger(1, #JUNK_BUILDERS)](cf)
	elseif kind == "Butter" then
		return { localPart({ Size = Vector3.new(2.6, 1.1, 1.8), CFrame = cf, Color = C.Butter }) }
	elseif kind == "GoldenCrumb" then
		return { localPart({ Size = Vector3.new(1.6, 1.2, 1.4), CFrame = cf, Color = C.Legend, Material = Enum.Material.Neon }) }
	end
	return { localPart({ Size = Vector3.new(1.3, 0.9, 1.1), CFrame = cf, Color = C.Crumb }) }
end

local function fallingItem(payload)
	local position: Vector3 = payload.Position
	local impactAt: number = payload.ImpactAt
	local fallTime: number = payload.FallTime
	local shadow = disc(
		position,
		if payload.Kind == "Junk" then 4.5 else 2.5,
		if payload.Kind == "Junk" then C.Danger else C.Charcoal,
		Enum.Material.SmoothPlastic,
		0.5
	)
	shadow.Size = Vector3.new(0.2, 1, 1)
	local finalSize = if payload.Kind == "Junk" then 9 else 5
	tween(shadow, math.max(0.2, impactAt - now()), { Size = Vector3.new(0.2, finalSize, finalSize) })
	Debris:AddItem(shadow, math.max(0.3, impactAt - now() + 0.1))
	hazardMaid:Give(shadow)

	task.delay(math.max(0, impactAt - fallTime - now()), function()
		local startCf = CFrame.new(position + Vector3.new(0, 90, 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		local parts = itemVisual(payload.Kind, startCf)
		local model = Instance.new("Model")
		for _, part in parts do
			part.Parent = model
		end
		model.Parent = effectsFolder
		local landing = CFrame.new(position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0)
		tweenPivot(model, landing, math.max(0.1, impactAt - now()), Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(model, math.max(0.2, impactAt - now()) + (if payload.Kind == "Junk" then 1.2 else 0.05))
	end)
end

local function hotSpot(payload)
	local position: Vector3 = payload.Position
	local warning = disc(position, payload.Radius, C.Danger, Enum.Material.Neon, 0.75)
	hazardMaid:Give(warning)
	task.spawn(function()
		while now() < payload.StartsAt and warning.Parent do
			warning.Transparency = if math.floor(os.clock() * 6) % 2 == 0 then 0.55 else 0.85
			task.wait(0.08)
		end
		if not warning.Parent then
			return
		end
		warning.Transparency = 0.35
		warning.Color = C.CoilHot
		local smoke = Instance.new("Smoke")
		smoke.Color = Color3.fromRGB(255, 160, 120)
		smoke.Opacity = 0.15
		smoke.Size = 6
		smoke.Parent = warning
		task.wait(math.max(0, payload.EndsAt - now()))
		if warning.Parent then
			tween(warning, 0.4, { Transparency = 1 })
			Debris:AddItem(warning, 0.45)
		end
	end)
end

local function pulseWarning(position: Vector3, radius: number, color: Color3, untilTime: number)
	local warning = disc(position, radius, color, Enum.Material.Neon, 0.7)
	hazardMaid:Give(warning)
	task.spawn(function()
		while now() < untilTime and warning.Parent do
			warning.Transparency = if math.floor(os.clock() * 8) % 2 == 0 then 0.45 else 0.85
			task.wait(0.06)
		end
		if warning.Parent then
			warning:Destroy()
		end
	end)
end

local function steam(payload)
	local column = localPart({
		Size = Vector3.new(payload.Radius * 2, 30, payload.Radius * 2),
		CFrame = CFrame.new(payload.Position + Vector3.new(0, 15, 0)),
		Transparency = 1,
	})
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.new(1, 1, 1)
	smoke.Opacity = 0.5
	smoke.Size = 10
	smoke.RiseVelocity = 25
	smoke.Parent = column
	task.delay(1.2, function()
		smoke.Enabled = false
	end)
	Debris:AddItem(column, 4)
	burst(payload.Position + Vector3.new(0, 2, 0), Color3.new(1, 1, 1), 25, 30)
end

local function projectile(payload)
	local color = if payload.Kind == "Jam" then C.Jam else C.Nutella
	local ball = localPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.6, 1.6, 1.6),
		Position = payload.From,
		Color = color,
		Material = Enum.Material.Glass,
	})
	local from: Vector3, to: Vector3 = payload.From, payload.To
	local duration = math.max(0.05, payload.Duration)
	local arcHeight = if payload.Kind == "Jam" then 3 else 10
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local alpha = math.min(1, (os.clock() - start) / duration)
		ball.Position = from:Lerp(to, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * arcHeight, 0)
		if alpha >= 1 then
			connection:Disconnect()
			ball:Destroy()
		end
	end)
end

local function splat(position: Vector3, color: Color3)
	local s = disc(position - Vector3.new(0, 2.4, 0), 2.2, color, Enum.Material.Glass, 0.1)
	tween(s, 0.15, { Size = Vector3.new(0.2, 5, 5) }, Enum.EasingStyle.Back)
	Debris:AddItem(s, 3)
	burst(position, color, 18, 18)
end

local function puddle(payload)
	local p = disc(payload.Position, payload.Radius, C.Nutella, Enum.Material.Glass, 0.05)
	p.Size = Vector3.new(0.2, 2, 2)
	tween(p, 0.3, { Size = Vector3.new(0.2, payload.Radius * 2, payload.Radius * 2) }, Enum.EasingStyle.Back)
	hazardMaid:Give(p)
	task.delay(payload.Duration - 0.5, function()
		if p.Parent then
			tween(p, 0.5, { Transparency = 1 })
			Debris:AddItem(p, 0.55)
		end
	end)
end

local function flake(payload)
	for _ = 1, 3 do
		local f = localPart({
			Size = Vector3.new(rng:NextNumber(0.8, 1.6), 0.1, rng:NextNumber(0.5, 1.1)),
			CFrame = CFrame.new(payload.Position + Vector3.new(rng:NextNumber(-1.5, 1.5), 0.15, rng:NextNumber(-1.5, 1.5)))
				* CFrame.Angles(0, rng:NextNumber(0, 6), 0),
			Color = Color3.fromRGB(233, 169, 78),
		})
		hazardMaid:Give(f)
		Debris:AddItem(f, payload.Lifetime)
	end
end

local function shockwave(payload)
	local ring = disc(payload.Position, 1, C.Legend, Enum.Material.Neon, 0.2)
	tween(ring, 0.45, { Size = Vector3.new(0.2, payload.Radius * 2, payload.Radius * 2), Transparency = 1 })
	Debris:AddItem(ring, 0.5)
	burst(payload.Position, C.Legend, 30, 35)
	local r = root()
	if r and (r.Position - payload.Position).Magnitude < payload.Radius * 2 then
		registry.CameraController.Shake(1, 0.4)
	end
end

local function landing(payload)
	local color = Theme.ZoneColors[payload.Zone] or C.Cream
	local ring = disc(payload.Position - Vector3.new(0, 2.5, 0), 1, color, Enum.Material.Neon, 0.2)
	tween(ring, 0.5, { Size = Vector3.new(0.2, 14, 14), Transparency = 1 })
	Debris:AddItem(ring, 0.55)
	burst(payload.Position, Color3.fromRGB(196, 160, 118), 20, 20)
	if payload.Zone == "Jackpot" or payload.Zone == "Perfect" then
		for _, confettiColor in { C.Legend, C.Orange, C.Electric, C.Jam } do
			burst(payload.Position + Vector3.new(0, 3, 0), confettiColor, 12, 40)
		end
	end
	registry.SoundController.Play("Landing", payload.Position)
end

local function clearHazards()
	hazardMaid:Clean()
end

------------------------------------------------------------------ local physics reactions

local function knockback(payload)
	local r, h = root(), humanoid()
	if not r or not h then
		return
	end
	local velocity: Vector3 = payload.Velocity
	if velocity.Y < 20 then
		velocity = Vector3.new(velocity.X, 20, velocity.Z)
	end
	h:ChangeState(Enum.HumanoidStateType.Freefall)
	r.AssemblyLinearVelocity = velocity
	registry.CameraController.Shake(0.6, 0.25)
end

local function slip(payload)
	local r, h = root(), humanoid()
	if not r or not h then
		return
	end
	h.PlatformStand = true
	r.AssemblyLinearVelocity = r.AssemblyLinearVelocity + Vector3.new(rng:NextNumber(-12, 12), 18, rng:NextNumber(-12, 12))
	r.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8))
	task.delay(payload.Duration, function()
		if h.Parent then
			h.PlatformStand = false
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

-- Horizontal-only LinearVelocity on the local root: unlike writing velocity
-- every frame, it doesn't fight the Humanoid controller. Gravity is untouched.
local function horizontalDrive(r: BasePart, name: string): LinearVelocity
	local attachment = Instance.new("Attachment")
	attachment.Name = name .. "Attachment"
	attachment.Parent = r
	local drive = Instance.new("LinearVelocity")
	drive.Name = name
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	drive.MaxAxesForce = Vector3.new(1e5, 0, 1e5)
	drive.VectorVelocity = Vector3.zero
	drive.Parent = r
	motionMaid:Set(name .. "Attachment", attachment)
	motionMaid:Set(name .. "Drive", drive)
	return drive
end

local function stopDrive(name: string)
	motionMaid:Set(name, nil)
	motionMaid:Set(name .. "Drive", nil)
	motionMaid:Set(name .. "Attachment", nil)
end

local function slide(payload)
	local r, h = root(), humanoid()
	if not r or not h then
		return
	end
	local flat = Vector3.new(r.AssemblyLinearVelocity.X, 0, r.AssemblyLinearVelocity.Z)
	local direction = if flat.Magnitude > 2 then flat.Unit else r.CFrame.LookVector
	local slideVelocity = direction * math.max(flat.Magnitude * 1.6, 34)
	local deadline = os.clock() + payload.Duration
	local drive = horizontalDrive(r, "Slide")
	motionMaid:Set(
		"Slide",
		RunService.Heartbeat:Connect(function(dt)
			if os.clock() >= deadline or not r.Parent then
				stopDrive("Slide")
				return
			end
			-- Barely any traction: input only nudges the slide.
			slideVelocity = slideVelocity * (1 - 0.6 * dt) + h.MoveDirection * 20 * dt
			drive.VectorVelocity = Vector3.new(slideVelocity.X, 0, slideVelocity.Z)
		end)
	)
	registry.SoundController.Play("NutellaSlip")
end

local function roll(payload)
	local r, h = root(), humanoid()
	if not r or not h then
		return
	end
	local direction = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z).Unit
	local deadline = os.clock() + payload.Duration
	local drive = horizontalDrive(r, "Roll")
	motionMaid:Set(
		"Roll",
		RunService.Heartbeat:Connect(function(dt)
			if os.clock() >= deadline or not r.Parent or h.Health <= 0 then
				stopDrive("Roll")
				return
			end
			local desired = h.MoveDirection
			if desired.Magnitude > 0.1 then
				-- Reduced turning: rotate toward input by at most TurnRate rad/s.
				local angle = math.atan2(direction:Cross(desired).Y, direction:Dot(desired))
				local step = math.clamp(angle, -payload.TurnRate * dt, payload.TurnRate * dt)
				direction = (CFrame.Angles(0, step, 0) * direction).Unit
			end
			drive.VectorVelocity = direction * payload.Speed
		end)
	)
end

local function slamJump(payload)
	local r, h = root(), humanoid()
	if not r or not h then
		return
	end
	h:ChangeState(Enum.HumanoidStateType.Jumping)
	r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, payload.Velocity, r.AssemblyLinearVelocity.Z)
	task.delay(0.3, function()
		if r.Parent then
			r.AssemblyLinearVelocity = Vector3.new(0, -payload.Velocity * 1.6, 0)
		end
	end)
end

------------------------------------------------------------------ per-character visuals (all clients)

-- Spins every rolling bagel and shows jam on stuck players.
local rollAngles: { [Model]: number } = {}
local function stepCharacterVisuals(dt: number)
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local visual = character and character:FindFirstChild("BreadVisual")
		local core = visual and visual:FindFirstChild("BreadCore")
		local joint = core and core:FindFirstChild("BreadJoint") :: Weld?
		if character and joint then
			if character:GetAttribute(Constants.CharAttr.Rolling) == true then
				local angle = (rollAngles[character] or 0) - dt * 14
				rollAngles[character] = angle
				joint.C0 = CFrame.new(0, 1.4, 0) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -1.4, 0)
			elseif rollAngles[character] then
				rollAngles[character] = nil
				joint.C0 = CFrame.identity
			end
		end
	end
	for character in rollAngles do
		if not character.Parent then
			rollAngles[character] = nil
		end
	end
end

local function attachJam(character: Model)
	local r = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local existing = character:FindFirstChild("JamSplat")
	if character:GetAttribute(Constants.CharAttr.Stuck) == true then
		if existing or not r then
			return
		end
		local jam = Instance.new("Part")
		jam.Name = "JamSplat"
		jam.Shape = Enum.PartType.Ball
		jam.Size = Vector3.new(6, 6, 6)
		jam.Color = C.Jam
		jam.Material = Enum.Material.Glass
		jam.Transparency = 0.35
		jam.CanCollide = false
		jam.CanQuery = false
		jam.CanTouch = false
		jam.Massless = true
		jam.CFrame = r.CFrame * CFrame.new(0, 1, 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = r
		weld.Part1 = jam
		weld.Parent = jam
		jam.Parent = character
		burst(r.Position, C.Jam, 20, 16)
	elseif existing then
		existing:Destroy()
	end
end

local function decorateCharacter(other: Player, character: Model)
	character:GetAttributeChangedSignal(Constants.CharAttr.Stuck):Connect(function()
		attachJam(character)
	end)
	local head = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not head then
		return
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Nameplate"
	billboard.Size = UDim2.fromOffset(200, 44)
	billboard.StudsOffset = Vector3.new(0, 6.2, 0)
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.55)
	name.Font = Theme.Fonts.Display
	name.TextScaled = true
	name.TextColor3 = C.Cream
	name.TextStrokeTransparency = 0.3
	name.Text = other.DisplayName
	name.Parent = billboard
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0, 0.55)
	title.Size = UDim2.fromScale(1, 0.45)
	title.Font = Theme.Fonts.Body
	title.TextScaled = true
	title.TextColor3 = C.Gold
	title.TextStrokeTransparency = 0.4
	title.Parent = billboard
	local function refresh()
		local t = other:GetAttribute(Constants.Attr.Title) or ""
		if other:GetAttribute(Constants.Attr.IsCharcoal) == true then
			title.Text = "🪨 CHARCOAL"
			title.TextColor3 = C.CreamMuted
		else
			title.Text = t
			title.TextColor3 = C.Gold
		end
	end
	refresh()
	local c1 = other:GetAttributeChangedSignal(Constants.Attr.Title):Connect(refresh)
	local c2 = other:GetAttributeChangedSignal(Constants.Attr.IsCharcoal):Connect(refresh)
	character.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
	end)
	billboard.Adornee = head
	billboard.Parent = head
	local h = character:FindFirstChildOfClass("Humanoid")
	if h then
		h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

local function watchPlayer(other: Player)
	if other.Character then
		task.spawn(decorateCharacter, other, other.Character)
	end
	other.CharacterAdded:Connect(function(character)
		decorateCharacter(other, character)
	end)
end

------------------------------------------------------------------ pickups spin

local function stepPickups(dt: number)
	local spin = CFrame.Angles(0, dt * 2, 0)
	for _, pickup in CollectionService:GetTagged(Constants.Tags.Pickup) do
		local part = pickup :: BasePart
		if part.Transparency < 1 then
			part.CFrame = part.CFrame * spin
		end
	end
end

------------------------------------------------------------------ wiring

local EFFECT_HANDLERS = {
	Sound = function(p)
		registry.SoundController.Play(p.Key, p.Position)
	end,
	Shake = function(p)
		registry.CameraController.Shake(p.Intensity, p.Duration)
	end,
	Knockback = knockback,
	Slip = slip,
	Slide = slide,
	Roll = roll,
	SlamJump = slamJump,
	Pickup = function(p)
		burst(p.Position, if p.Kind == "Butter" then C.Butter elseif p.Kind == "GoldenCrumb" then C.Legend else C.Crumb, 10, 12)
	end,
	Flake = flake,
	Puddle = puddle,
	Projectile = projectile,
	Splat = function(p)
		splat(p.Position, if p.Kind == "Jam" then C.Jam else C.Nutella)
	end,
	Shockwave = shockwave,
	FallingItem = fallingItem,
	Impact = function(p)
		burst(p.Position + Vector3.new(0, 1, 0), if p.Kind == "Junk" then C.Chrome else C.Crumb, 14, 20)
		local r = root()
		if p.Kind == "Junk" and r and (r.Position - p.Position).Magnitude < 25 then
			registry.CameraController.Shake(0.5, 0.25)
		end
	end,
	HotSpot = hotSpot,
	SteamWarning = function(p)
		pulseWarning(p.Position, p.Radius, Color3.new(1, 1, 1), p.At)
	end,
	Steam = steam,
	Fork = runFork,
	ForkZapWarning = function(p)
		pulseWarning(p.Position, p.Radius, C.Electric, p.At)
	end,
	ForkZap = function(p)
		local fork = forkModel()
		local tip = if fork then fork:GetPivot().Position else p.Position + Vector3.new(0, 8, 0)
		for _ = 1, 3 do
			bolt(tip, p.Position + Vector3.new(rng:NextNumber(-p.Radius, p.Radius) * 0.6, 0, rng:NextNumber(-p.Radius, p.Radius) * 0.6))
		end
		local flash = disc(p.Position, p.Radius, C.Electric, Enum.Material.Neon, 0.1)
		tween(flash, 0.4, { Transparency = 1 })
		Debris:AddItem(flash, 0.45)
		local r = root()
		if r and (r.Position - p.Position).Magnitude < p.Radius * 2.5 then
			registry.CameraController.Shake(1.2, 0.35)
		end
	end,
	Landing = landing,
	Pop = function(p)
		for _, color in { C.Orange, C.Gold, C.Crumb } do
			burst(p.Position, color, 25, 60)
		end
		registry.CameraController.Shake(1.5, 0.6)
		setKnob(false, 0.15)
	end,
	ClearHazards = clearHazards,
}

local ROUND_HANDLERS = {
	CalmWarning = calmWarning,
	HandSequence = playHandSequence,
	Countdown = function(p)
		popPadGlow(p.PopAt)
		registry.CameraController.Shake(0.3, 3)
	end,
	Launched = function(_p)
		registry.CameraController.FovPunch(18, 1.2)
		registry.CameraController.Shake(1.2, 0.5)
		motionMaid:Clean()
	end,
	RoundEnded = function(_p)
		clearHazards()
		motionMaid:Clean()
		setKnob(false, 0.3)
		setCoils("Cold")
	end,
}

function EffectsController.Init(reg)
	registry = reg
end

function EffectsController.Start()
	effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "LocalEffects"
	effectsFolder.Parent = workspace

	burstPart = localPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 })
	burstEmitter = Instance.new("ParticleEmitter")
	burstEmitter.Enabled = false
	burstEmitter.Lifetime = NumberRange.new(0.4, 0.8)
	burstEmitter.Size = NumberSequence.new(0.6, 0)
	burstEmitter.SpreadAngle = Vector2.new(180, 180)
	burstEmitter.Acceleration = Vector3.new(0, -30, 0)
	burstEmitter.LightEmission = 0.3
	burstEmitter.Parent = burstPart

	Net.EffectEvent.OnClientEvent:Connect(function(kind: string, payload: any)
		local handler = EFFECT_HANDLERS[kind]
		if handler then
			local ok, err = pcall(handler, payload)
			if not ok then
				warn("[EffectsController]", kind, err)
			end
		end
	end)
	Net.RoundEvent.OnClientEvent:Connect(function(kind: string, payload: any)
		local handler = ROUND_HANDLERS[kind]
		if handler then
			local ok, err = pcall(handler, payload)
			if not ok then
				warn("[EffectsController]", kind, err)
			end
		end
	end)

	Net.RoundState:GetAttributeChangedSignal(RA.HeatActive):Connect(refreshCoils)
	Net.RoundState:GetAttributeChangedSignal(RA.Phase):Connect(refreshCoils)
	refreshCoils()

	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	Players.PlayerAdded:Connect(watchPlayer)

	RunService.RenderStepped:Connect(function(dt)
		stepCharacterVisuals(dt)
		stepPickups(dt)
	end)

	player.CharacterAdded:Connect(function()
		motionMaid:Clean()
	end)
end

return EffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Keyboard / gamepad bindings and the single place action requests are sent
-- from (on-screen buttons call Request too, so touch works identically).
-- The client pre-checks cooldowns only to avoid spam; the server decides.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AbilityDefinitions = require(Shared.AbilityDefinitions)
local BreadDefinitions = require(Shared.BreadDefinitions)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Net = require(Shared.Net)

local InputController = {}

local player = Players.LocalPlayer
local registry
local lastRequest: { [string]: number } = {}

local BINDINGS = {
	Ability = { Enum.KeyCode.Q, Enum.KeyCode.ButtonX },
	Butter = { Enum.KeyCode.F, Enum.KeyCode.ButtonY },
	Jam = { Enum.KeyCode.E, Enum.KeyCode.ButtonR1 },
	Nutella = { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 },
	Shop = { Enum.KeyCode.B, Enum.KeyCode.DPadUp },
}

local function now(): number
	return workspace:GetServerTimeNow()
end

function InputController.CooldownDuration(key: string): number
	if key == "Jam" or key == "Nutella" then
		return Config.Spreads[key].Cooldown
	elseif key == "Ability" then
		local bread = BreadDefinitions.ById[player:GetAttribute(Constants.Attr.Bread) or "Bread"]
		local ability = bread and bread.Ability and AbilityDefinitions[bread.Ability]
		return if ability then ability.Cooldown else 0
	end
	return 0
end

local function aimDirection(): Vector3
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	-- Lift the aim slightly so throws don't dive into the floor.
	return (look + Vector3.new(0, 0.12, 0)).Unit
end

function InputController.Request(key: string)
	if key == "Shop" then
		registry.UIController.ToggleShop()
		return
	end
	local t = os.clock()
	if t - (lastRequest[key] or 0) < 0.25 then
		return
	end
	lastRequest[key] = t
	if now() < (player:GetAttribute(Constants.Attr.CooldownPrefix .. key) or 0) then
		return
	end
	if key == "Ability" then
		Net.AbilityEvent:FireServer("Ability")
	elseif key == "Butter" then
		Net.AbilityEvent:FireServer("Butter")
	elseif key == "Jam" or key == "Nutella" then
		Net.AbilityEvent:FireServer("Spread", key, aimDirection())
	end
end

function InputController.Init(reg)
	registry = reg
end

function InputController.Start()
	for key, codes in BINDINGS do
		ContextActionService:BindAction("Toaster" .. key, function(_name, state)
			if state == Enum.UserInputState.Begin then
				InputController.Request(key)
			end
			return Enum.ContextActionResult.Pass
		end, false, table.unpack(codes))
	end
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[-- Plays sound hooks from Shared.Sounds, either 2D or at a world position.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared").Sounds)

local SoundController = {}

local templates: { [string]: Sound } = {}

local function template(key: string): Sound?
	local existing = templates[key]
	if existing then
		return existing
	end
	local spec = Sounds[key]
	if not spec or spec.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = key
	sound.SoundId = spec.Id
	sound.Volume = spec.Volume
	sound.PlaybackSpeed = spec.Speed or 1
	sound.Parent = SoundService
	templates[key] = sound
	return sound
end

function SoundController.Play(key: string, position: Vector3?)
	local base = template(key)
	if not base then
		return
	end
	if not position then
		SoundService:PlayLocalSound(base)
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "SoundAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	local sound = base:Clone()
	sound.RollOffMaxDistance = 300
	sound.RollOffMinDistance = 20
	sound.Parent = anchor
	anchor.Parent = workspace
	sound:Play()
	Debris:AddItem(anchor, 6)
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[-- All in-game UI, built in code: timer, heat meter, butter shield, crumbs,
-- notifications, countdown, results, shop, Old Crumb dialogue, critical-heat
-- vignette and the action buttons (touch, mouse and gamepad friendly).
-- Server state is read from replicated attributes; one-shot messages arrive
-- through UIEvent / RoundEvent.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BreadDefinitions = require(Shared.BreadDefinitions)
local AbilityDefinitions = require(Shared.AbilityDefinitions)
local Constants = require(Shared.Constants)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)
local Net = require(Shared.Net)
local Theme = require(Shared.Theme)
local UIUtil = require(script.Parent.UIUtil)

local UIController = {}

local create, corner, stroke, text, tween = UIUtil.create, UIUtil.corner, UIUtil.stroke, UIUtil.text, UIUtil.tween
local C = Theme.Colors
local F = Theme.Fonts
local ATTR = Constants.Attr
local RA = Constants.RoundAttr
local PHASES = Constants.Phases

local player = Players.LocalPlayer
local registry
local gui: ScreenGui
local refs: { [string]: any } = {}
local profile: any = nil
local activeNotifications: { Frame } = {}
local notificationCount = 0
local shopTab = "Breads"

local PHASE_NAMES = {
	[PHASES.Lobby] = "LOBBY",
	[PHASES.RoundStart] = "GET READY",
	[PHASES.Calm] = "CALM",
	[PHASES.Heating] = "TOASTER ON!",
	[PHASES.Launch] = "LAUNCH",
	[PHASES.Landing] = "LANDING",
	[PHASES.Rewards] = "REWARDS",
	[PHASES.Results] = "RESULTS",
}

local STYLE_COLORS = {
	Info = C.Cream,
	Good = Color3.fromRGB(150, 230, 140),
	Warning = C.Gold,
	Danger = C.Danger,
	Legend = C.Legend,
	Electric = C.Electric,
}

local ZONE_LABELS = {
	Coils = { "HOT ZONE ×2", C.Danger },
	Safe = { "COOL SPOT ×0.5", C.Safe },
	Center = { "CENTER ×1", C.CreamMuted },
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function panel(props: { [string]: any }): Frame
	local frame = create("Frame", {
		BackgroundColor3 = C.Charcoal,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	})
	for key, value in props do
		(frame :: any)[key] = value
	end
	corner(14).Parent = frame
	return frame
end

------------------------------------------------------------------ build

local function buildTimer()
	local frame = panel({
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(250, 66),
		Parent = gui,
	})
	stroke(C.Orange, 2).Parent = frame
	refs.PhaseLabel = text({
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 6),
		Font = F.Body,
		TextColor3 = C.Gold,
		Text = "LOBBY",
		Parent = frame,
	})
	refs.TimeLabel = text({
		Size = UDim2.new(1, -20, 0, 36),
		Position = UDim2.fromOffset(10, 24),
		Font = F.Display,
		Text = "--",
		Parent = frame,
	})
	refs.StatusLabel = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(460, 24),
		Font = F.Body,
		TextColor3 = C.Cream,
		TextStrokeTransparency = 0.4,
		Text = "",
		Parent = gui,
	})
end

local function buildCrumbs()
	local frame = panel({
		Name = "Crumbs",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 64),
		Size = UDim2.fromOffset(190, 48),
		Parent = gui,
	})
	refs.CrumbLabel = text({
		Size = UDim2.new(1, -20, 1, -12),
		Position = UDim2.fromOffset(10, 6),
		Font = F.Display,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "🍞 0",
		Parent = frame,
	})
	refs.LevelLabel = text({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 116),
		Size = UDim2.fromOffset(220, 20),
		Font = F.Body,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.CreamMuted,
		TextStrokeTransparency = 0.5,
		Text = "",
		Parent = gui,
	})
end

local function buildHeat()
	local frame = panel({
		Name = "Heat",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(420, 78),
		Visible = false,
		Parent = gui,
	})
	refs.HeatPanel = frame
	text({
		Size = UDim2.fromOffset(160, 24),
		Position = UDim2.fromOffset(14, 8),
		Font = F.Display,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "🔥 HEAT",
		Parent = frame,
	})
	refs.HeatState = text({
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.fromOffset(220, 24),
		Position = UDim2.new(1, -14, 0, 8),
		Font = F.Display,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "FRESH 0%",
		Parent = frame,
	})
	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(14, 40),
		Size = UDim2.new(1, -28, 0, 24),
		BackgroundColor3 = C.CharcoalSoft,
		BorderSizePixel = 0,
		Parent = frame,
	}, { corner(12) })
	refs.HeatFill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.HeatStateColors.Normal,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(12) })
	-- Threshold ticks
	for _, mark in { 50, 75, 90 } do
		create("Frame", {
			Position = UDim2.new(mark / 100, -1, 0, 0),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = C.Charcoal,
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = track,
		})
	end
	refs.ZoneChip = text({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -4),
		Size = UDim2.fromOffset(170, 22),
		Font = F.Body,
		TextColor3 = C.CreamMuted,
		TextStrokeTransparency = 0.4,
		Text = "",
		Parent = frame,
	})

	local butter = panel({
		Name = "Butter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -124),
		Size = UDim2.fromOffset(300, 36),
		Visible = false,
		Parent = gui,
	})
	refs.ButterPanel = butter
	stroke(C.Butter, 2).Parent = butter
	refs.ButterFill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Butter,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = butter,
	}, { corner(14) })
	refs.ButterLabel = text({
		Size = UDim2.new(1, -20, 1, -10),
		Position = UDim2.fromOffset(10, 5),
		Font = F.Display,
		Text = "",
		ZIndex = 2,
		Parent = butter,
	})
end

local function buildActionButtons()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local holder = create("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(1, 1),
		Position = if touch then UDim2.new(1, -14, 1, -180) else UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(164, 164),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.fromOffset(76, 76),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Actions = holder
	refs.ActionButtons = {}

	local specs = {
		{ Key = "Ability", Icon = "✨", Label = "ABILITY", Hint = "Q", Color = C.Orange, Order = 1 },
		{ Key = "Butter", Icon = "🧈", Label = "BUTTER", Hint = "F", Color = C.Butter, Order = 2 },
		{ Key = "Jam", Icon = "🍓", Label = "JAM", Hint = "E", Color = C.Jam, Order = 3 },
		{ Key = "Nutella", Icon = "🍫", Label = "NUTELLA", Hint = "R", Color = Color3.fromRGB(150, 90, 50), Order = 4 },
	}
	for _, spec in specs do
		local button = create("TextButton", {
			Name = spec.Key,
			LayoutOrder = spec.Order,
			BackgroundColor3 = C.Charcoal,
			BackgroundTransparency = 0.1,
			AutoButtonColor = true,
			Text = "",
			Parent = holder,
		}, { corner(18), stroke(spec.Color, 3) })
		text({
			Size = UDim2.new(1, 0, 0, 34),
			Position = UDim2.fromOffset(0, 8),
			Font = F.Display,
			Text = spec.Icon,
			Parent = button,
		})
		local label = text({
			Name = "Label",
			Size = UDim2.new(1, -8, 0, 14),
			Position = UDim2.fromOffset(4, 44),
			Font = F.Body,
			Text = spec.Label,
			Parent = button,
		})
		text({
			Name = "Hint",
			Size = UDim2.new(1, -8, 0, 12),
			Position = UDim2.fromOffset(4, 59),
			Font = F.Regular,
			TextColor3 = C.CreamMuted,
			Text = if touch then "" else spec.Hint,
			Parent = button,
		})
		local overlay = create("Frame", {
			Name = "Cooldown",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = button,
		}, { corner(18) })
		local cdText = text({
			Name = "CooldownText",
			Size = UDim2.fromScale(1, 0.5),
			Position = UDim2.fromScale(0, 0.25),
			Font = F.Display,
			Text = "",
			ZIndex = 5,
			Parent = button,
		})
		button.Activated:Connect(function()
			registry.InputController.Request(spec.Key)
		end)
		refs.ActionButtons[spec.Key] = { Button = button, Overlay = overlay, CooldownText = cdText, Label = label }
	end
end

